.sp-dfoot .bad{color:var(--bad);font-weight:700}
.sp-dlg{color:var(--weak);margin-left:auto}
.sp-sec-head{font-size:13px;font-weight:800;color:var(--text);margin:16px 0 6px;padding-left:8px;border-left:4px solid var(--accent)}
.ws-jc{border-left:3px solid #faad14 !important}
.ws-jcnum{display:inline-block;margin-left:auto;font-size:11px;font-weight:800;color:#5c3a00;background:linear-gradient(180deg,#ffd76b,#f0b429);border:1px solid #d99b1c;border-radius:10px;padding:2px 9px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.ws-jcnum.sm{font-size:9.5px;padding:1px 6px;margin-left:6px}
.ws-scoreline{display:flex;gap:18px;align-items:center;margin:6px 0 4px;flex-wrap:wrap}
.ws-pred{font-size:24px;font-weight:800;color:var(--accent);font-variant-numeric:tabular-nums;line-height:1.2}
.ws-pred i{font-style:normal;color:var(--weak);margin:0 2px}
.ws-metawrap{min-width:120px}
.ws-meta{font-size:11px;color:var(--sub);font-weight:600}
.ws-res{display:flex;gap:10px;align-items:center;font-size:11px;margin-top:6px;flex-wrap:wrap;padding-top:6px;border-top:1px dashed var(--line2)}
.ws-res .good{color:var(--good);font-weight:700}
.ws-res .bad{color:var(--bad);font-weight:700}
.ws-jc-tip{font-size:11.5px;color:var(--sub);background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:7px 10px;margin-bottom:8px}
.ws-jc-tip b{color:#d99b1c}
/* 未推荐场次：明确标注 + 原因（数据源未覆盖 / 联赛暂无预测 / 疑似漏匹配待核对） */
.ws-nopred{display:flex;align-items:center;gap:8px;margin:6px 0 2px;padding:8px 10px;border-radius:6px;background:var(--line);border-left:3px solid var(--weak);flex-wrap:wrap}
.ws-nopred-tag{font-size:12px;font-weight:800;color:var(--sub);background:var(--panel);border:1px solid var(--line2);border-radius:4px;padding:2px 8px;white-space:nowrap}
.ws-nopred-why{font-size:11px;color:var(--weak);line-height:1.5}
.ws-nopred.warn{border-left-color:#f7b733;background:rgba(247,183,51,.10)}
.ws-nopred.warn .ws-nopred-tag{color:#8a5a00;border-color:#d99b1c;background:rgba(247,183,51,.18)}
.ws-nopred.warn .ws-nopred-why{color:#a06a00}
.ws-namewarn{color:#f7b733;font-weight:700}
@media(max-width:640px){
  .sp-rel-grid{grid-template-columns:1fr}
  .sp-date-grid{grid-template-columns:1fr}
  .sp-scoreline{gap:12px}
}
.hkmo-rec-val.hit{color:var(--good)}
.hkmo-rec-val.miss{color:var(--bad)}
.hkmo-rec-stars{color:#faad14;font-size:11px}
/* 比分推荐卡片 */
.score-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:12px;overflow:hidden}
.score-head{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--panel2);font-size:11.5px;flex-wrap:wrap}
.score-num{color:var(--accent);font-weight:700;background:var(--accent-dim);padding:1px 6px;border-radius:4px;font-size:10.5px}
.score-league{color:var(--sub);font-size:11px}
.score-teams{font-weight:700;font-size:13px}
.score-kick{color:var(--weak);font-size:10.5px;margin-left:auto}
.score-body{padding:10px 12px}
.score-main{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:8px}
.score-pred{font-size:28px;font-weight:800;color:var(--accent);background:var(--accent-dim);padding:4px 16px;border-radius:8px;letter-spacing:2px}
.score-conf{font-size:11px;color:var(--sub);text-align:center}
.score-conf b{color:var(--good);font-size:14px}
.score-alts{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:8px}
.score-alt{font-size:12px;background:var(--panel3);padding:2px 10px;border-radius:4px;color:var(--sub)}
.score-reasons{font-size:10.5px;color:var(--weak);line-height:1.6}
.score-result-bar{padding:6px 12px;background:var(--panel3);font-size:11px;display:flex;gap:12px;flex-wrap:wrap}
.score-result-bar .hit{color:var(--good);font-weight:700}
.score-result-bar .miss{color:var(--bad);font-weight:700}
.score-result-bar .partial{color:#faad14;font-weight:700}
/* 港澳历史记录 */
.hkmo-hist-date{margin-bottom:16px}
.hkmo-hist-date-head{display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--panel2);border-radius:8px;margin-bottom:8px;flex-wrap:wrap}
.hkmo-hist-date-title{font-weight:700;font-size:13px;color:var(--accent)}
.hkmo-hist-date-stats{font-size:11px;color:var(--sub)}
.hkmo-hist-item{background:var(--panel);border:1px solid var(--line);border-radius:8px;margin-bottom:6px;padding:8px 12px}
.hkmo-hist-item.hkmo-hit{border-left:3px solid var(--good)}
.hkmo-hist-item.hkmo-miss{border-left:3px solid var(--bad)}
.hkmo-hist-item.hkmo-na{border-left:3px solid var(--sub)}
.hkmo-hist-item-head{display:flex;align-items:center;gap:8px;font-size:11.5px;flex-wrap:wrap;margin-bottom:4px}
.hkmo-hist-num{color:var(--accent);font-weight:700;background:var(--accent-dim);padding:1px 6px;border-radius:4px;font-size:10.5px}
.hkmo-hist-kick{color:var(--sub);font-size:10.5px}
.hkmo-hist-league{color:var(--sub);font-size:10.5px}
.hkmo-hist-teams{font-weight:600}
.hkmo-hist-result{color:var(--sub)}
.hkmo-hist-pick{color:var(--accent);font-weight:600}
.hkmo-hist-flag{font-weight:700;font-size:11px;padding:2px 8px;border-radius:4px}
.hkmo-hist-flag.hkmo-hit{color:var(--good);background:rgba(82,196,26,.12)}
.hkmo-hist-flag.hkmo-miss{color:var(--bad);background:rgba(234,102,104,.12)}
.hkmo-hist-flag.hkmo-na{color:var(--sub);background:var(--panel3)}
.hkmo-hist-item-detail{display:flex;gap:16px;font-size:10.5px;color:var(--sub);flex-wrap:wrap}
.hkmo-datebar{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px;padding:8px;background:var(--panel2);border-radius:8px}
.hkmo-datebar .hkmo-date-btn{padding:5px 10px;font-size:11px;border-radius:6px;background:var(--panel);color:var(--text);border:1px solid var(--line);cursor:pointer;white-space:nowrap;transition:all .15s}
.hkmo-datebar .hkmo-date-btn:hover{border-color:var(--accent);color:var(--accent)}
.hkmo-datebar .hkmo-date-btn.on{background:var(--accent);color:#fff;border-color:var(--accent);font-weight:600}
.hkmo-datebar .hkmo-date-all{background:var(--accent-dim);color:var(--accent);border-color:var(--accent-dim)}
.hkmo-hist-section{margin-bottom:20px}
.hkmo-hist-section-head{display:flex;align-items:center;gap:10px;padding:8px 12px;background:var(--panel2);border-radius:8px;margin-bottom:8px;flex-wrap:wrap}
.hkmo-hist-section-title{font-weight:700;font-size:13px;color:var(--accent)}
.hkmo-hist-section-stats{font-size:11px;color:var(--sub)}
.hkmo-hist-picksbar{display:flex;gap:10px;flex-wrap:wrap;margin-top:6px;padding-top:6px;border-top:1px dashed var(--line)}
.hkmo-hist-pick{display:flex;align-items:center;gap:6px;font-size:11px;background:var(--panel2);padding:4px 8px;border-radius:6px}
.hkmo-hist-pick-label{color:var(--sub);font-weight:600}
.hkmo-hist-pick-val{color:var(--text);font-weight:600}
.hkmo-hist-resultbar{display:flex;align-items:center;gap:8px;padding:6px 12px;background:var(--panel2);border-radius:0 0 8px 8px;font-size:11.5px;border-top:1px solid var(--line)}
.hkmo-hist-resultbar .res-score{font-weight:700;font-size:13px;color:var(--text)}
.hkmo-hist-resultbar .res-pick{color:var(--accent);font-weight:600}
.hkmo-hist-flag{font-weight:700;font-size:11px;padding:2px 8px;border-radius:4px}
.hkmo-hist-flag.hkmo-hit{color:var(--good);background:rgba(82,196,26,.12)}
.hkmo-hist-flag.hkmo-miss{color:var(--bad);background:rgba(234,102,104,.12)}
.hkmo-hist-flag.hkmo-na{color:var(--sub);background:var(--panel3)}
@media(max-width:768px){
  .hkmo-hist-item-head{font-size:11px}
  .hkmo-hist-item-detail{font-size:10px;gap:10px}
}
.hkmo-table{display:flex;flex-direction:column}
.hkmo-row{display:grid;grid-template-columns:70px 1fr 1fr 80px 80px;gap:0;padding:6px 12px;font-size:11px;border-bottom:1px solid var(--line)}
.hkmo-row:last-child{border-bottom:none}
.hkmo-header{background:var(--panel3);font-weight:700;color:var(--sub);font-size:10.5px}
.hkmo-col{text-align:center;padding:2px 4px}
.hkmo-dir{text-align:left;font-weight:600;color:var(--text)}
@media(max-width:768px){
  .hkmo-row{grid-template-columns:55px 1fr 1fr 60px 60px;font-size:10px;padding:5px 8px}
  .hkmo-head{padding:6px 8px;font-size:10.5px}
}
@media(max-width:768px){
  .oc-row{grid-template-columns:0.7fr 0.9fr 0.9fr 0.7fr 0.9fr 0.9fr 0.9fr;font-size:10px;padding:5px 8px}
  .oc-table.oc-wide .oc-row{grid-template-columns:60px 70px 70px 90px 70px 70px 70px 70px 80px;min-width:650px;font-size:10px;padding:5px 8px}
  .oc-head{padding:6px 8px;font-size:10.5px}
  .oc-teams{min-width:80px}
  .oc-hhad{padding:6px 8px;font-size:10px}
}
.import-status.ok{color:var(--good)}
.import-status.err{color:var(--bad)}
/* 关于弹窗 */
.about-sec{margin:14px 0;padding-bottom:12px;border-bottom:1px solid var(--line)}
.about-sec:last-of-type{border-bottom:none}
.about-title{font-size:13px;font-weight:700;color:var(--accent);margin-bottom:8px}
.about-item{display:flex;flex-direction:column;gap:2px;padding:6px 0;font-size:12px}
.about-item b{color:var(--text);font-weight:600}
.about-item span{color:var(--sub);line-height:1.4}
/* ============ 安装 App 引导 ============ */
.install-steps{display:flex;flex-direction:column;gap:10px;margin:12px 0}
.install-steps .istep{display:flex;gap:10px;align-items:flex-start;font-size:13px;line-height:1.5;color:var(--sub)}
.install-steps .ino{flex:0 0 22px;height:22px;border-radius:50%;background:var(--accent-dim);color:var(--accent);
  font-weight:800;font-size:12px;display:flex;align-items:center;justify-content:center}
.install-steps b{color:var(--text)}
.copyrow{display:flex;gap:8px;align-items:center;background:var(--panel3);border:1px solid var(--line2);
  border-radius:8px;padding:8px 10px}
.copyrow code{flex:1;min-width:0;font-size:11px;color:var(--sub);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
/* ============ 更新倒计时横幅 ============ */
.upd-banner{
  max-width:1500px;margin:8px auto 0;padding:8px 14px;font-size:11.5px;color:var(--sub);
  background:var(--panel2);border:1px solid var(--line);border-radius:8px;
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;
}
.upd-banner .ub-live{color:var(--good);font-weight:700}
.upd-banner .ub-cd{color:var(--warn);font-weight:700}
.upd-banner .ub-done{color:var(--accent);font-weight:700}
.upd-banner .ub-btn{
  margin-left:auto;font-size:11px;padding:3px 10px;border-radius:6px;cursor:pointer;
  background:rgba(82,196,26,.15);color:var(--good);border:1px solid rgba(82,196,26,.4);
}
.upd-banner .ub-btn.off{background:rgba(234,102,104,.12);color:var(--bad);border:1px solid rgba(234,102,104,.4)}
/* ============ 页脚 ============ */
footer{border-top:1px solid var(--line);background:var(--panel2);padding:16px}
footer .ft{max-width:1500px;margin:0 auto;font-size:11.5px;color:var(--weak);line-height:1.7}
footer b{color:var(--sub)}
/* ============ 空态 ============ */
.empty{grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--weak)}
/* ============ 主 Tab ============ */
.maintab{
  display:flex;gap:4px;max-width:1500px;margin:0 auto;padding:10px 16px 0;flex-wrap:wrap;
}
.maintab button{
  padding:9px 22px;font-size:14px;font-weight:600;color:var(--sub);
  border:1px solid transparent;border-bottom:none;border-radius:10px 10px 0 0;position:relative;bottom:-1px;
}
.maintab button.on{color:var(--accent);background:var(--panel);border-color:var(--line)}
.maintab button .bdg{
  font-size:10px;background:var(--accent-dim);color:var(--accent);
  border-radius:999px;padding:1px 7px;margin-left:6px;font-weight:700;
}
/* ============ 历史战绩 ============ */
.hview{display:none}
.hview.show{display:block}
.bdview{display:none}
.bdview.show{display:block}
.bd-sec{font-size:12.5px;font-weight:700;margin:16px 0 8px;display:flex;align-items:center;gap:8px}
.bd-sec .cnt{font-size:11px;color:var(--weak);font-weight:400}
.bd-note{font-size:11.5px;color:var(--weak);background:var(--panel3);border:1px dashed var(--line2);
  border-radius:8px;padding:8px 12px;margin-bottom:12px;line-height:1.6}
.bd-goal{font-size:9.5px;font-weight:700;color:var(--accent);background:var(--accent-dim);padding:1px 6px;border-radius:4px;margin:0 2px}
.bd-res{font-weight:700}
.bd-res.ok{color:#2ecc71}
.bd-res.no{color:#e74c3c}
.bd-res.dr{color:#f1c40f}
/* ===== 北单专属卡片 ===== */
.bd-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;
  padding:10px 14px 12px;margin-bottom:10px;transition:border-color .15s,box-shadow .15s}
.bd-card:hover{border-color:var(--line2);box-shadow:0 0 0 1px var(--line2) inset}
.bd-top{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:10.5px;color:var(--weak);margin-bottom:8px}
.bd-no{font-size:9.5px;font-weight:700;color:var(--accent);background:var(--accent-dim);
  padding:2px 7px;border-radius:4px;min-width:30px;text-align:center}
.bd-league{font-size:10px;color:#e8c56e;background:rgba(232,197,110,.12);border:1px solid rgba(232,197,110,.35);
  padding:1px 7px;border-radius:4px;font-weight:600}
.bd-time{font-weight:600;color:var(--sub)}
.bd-rank{font-size:9.5px;color:var(--weak);border:1px solid var(--line2);border-radius:4px;padding:1px 6px}
.bd-asian{font-size:9.5px;color:#7fd8c8;background:rgba(127,216,200,.1);border:1px solid rgba(127,216,200,.35);
  padding:1px 7px;border-radius:4px;font-weight:700;letter-spacing:.5px}
.bd-biz{margin-top:6px;font-size:10px;color:var(--warn);background:rgba(250,173,20,.1);
  border:1px dashed rgba(250,173,20,.4);border-radius:6px;padding:4px 8px;line-height:1.5}
.bd-sp{font-size:9.5px;color:#4ecdc4;background:rgba(78,205,196,.1);border:1px solid rgba(78,205,196,.3);
  padding:1px 6px;border-radius:4px;font-weight:700}
.bd-vs{display:flex;align-items:center;justify-content:space-between;gap:8px;
  font-size:13px;font-weight:700;color:var(--text);margin-bottom:9px}
.bd-team{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bd-team.l{text-align:left}
.bd-team.r{text-align:right}
.bd-mid{flex:0 0 auto;font-size:10px;font-weight:700;color:var(--weak);letter-spacing:1px}
.bd-score{flex:0 0 auto;font-size:15px;font-weight:800;color:var(--text);
  background:var(--panel3);border:1px solid var(--line);border-radius:8px;padding:3px 10px;
  font-family:ui-monospace,Menlo,monospace;letter-spacing:1px}
.bd-odds{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:9px}
.bd-odd{background:var(--panel3);border:1px solid var(--line);border-radius:8px;
  padding:5px 0;text-align:center;line-height:1.25}
.bd-odd b{display:block;font-size:13px;font-weight:700;color:var(--text)}
.bd-odd i{display:block;font-style:normal;font-size:9px;color:var(--weak)}
.bd-odd.hot{background:linear-gradient(180deg,var(--accent-dim),var(--panel3));border-color:var(--accent)}
.bd-odd.hot b{color:var(--accent)}
.bd-dir{display:flex;align-items:center;gap:6px;flex-wrap:wrap;font-size:11px;color:var(--sub);
  border-top:1px dashed var(--line);padding-top:8px}
.bd-dir .fi-dir{padding:1px 8px;border-radius:4px;font-size:10px;font-weight:700}
.bd-dir-txt{flex:1;min-width:120px}
.bd-histsub{display:flex;align-items:center;justify-content:space-between;gap:8px;
  font-size:10.5px;color:var(--weak);border-top:1px dashed var(--line);padding-top:8px}
.bd-tag{font-size:10px;font-weight:700;padding:2px 10px;border-radius:10px;letter-spacing:1px}
.bd-tag.ok{color:#0b0f14;background:#2ecc71}
.bd-tag.no{color:#fff;background:#e74c3c}
.bd-tag.dr{color:#0b0f14;background:#f1c40f}
.bd-hit{font-size:10px;font-weight:700;padding:2px 8px;border-radius:8px;margin-left:4px}
.bd-hit.ok{color:#0b0f14;background:#2ecc71}
.bd-hit.no{color:#fff;background:#e74c3c}
.bd-pick{font-size:10px;color:var(--accent);font-weight:600;padding:2px 6px;border:1px solid var(--accent);border-radius:6px}
.bd-filter{padding:1px 9px;border-radius:12px;font-size:10px;font-weight:600;cursor:pointer;
  border:1px solid var(--line2);color:var(--sub);background:var(--panel)}
.bd-filter.on{color:var(--accent);border-color:var(--accent);background:var(--accent-dim)}
.hstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin:14px 0}
.hstat{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 14px}
.hstat b{font-size:20px;display:block;line-height:1.3}
.hstat.clickable{cursor:pointer;transition:all .15s}
.hstat.clickable:hover{border-color:var(--accent);transform:translateY(-1px)}
.hstat span{font-size:11px;color:var(--sub)}
.hstat.hit b{color:var(--good)} .hstat.miss b{color:var(--bad)} .hstat.pend b{color:var(--accent)}
.hlist{display:flex;flex-direction:column;gap:10px}
.hrec{
  display:grid;grid-template-columns:88px 1fr auto;gap:12px;align-items:center;
  background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 14px;
}
.hrec .h-time{font-size:11px;color:var(--weak);white-space:nowrap}
.hrec .h-vs{min-width:0}
.hrec .h-vs .teams{font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:5px;flex-wrap:wrap}
.hrec .h-meta{font-size:11px;color:var(--sub);margin-top:3px;display:flex;gap:8px;flex-wrap:wrap}
.hrec .h-verdict{font-size:11.5px;margin-top:5px;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.vtag{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:4px;white-space:nowrap}
.vtag.good{background:var(--good);color:#fff}
.vtag.bad{background:var(--bad);color:#fff}
.vtag.cold{background:var(--cold);color:#fff}
.vtag.warn{background:var(--warn);color:#fff}
.vtag.none{background:var(--line);color:var(--sub)}
.vtag.hit{background:var(--good);color:#fff}
.vtag.miss{background:var(--bad);color:#fff}
.vtag.partial{background:#faad14;color:#fff}
.vtag.pend{background:var(--accent-dim);color:var(--accent)}
.vtag.na{background:var(--line);color:var(--sub)}
.hrec .h-right{display:flex;flex-direction:column;align-items:flex-end;gap:4px;white-space:nowrap}
.hrec .h-score{font-size:15px;font-weight:800}
.hrec .h-score .hadr{font-size:11px;font-weight:400;color:var(--sub);margin-left:4px}
.hrec .h-flag{font-size:11px;font-weight:700;padding:3px 10px;border-radius:6px}
.hrec .h-flag.hit{background:var(--good-bg);color:var(--good);border:1px solid var(--good)}
.hrec .h-flag.miss{background:var(--bad-bg);color:var(--bad);border:1px solid var(--bad)}
.hrec .h-flag.pend{background:var(--accent-dim);color:var(--accent);border:1px dashed var(--accent)}
.hrec .h-flag.na{background:var(--line);color:var(--weak)}
.hnote{font-size:11.5px;color:var(--weak);background:var(--panel3);border:1px dashed var(--line2);
  border-radius:8px;padding:8px 12px;margin:12px 0}
/* 星级 */
.stars{flex:none;font-size:13px;letter-spacing:1px;color:var(--warn);font-weight:800}
.stars i{font-style:normal;color:var(--line2)}
/* 赔率变动与凯利行 */
.mv-row{
  display:flex;align-items:center;gap:12px;padding:7px 14px;flex-wrap:wrap;
  background:var(--panel3);border-top:1px solid var(--line);font-size:12px;
}
.mv-row .gl{font-weight:800;color:var(--accent);font-size:12px}
.mv-item{display:flex;align-items:center;gap:5px}
.mv-item .hname{color:var(--weak);font-size:10.5px}
.mvd{font-weight:700;font-size:12px}
.mvd.in{color:var(--bad)}      /* 赔率下降=资金流入 */
.mvd.out{color:var(--good)}    /* 赔率上升=资金流出 */
.mvd.flat{color:var(--sub)}
.mvd.na{color:var(--weak);font-weight:400}
.kdif{font-style:normal;font-size:9.5px;color:var(--weak);margin-left:2px}
.num.val{color:var(--good);font-weight:700}
.num.trap{color:var(--bad);font-weight:700}
.sig-row .strong{color:var(--accent)}
.sig-row .high{color:var(--bad)}
.sig-row .low{color:var(--good)}
.sig-row .frm-wr{color:var(--good);font-weight:700}
.sig-row .frm-wr.mid{color:var(--warn)}
.sig-row .frm-wr.low{color:var(--bad)}
.sig-row .xok{color:var(--good);font-weight:700}
.sig-row .xdiff{color:var(--warn);font-weight:700}
.sig-row .asian-pill{color:#7fd8c8;font-weight:700}
/* Toast */
#toast{
  position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);
  background:rgba(17,22,29,.96);color:var(--text);border:1px solid var(--accent);
  border-radius:10px;padding:10px 16px;font-size:12.5px;max-width:88vw;
  opacity:0;pointer-events:none;transition:all .25s;z-index:99;text-align:center;
}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
#errPanel{
  position:fixed;top:8px;right:8px;max-width:60vw;z-index:999;
  background:#3d0b0b;color:#ff9a9a;border:1px solid #ff5252;border-radius:8px;
  padding:6px 10px;font-size:11px;display:none;white-space:pre-wrap;
}
#errPanel.show{display:block}
/* 今日关注高信心榜 */
.focus-board{
  background:linear-gradient(180deg,var(--accent-dim),var(--panel));
  border:1px solid var(--accent);border-radius:12px;padding:12px 14px;margin:0 0 14px;
}
.focus-board .fb-title{font-size:13px;font-weight:800;color:var(--accent);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.focus-board .fb-title .tip{font-size:10.5px;color:var(--weak);font-weight:400;margin-left:auto}
/* 串关 */
.parlay-board{margin:14px 0}
/* 北单内部 tab */
.bd-subtab{display:flex;gap:0;margin:12px 0 8px;border-bottom:1px solid var(--line)}
.bd-subtab button{flex:1;padding:10px 8px;background:transparent;border:none;color:var(--sub);font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;transition:all .15s;min-height:40px}
.bd-subtab button.on{color:var(--accent);border-bottom-color:var(--accent)}
.bd-subtab button:hover{color:var(--text)}
/* 串关历史 */
.parlay-hist{margin:14px 0}
.ph-day{font-size:12px;color:var(--sub);margin:10px 0 6px;font-weight:600}
.ph-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:8px}
.ph-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:12px}
.ph-head b{color:var(--accent)}
.ph-row{display:flex;align-items:center;gap:6px;font-size:11.5px;padding:2px 0}
.ph-row .ph-idx{width:16px;height:16px;border-radius:50%;background:var(--accent-dim);color:var(--accent);text-align:center;line-height:16px;font-size:10px;font-weight:700;flex-shrink:0}
.ph-row .ph-match{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ph-row .ph-dir{color:var(--accent);font-weight:600;flex-shrink:0}
.ph-row .ph-odds{font-weight:700;flex-shrink:0;width:36px;text-align:right}
.ph-locked{font-size:10px;color:var(--warn);background:var(--warn-bg);padding:1px 6px;border-radius:4px;margin-left:6px}
/* 串关命中战绩表 */
.parlay-stats-sec{margin:16px 0}
.ps-cards{display:flex;flex-direction:column;gap:10px;margin-top:8px}
.ps-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px}
.ps-card-title{font-size:14px;font-weight:700;color:var(--accent);margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid var(--line)}
.ps-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:6px}
.ps-cell{background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px 6px;text-align:center;cursor:pointer;transition:all .15s}
.ps-cell:hover{border-color:var(--accent);transform:translateY(-1px)}
.ps-period{font-size:10px;color:var(--sub);margin-bottom:2px}
.ps-rate{font-size:17px;font-weight:700;line-height:1.2}
.ps-sub{font-size:9.5px;color:var(--sub);margin-top:2px}
.ps-high .ps-rate{color:#2ecc71}
.ps-mid .ps-rate{color:#f1c40f}
.ps-low .ps-rate{color:#e74c3c}
.ps-na .ps-rate{color:var(--sub)}
.ps-detail-head{font-size:13px;font-weight:700;margin-bottom:10px;padding-bottom:8px;border-bottom:1px solid var(--line)}
.ps-day-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px;margin-bottom:8px}
.ps-day-head{display:flex;align-items:center;gap:10px;font-size:12px;margin-bottom:6px}
.ps-day-head .ps-total{margin-left:auto;font-weight:700;color:var(--accent)}
.ps-hit{color:#2ecc71;font-weight:700}
.ps-miss{color:#e74c3c;font-weight:700}
.ps-pend{color:var(--sub)}
.ps-row{display:flex;align-items:center;gap:6px;font-size:11.5px;padding:2px 0;border-bottom:1px dashed var(--line)}
.ps-row:last-child{border-bottom:none}
.ps-row .ps-idx{width:16px;height:16px;border-radius:50%;background:var(--accent-dim);color:var(--accent);text-align:center;line-height:16px;font-size:10px;font-weight:700;flex-shrink:0}
.ps-row .ps-match{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ps-row .ps-dir{color:var(--accent);font-weight:600;flex-shrink:0}
.ps-row .ps-odds{font-weight:700;flex-shrink:0;width:36px;text-align:right}
.pl-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.pl-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px}
.pl-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:13px}
.pl-head .pl-total{color:var(--good);font-weight:700;font-size:12px}
.pl-row{display:flex;align-items:center;gap:6px;font-size:11.5px;padding:4px 0;border-bottom:1px dashed var(--line)}
.pl-row:last-child{border-bottom:none}
.pl-idx{width:16px;height:16px;border-radius:50%;background:var(--accent-dim);color:var(--accent);text-align:center;line-height:16px;font-size:10px;font-weight:700;flex-shrink:0}
.pl-match{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl-dir{color:var(--accent);font-weight:600;flex-shrink:0}
.pl-odds{font-weight:700;flex-shrink:0;width:36px;text-align:right}
/* 北单内部 tab */
.bd-subtab{display:flex;gap:6px;margin:12px 0 8px}
.bd-subtab button{padding:7px 16px;border-radius:8px;border:1px solid var(--line2);background:var(--panel);color:var(--sub);font-size:13px;cursor:pointer;transition:all .15s}
.bd-subtab button:hover{color:var(--text);border-color:var(--accent)}
.bd-subtab button.on{color:var(--accent);border-color:var(--accent);background:var(--accent-dim);font-weight:600}
/* 串关历史 */
.parlay-history{margin:16px 0}
.ph-day{margin-bottom:14px}
.ph-day-head{display:flex;align-items:center;gap:10px;margin-bottom:8px;font-size:13px;font-weight:700;color:var(--accent)}
.ph-day-head .ph-status{font-size:11px;font-weight:400;padding:2px 8px;border-radius:999px;background:var(--accent-dim);color:var(--accent)}
.ph-combos{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px}
.ph-day{margin-bottom:16px;font-size:13px;font-weight:700;color:var(--accent);display:flex;align-items:center;gap:8px}
.ph-locked{font-size:10px;font-weight:400;padding:2px 8px;border-radius:999px;background:var(--accent-dim);color:var(--accent)}
.ph-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px;margin-top:6px}
.ph-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;font-size:12px}
.ph-head span{color:var(--good);font-weight:700;font-size:11px}
.ph-row{display:flex;align-items:center;gap:5px;font-size:11px;padding:2px 0;border-bottom:1px dashed var(--line)}
.ph-row:last-child{border-bottom:none}
.ph-idx{width:14px;height:14px;border-radius:50%;background:var(--accent-dim);color:var(--accent);text-align:center;line-height:14px;font-size:9px;font-weight:700;flex-shrink:0}
.ph-match{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ph-dir{color:var(--accent);font-weight:600;flex-shrink:0;font-size:10.5px}
.ph-odds{font-weight:700;flex-shrink:0;width:32px;text-align:right;font-size:11px}
.focus-items{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px}
.focus-item{
  background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 10px;
  display:flex;flex-direction:column;gap:4px;position:relative;
}
.focus-item .fi-vs{font-size:12px;font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.focus-item .fi-num{font-size:9.5px;font-weight:700;color:var(--accent);background:var(--accent-dim);padding:1px 6px;border-radius:4px;margin-right:4px}
.focus-item .fi-league{font-size:10px;color:var(--accent);background:var(--accent-dim);padding:1px 6px;border-radius:4px}
.focus-item .fi-rank{font-size:10px;color:var(--sub);border:1px solid var(--line2);padding:1px 6px;border-radius:4px}
.focus-item .fi-sub{font-size:10.5px;color:var(--weak);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.focus-item .fi-star{color:var(--warn);font-weight:800;font-size:11px}
.focus-item .fi-dir{font-size:10.5px;font-weight:700;padding:1px 7px;border-radius:4px}
.focus-item .fi-dir.good{background:var(--good-bg);color:var(--good)}
.focus-item .fi-dir.bad{background:var(--bad-bg);color:var(--bad)}
.focus-item .fi-dir.warn{background:var(--warn-bg, rgba(255,193,7,.12));color:var(--warn)}
.focus-item .fi-dir.cold{background:var(--cold-bg, rgba(156,39,176,.12));color:var(--cold)}
.focus-item .fi-verdict{font-size:10.5px;color:var(--sub);line-height:1.35}
.focus-item .fi-form{font-size:9.5px;color:var(--weak);background:var(--panel3);border:1px solid var(--line);padding:1px 6px;border-radius:4px}
.focus-item .fi-cross{font-size:9.5px;font-weight:700;padding:1px 6px;border-radius:4px}
.focus-item .fi-cross.ok{background:rgba(82,196,26,.12);color:var(--good);border:1px solid rgba(82,196,26,.35)}
.focus-item .fi-cross.diff{background:rgba(250,173,20,.12);color:var(--warn);border:1px solid rgba(250,173,20,.4)}
/* 规则组命中率榜 */
.rg-board{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:14px;overflow-x:auto}.rg-board .rg-title{font-size:12.5px;font-weight:700;padding:10px 14px 6px;display:flex;align-items:center;gap:8px}
.rg-board .rg-title .tip{font-size:10.5px;color:var(--weak);font-weight:400;margin-left:auto}
.rg-board table{min-width:560px}
.rg-board td,.rg-board th{padding:6px 10px}
.rg-board .ratebar{width:70px;height:6px;background:var(--line);border-radius:3px;overflow:hidden;display:inline-block;vertical-align:middle;margin-left:6px}
.rg-board .ratebar i{display:block;height:100%}
.rate-high{color:var(--good)} .rate-mid{color:var(--warn)} .rate-low{color:var(--bad)}
/* 星级分层命中率 */
.star-board{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:14px;overflow-x:auto}
.star-board .sb-title{font-size:12.5px;font-weight:700;padding:10px 14px 6px;display:flex;align-items:center;gap:8px}
.star-board .sb-title .tip{font-size:10.5px;color:var(--weak);font-weight:400;margin-left:auto}
.star-board table{min-width:520px}
.star-board td,.star-board th{padding:6px 10px}
@media (max-width:768px){
  .hrec{grid-template-columns:1fr;gap:6px}
  .hrec .h-right{align-items:flex-start;flex-direction:row;gap:10px}
  .maintab{padding:8px 10px 0;gap:4px}
  .maintab button{padding:8px 6px;font-size:12px;flex:1 1 22%;white-space:nowrap;text-align:center}
  .maintab button .bdg{margin-left:3px;padding:0 5px;font-size:9px}
}
/* ============ 响应式（手机竖屏全面优化，零溢出） ============ */
@media (max-width:768px){
  html,body{overflow-x:hidden;max-width:100vw}
  *{box-sizing:border-box}
  /* 头部 */
  .hdr-in{height:auto;padding:8px 10px;flex-wrap:wrap;gap:6px;max-width:100vw}
  .brand{flex:1;min-width:0}
  .brand h1{font-size:14px}
  .brand .sub{display:none}
  .hdr-actions{display:flex;gap:4px;flex-wrap:wrap;max-width:100%}
  .hbtn{padding:5px 8px;font-size:11px;gap:4px}
  .hbtn svg.ico{width:13px;height:13px}
  /* 统计条 */
  .stats{order:3;width:100%;justify-content:flex-start;gap:3px;overflow-x:auto;-webkit-overflow-scrolling:touch}
  .stat{min-width:44px;flex:0 0 auto;padding:3px 5px}
  .stat b{font-size:13px}
  .stat span{font-size:9px}
  /* 主区 */
  main{padding:10px 8px 28px;max-width:100vw}
  .upd{margin-left:0;font-size:10px}
  /* 工具栏 */
  .toolbar{gap:6px;margin-bottom:10px}
  .chips{gap:4px}
  .chip{padding:4px 10px;font-size:11px}
  .chip .bdg{font-size:8.5px;padding:0 4px}
  .seg{margin-left:0}
  .seg button{padding:5px 10px;font-size:11px}
  .date-filter select{font-size:11px;padding:4px 5px;min-height:28px}
  /* 今日关注 */
  .focus-sec{margin-bottom:12px}
  .focus-title{font-size:12px;padding:8px 10px}
  .hrec{padding:8px 10px}
  .hrec .h-left .num{font-size:10px}
  .hrec .h-left .teams{font-size:12px}
  .hrec .h-left .meta{font-size:9.5px}
  .hrec .h-right .dir-tag{font-size:10px;padding:2px 6px}
  .hrec .h-right .stars{font-size:11px}
  .hrec .reason{font-size:10px;margin-top:4px}
  /* 赛程卡片 */
  .m-head{padding:8px 10px;flex-wrap:wrap;gap:4px}
  .m-vs{font-size:12px;flex:1;min-width:0}
  .m-vs .home,.m-vs .away{font-size:12px}
  .m-right{margin-left:0;width:100%;justify-content:flex-start;gap:4px;flex-wrap:wrap}
  .m-right .tag{font-size:9.5px;padding:2px 5px}
  .verdict,.hit-line,.hhad-row,.m-foot{padding-left:10px;padding-right:10px;font-size:11px}
  .odds-row{padding:6px 10px}
  .odds-row .o-item{padding:4px 0}
  .odds-row .o-odds{font-size:13px}
  .odds-row .o-prob,.odds-row .o-sup{font-size:10px}
  .odds-row .o-votes{font-size:9.5px}
  .bar-track{height:5px}
  .deep-row{padding:6px 10px;font-size:10px;flex-wrap:wrap;gap:4px}
  .deep-row .d-item{font-size:9.5px}
  .score-row{padding:6px 10px;font-size:10px}
  /* 串关卡片 */
  .parlay-grid{grid-template-columns:1fr;gap:8px}
  .parlay-card{padding:10px}
  .parlay-card .pc-title{font-size:12px}
  .parlay-card .pc-return{font-size:13px}
  .parlay-card .pc-pick{font-size:10.5px;padding:3px 0}
  /* 串关命中战绩 */
  .ps-card{padding:8px}
  .ps-card-title{font-size:12px}
  .ps-grid{gap:4px}
  .ps-cell{padding:6px 4px}
  .ps-period{font-size:9px}
  .ps-rate{font-size:14px}
  .ps-sub{font-size:8.5px}
  /* 北单页面 */
  .bd-stats{grid-template-columns:repeat(2,1fr);gap:6px}
  .bd-stat{padding:8px}
  .bd-stat b{font-size:16px}
  .bd-stat span{font-size:10px}
  .bd-card{padding:8px 10px}
  .bd-card .bd-head{font-size:11px;flex-wrap:wrap;gap:4px}
  .bd-card .bd-teams{font-size:12px}
  .bd-card .bd-odds{font-size:10.5px}
  .bd-card .bd-meta{font-size:9.5px}
  /* 历史战绩 */
  .hist-summary{grid-template-columns:repeat(2,1fr);gap:6px}
  .hist-card{padding:8px}
  .hist-card b{font-size:16px}
  .hist-card span{font-size:10px}
  .rg-board{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .rg-board table{min-width:480px}
  .star-board{overflow-x:auto;-webkit-overflow-scrolling:touch}
  .star-board table{min-width:480px}
  /* 弹窗 */
  .modal{max-width:92vw!important;margin:10px;padding:14px}
  .modal h3{font-size:14px}
  .modal .tip{font-size:11px}
  .modal textarea{font-size:11px}
  .m-actions{gap:6px}
  .btn{padding:7px 12px;font-size:12px}
  /* 关于弹窗 */
  .about-sec{margin:10px 0;padding-bottom:8px}
  .about-title{font-size:12px}
  .about-item{font-size:11px;padding:5px 0}
  /* 主题选择面板（居中弹出） */
  #themePicker{min-width:200px;max-width:85vw;padding:12px}
  .theme-opt{padding:7px 8px;font-size:12px}
  /* 实时时钟条 */
  .live-bar{padding:6px 10px;font-size:10.5px;flex-wrap:wrap;gap:4px}
  .live-bar .lb-time{font-size:11px}
  .live-bar .lb-count{font-size:10px}
  /* 页脚 */
  footer{padding:10px 8px}
  footer .ft{font-size:10px;line-height:1.6}
  /* 确保所有图片/表格不溢出 */
  img,table{max-width:100%}
  /* 进度条容器 */
  .progress-wrap{max-width:100%;overflow:hidden}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}
</style>
</head>
<body>

<header>
  <div class="hdr-in">
    <div class="brand">
      <div class="logo">
        <svg class="ico" viewBox="0 0 24 24"><path d="M4 9v6M8.5 6v12M13 3v18M17.5 8v8M21 5v14"/></svg>
      </div>
      <div>
        <h1>竞彩智析 · 足球数据中枢 <span class="ver-tag" id="headerVer">v1.0.0</span></h1>
        <div class="sub">官方数据 · 12组规则引擎 · 智能分析中枢</div>
      </div>
    </div>
    <div class="stats" id="statBar"></div>
    <div class="hdr-actions">
      <button class="hbtn" id="freshBtn" title="获取最新数据（手动刷新当前数据）">
        <svg class="ico" viewBox="0 0 24 24"><path d="M20 12a8 8 0 1 1-2.34-5.66M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span>最新数据</span>
      </button>
      <button class="hbtn" id="themeBtn" title="切换深浅主题">
        <svg class="ico" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <span>主题</span>
      </button>
      <button class="hbtn" id="installBtn" title="安装为 App（添加到主屏幕）">
        <svg class="ico" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        <span>安装App</span>
      </button>
      <button class="hbtn" id="importBtn" title="导入数据">
        <svg class="ico" viewBox="0 0 24 24"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>
        <span>导入</span>
      </button>
      <button class="hbtn" id="aboutBtn" title="关于与数据来源">
