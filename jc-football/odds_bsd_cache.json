.obsd-arrow{font-size:10px;font-weight:700}
@media(max-width:768px){.obsd-cell{font-size:10px;padding:2px 1px}.obsd-cur{font-size:11px}.obsd-book{font-size:8.5px}}
/* 官方赛果核对（football-data.org 独立源） */
.fd-view{padding:4px 0}
.fd-group{margin-bottom:14px}
.fd-group-title{font-size:12px;font-weight:700;color:var(--accent);margin:6px 2px 6px;border-left:3px solid var(--accent);padding-left:8px}
.fd-card{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin-bottom:6px}
