/* 联赛中文名（历史记录兜底，正常已为中文） */
const WS_LEAGUE_ZH = {"Premier League":"英超","Championship":"英冠","LaLiga":"西甲","Bundesliga":"德甲","Serie A":"意甲","Ligue 1":"法甲","Eredivisie":"荷甲","Liga Portugal":"葡超","Jupiler Pro League":"比甲","Super Lig":"土超","Allsvenskan":"瑞超","Eliteserien":"挪超","Brasileirao":"巴甲","MLS":"美职联"};

/* 英文队名 → 中文：先精确查表，再剥离 FC/Calcio/成立年份等冗余 token 兜底
   （与服务端 team_map.norm_team 规则对齐的常见情形，如 Parma Calcio 1913 → Parma） */
function spZh(n){
  if(!n) return "?";
  if(SP_TEAM_ZH[n]) return SP_TEAM_ZH[n];
  const t = String(n)
    .replace(/\b(FC|CF|AC|AS|SC|SV|SK|NK|FK|Calcio|Club|Clube|Futebol|Football|Fotbal|Fotboll)\b/gi, "")
    .replace(/\b(1[89]\d{2}|20[0-2]\d)\b/g, "")
    .replace(/\s+/g, " ").trim();
  return (t && SP_TEAM_ZH[t]) ? SP_TEAM_ZH[t] : n;
}

/* ================= 比分预测 · WhoScored 区块（竞彩主干化，v1.7.23） =================
   口径（用户需求）：只显示竞彩每天开出的比赛；当天竞彩赛程【全部列出】为主干；
   WhoScored 有预测的对应挂上比分，无预测标「未推荐」并说明原因；赛后自动回填赛果。
   关联键：竞彩编号（num）+ 日期 ±2 天。
   ⚠️ 为什么必须带日期：竞彩编号每周循环（每周一都有「周一002」），只按编号直查会把
   上周同号比赛误配到本周（曾出现「周一002 代格福什vs卡尔马 → 上周亚特兰大」错配），
   日期过滤后编号在 ±2 天窗口内不可能重复，匹配才唯一。 */
function wsJcCandidate(j, wsByNum){
  const cands = wsByNum[j.num] || [];
  if(!cands.length) return null;
  const base = (j.kickoff || j.date || "").slice(0,10);
  const scored = [];
  cands.forEach(c=>{
    let dd = 99;
    try{
      dd = Math.abs((Date.parse(c.date+"T00:00:00Z") - Date.parse(base+"T00:00:00Z")) / 86400000);
    }catch(e){}
    if(dd > 2) return;  // 编号每周循环，超出 ±2 天必为其他周的同号比赛，丢弃
    // 队名一致仅作同级排序权重（翻译失败时不淘汰，避免误杀）
    const teamOk = (spZh(c.home)===j.home && spZh(c.away)===j.away) ? 0 : 1;
    scored.push({c:c, dd:dd, teamOk:teamOk});
  });
  if(!scored.length) return null;
  scored.sort((a,b)=> (a.dd-b.dd) || (a.teamOk-b.teamOk));
  return scored[0].c;
}

/* 联赛 → {n:场次数, p:有预测场次数}（WhoScored 的 league 字段入库时已译为中文，可与竞彩中文联赛名直接比对） */
function wsLeagueStat(wsMs){
  const g = {};
  (wsMs||[]).forEach(m=>{
    const lg = m.league || "";
    if(!lg) return;
    const s = g[lg] || (g[lg] = {n:0, p:0});
    s.n++;
    if(m.predH != null) s.p++;
  });
  return g;
}

/* 竞彩场次状态推断（无回填数据时展示） */
function wsJcStatusText(j){
  const st = j.status || "";
  if(st && st !== "Selling"){
    const m = {"Finished":"已结束","Ended":"已结束","Live":"进行中","InPlay":"进行中","Paused":"中场",
               "Cancelled":"已取消","Postponed":"已延期","Suspended":"已暂停"};
    return m[st] || st;
  }
  try{
    const k = Date.parse((j.kickoff || "").replace(" ", "T") + "+08:00");
    if(!isNaN(k)){
      const diff = k - Date.now();
      if(diff > 0) return "未开赛";
      if(diff > -2.5*3600*1000) return "进行中";
      return "已结束 · 赛果待回填";
    }
  }catch(e){}
  return "";
}

/* WhoScored 人工预测区块（主力内容）：竞彩当日全部场次为主干 + 预测挂载 + 未推荐原因 + 赛后回填 */
function renderWhoScored(){
  const ws = (typeof BUILT_WHOSCORED!=="undefined" && BUILT_WHOSCORED) ? BUILT_WHOSCORED : {};
  const wsMs = ws.matches || [];
  const sum = $("#wsSummary");
  if(sum){
    const ov = (ws.reliable||{}).overall||{};
    sum.innerHTML = `主干 = 当天竞彩开出的全部比赛；有预测挂比分，无预测标「未推荐」并注明原因，赛后自动回填赛果。`
      + ` · 全源回测 <b style="color:var(--text)">${ov.n||0}</b> 场（精确比分命中 <b style="color:var(--text)">${ov.exactHit!=null?ov.exactHit+"%":"-"}</b>，方向命中 <b style="color:var(--text)">${ov.outcomeHit!=null?ov.outcomeHit+"%":"-"}</b>）`
      + ` · 更新 ${ws.updatedAt||"-"}`;
  }
  const bar = $("#wsDateBar"), list = $("#wsList");
  if(!bar || !list) return;
  const jcAll = (typeof BUILT_DATA!=="undefined" && BUILT_DATA.matches) ? BUILT_DATA.matches : [];
  const wsByNum = {};
  wsMs.forEach(m=>{ if(m.jcNum){ (wsByNum[m.jcNum] = wsByNum[m.jcNum] || []).push(m); } });
  const lgStat = wsLeagueStat(wsMs);
  // 日期选项 = 竞彩销售日（matches.json 即当天开售赛程）
  const jcDates = Array.from(new Set(jcAll.map(m=>m.date).filter(Boolean))).sort().reverse();
  if(!jcDates.length){
    bar.innerHTML = `<div class="empty">暂无竞彩赛程数据（每日自动更新）</div>`;
    list.innerHTML = "";
  } else {
    if(!state.wsJcDate || jcDates.indexOf(state.wsJcDate)<0) state.wsJcDate = jcDates[0];
    let bh = `<button class="sp-chip ${state.wsOnlyHot?"on":""}" data-act="hot">🔥只看高可信</button>`;
    jcDates.slice(0,14).forEach(d=>{
      bh += `<button class="sp-chip ${state.wsJcDate===d?"on":""}" data-dt="${d}">${d.slice(5).replace("-","/")}</button>`;
    });
    bar.innerHTML = bh;
    bar.querySelectorAll(".sp-chip").forEach(b=>{
      b.onclick = ()=>{ if(b.dataset.act==="hot"){ state.wsOnlyHot = !state.wsOnlyHot; }
                        else { state.wsJcDate = b.dataset.dt; } renderScorePred(); };
    });
    let view = jcAll.filter(m=>m.date===state.wsJcDate).map(j=>({j:j, wm:wsJcCandidate(j, wsByNum)}));
    if(state.wsOnlyHot) view = view.filter(x=>x.wm && wsIsHot(x.wm));
    view.sort((a,b)=> (a.j.time||"").localeCompare(b.j.time||""));
    if(!view.length){
      list.innerHTML = `<div class="empty">该日期竞彩无比赛${state.wsOnlyHot?"（或没有高可信预测）":""}</div>`;
    } else {
      const nPred = view.filter(x=>x.wm && x.wm.predH!=null).length;
      const noPred = view.filter(x=>!(x.wm && x.wm.predH!=null));
      // 未推荐原因归类：同联赛有推荐 → 疑似漏匹配（待核对）；否则 → 数据源未覆盖
      const warnLgs = [], coverLgs = [];
      noPred.forEach(x=>{
        const s = lgStat[x.j.league];
        if(s && s.p>0){ if(warnLgs.indexOf(x.j.league)<0) warnLgs.push(x.j.league); }
        else { if(coverLgs.indexOf(x.j.league)<0) coverLgs.push(x.j.league); }
      });
      let html = `<div class="ws-jc-tip">本日竞彩 <b>${view.length}</b> 场 · 有预测 <b>${nPred}</b> 场 · 未推荐 <b>${noPred.length}</b> 场`
        + (coverLgs.length ? `（${coverLgs.join("、")} 数据源暂无人工预测）` : ``)
        + (warnLgs.length ? ` · <span class="ws-namewarn">⚠️ ${warnLgs.join("、")} 有同联赛推荐却未匹配，请人工核对</span>` : ``)
        + `</div>`;
      view.forEach(({j, wm})=>{
        const hasPred = wm && wm.predH!=null;
        const zhH = wm ? spZh(wm.home) : "", zhA = wm ? spZh(wm.away) : "";
        // 队名核对：WhoScored 英文名译回中文后与竞彩官方名不一致 → 醒目提示人工核对
        const nameMismatch = !!wm && (zhH!==j.home || zhA!==j.away);
        let predBlock = "";
        if(hasPred){
          predBlock = `<div class="ws-scoreline">
              <div><div class="sp-label">WhoScored 预测比分</div>
                <div class="ws-pred">${wm.predH} <i>:</i> ${wm.predA}</div></div>
              <div class="ws-metawrap"><div class="sp-label">${wm.league||j.league||""}</div>
                <div class="ws-meta">北京时间 ${wm.bjTime||j.time||"-"}</div></div>
            </div>
            ${wsConfHtml(wm)}
            ${(zhH!==wm.home||zhA!==wm.away)?`<div class="sp-enline">${wm.home||""} vs ${wm.away||""}</div>`:``}`;
        } else {
          const s = lgStat[j.league];
          let reason, warn = false;
          if(wm){
            reason = `该场已收录但无人工预测${wm.evaluated?"（赛后赛果见下方）":""}`;
          } else if(s && s.p>0){
            reason = `该场暂无人工预测（同联赛共 ${s.p} 场有推荐，如认为应有预测请人工核对队名/日期）`;
            warn = true;
          } else if(s){
            reason = `该联赛暂无人工预测（${s.n} 场 0 推荐）`;
          } else {
            reason = `数据源未覆盖该联赛`;
          }
          predBlock = `<div class="ws-nopred${warn?" warn":""}"><span class="ws-nopred-tag">未推荐</span>`
            + `<span class="ws-nopred-why">${reason}</span></div>`;
        }
        // 赛后回填：WhoScored 评估出的实际比分 + 命中情况（无预测的场次只展示赛果）
        let res = "";
        if(wm && wm.evaluated && wm.actH!=null){
          res = `<div class="ws-res"><span class="sp-dact">实际 ${wm.actH}:${wm.actA}</span>`
            + (hasPred ? `<span class="${wm.exactHit?"good":"bad"}">${wm.exactHit?"✓精确命中":"✗比分未中"}</span>`
              + `<span class="${wm.outcomeHit?"good":"bad"}">${wm.outcomeHit?"方向✓":"方向✗"}</span>` : ``)
            + `</div>`;
        } else {
          const stt = wsJcStatusText(j);
          if(stt) res = `<div class="ws-res"><span class="sp-dact" style="color:var(--weak)">${stt}</span></div>`;
        }
        html += `<div class="sp-card ws-jc ${(wm&&wm.evaluated)?"sp-fin":""}">
          <div class="sp-teams"><span class="sp-home">${j.home}</span><span class="sp-vs">vs</span><span class="sp-away">${j.away}</span>
            <span class="ws-jcnum">竞彩 ${j.num}</span></div>
          <div class="sp-enline">${j.league||""} · 开球 ${j.time||""}${nameMismatch?` · <span class="ws-namewarn">⚠️队名待核对：${zhH} vs ${zhA}</span>`:``}</div>
          ${predBlock}
          ${res}
        </div>`;
      });
      list.innerHTML = html;
    }
  }
  /* 赛后回溯：只显示对应竞彩的场次（编号由服务端持久档案补挂，赛后自动纳入） */
  const hb = $("#wsHistBar"), hl = $("#wsHistList");
  if(hb && hl){
    const histJc = (ws.history || []).filter(r=>r.jcNum);
    if(!histJc.length){
      hb.innerHTML = `<div class="empty">暂无对应竞彩的赛后回溯（比赛完赛后自动补挂编号并纳入，约开球 2 小时后）</div>`;
      hl.innerHTML = "";
    } else {
      const hdl = Array.from(new Set(histJc.map(r=>r.date))).sort().reverse();
      if(!state.wsHistDate || hdl.indexOf(state.wsHistDate)<0) state.wsHistDate = hdl[0];
      let hh = "";
      hdl.slice(0,14).forEach(d=>{ hh += `<button class="sp-chip ${state.wsHistDate===d?"on":""}" data-dt="${d}">${d.slice(5).replace("-","/")}</button>`; });
      hb.innerHTML = hh;
      hb.querySelectorAll(".sp-chip").forEach(b=>{ b.onclick=()=>{ state.wsHistDate=b.dataset.dt; renderScorePred(); }; });
      const rows = histJc.filter(r=>r.date===state.wsHistDate);
      if(!rows.length){ hl.innerHTML = `<div class="empty">该日期无记录</div>`; }
      else {
        let he=0, ho=0;
        rows.forEach(r=>{ if(r.exactHit) he++; if(r.outcomeHit) ho++; });
        let x = `<div class="sp-date-sum">${state.wsHistDate} · 对应竞彩 <b>${rows.length}</b> 场完赛 · 精确命中 <b>${he}</b>（${(he/rows.length*100).toFixed(0)}%）· 方向命中 <b>${ho}</b>（${(ho/rows.length*100).toFixed(0)}%）</div><div class="sp-date-grid">`;
        rows.forEach(r=>{
          const zhH = spZh(r.home), zhA = spZh(r.away);
          x += `<div class="sp-dcard ws-jc">
            <div class="sp-dteams">${zhH} <span class="sp-vs">vs</span> ${zhA}<span class="ws-jcnum sm">竞彩 ${r.jcNum}</span></div>
            <div class="sp-dscores"><span class="sp-dpred">预测 ${r.predH}:${r.predA}</span><span class="sp-dact">实际 ${r.actH}:${r.actA}</span></div>
            <div class="sp-dfoot"><span class="${r.exactHit?"good":"bad"}">${r.exactHit?"✓精确":"✗未中"}</span><span class="${r.outcomeHit?"good":"bad"}">${r.outcomeHit?"方向✓":"方向✗"}</span><span class="sp-dlg">${r.league||""}</span></div>
          </div>`;
        });
        x += `</div>`;
        hl.innerHTML = x;
      }
    }
  }
  /* 准确度排行（联赛/球队，基于真实回测累积） */
  const rb = $("#wsRankBar"), rl = $("#wsRankList");
  if(rb && rl){
    const hist = ws.history || [];
    if(!hist.length){
      rb.innerHTML = `<div class="empty">暂无排行数据（今晚比赛完赛后自动累积）</div>`;
      rl.innerHTML = "";
    } else {
      const mode = state.wsRankMode || "lg-exact";  // lg-exact | lg-out | team-exact | team-out
      const isTeam = mode.startsWith("team");
      const byOutcome = mode.endsWith("out");
      const MINN = 3;
      const g = {};
      hist.forEach(r=>{
        const keys = isTeam ? [r.home, r.away] : [r.league || r.leagueEn];
        keys.forEach(k=>{
          if(!k) return;
          (g[k] = g[k] || []).push(r);
        });
      });
      let rows = Object.entries(g).map(([k, rs])=>{
        const n = rs.length;
        return {
          name: k, n,
          exact: rs.filter(x=>x.exactHit).length / n * 100,
          out: rs.filter(x=>x.outcomeHit).length / n * 100,
        };
      }).filter(r=>r.n >= MINN);
      rows.sort((a,b)=> (byOutcome ? (b.out-a.out || b.exact-a.exact || b.n-a.n) : (b.exact-a.exact || b.out-a.out || b.n-a.n)));
      const chips = [["lg-exact","联赛·精确"],["lg-out","联赛·方向"],["team-exact","球队·精确"],["team-out","球队·方向"]];
      rb.innerHTML = chips.map(c=>`<button class="sp-chip ${mode===c[0]?"on":""}" data-rk="${c[0]}">${c[1]}</button>`).join("")
        + `<span class="sp-rank-note">共 ${hist.length} 场回测 · 榜单按${byOutcome?"方向命中":"精确命中"}排序</span>`;
      rb.querySelectorAll(".sp-chip").forEach(b=>{ b.onclick=()=>{ state.wsRankMode=b.dataset.rk; renderScorePred(); }; });
      if(!rows.length){
        rl.innerHTML = `<div class="empty">样本不足（每项至少 ${MINN} 场完赛才入榜）</div>`;
      } else {
        const MAXV = 40;  // 精确命中的满分参考（超过即满条）
        let t = `<div class="ws-rank-table">`;
        rows.slice(0, 20).forEach((r, i)=>{
          const zh = isTeam ? spZh(r.name) : (WS_LEAGUE_ZH[r.name] || r.name);
          const v = byOutcome ? r.out : r.exact;
          const w = Math.min(100, v / (byOutcome ? 100 : MAXV) * 100);
          const cls = byOutcome ? "out" : "exact";
          t += `<div class="ws-rank-row">
            <span class="ws-rank-i ${i<3?"top":""}">${i+1}</span>
            <span class="ws-rank-name">${zh}${zh!==r.name?`<i class="sp-enline">${r.name}</i>`:``}</span>
            <span class="ws-rank-bar"><i class="${cls}" style="width:${w.toFixed(0)}%"></i></span>
            <span class="ws-rank-v">${(byOutcome?r.out:r.exact).toFixed(0)}%</span>
            <span class="ws-rank-n">${r.n}场</span>
          </div>`;
        });
        t += `</div>`;
        rl.innerHTML = t;
      }
    }
  }
}

/* 该场预测是否"高可信"（比分或方向任一达到高） */
function wsIsHot(m){ return !!(m && m.conf && (m.conf.exactLevel==="high" || m.conf.dirLevel==="high")); }

/* 可信度区块：历史命中率反哺 → 该场预测的可信度 + 跟注建议（仅参考，不构成投注建议） */
function wsConfHtml(m){
  const c = m && m.conf;
  if(!c || !c.sample){
    const wsd = (typeof BUILT_WHOSCORED!=="undefined" && BUILT_WHOSCORED) ? BUILT_WHOSCORED : {};
    const bl = (wsd.reliable||{}).baseline || {};
    const nm = (bl.dir!=null ? bl.dir+"%" : "-");
    return `<div class="ws-conf none"><span class="ws-conf-tag">可信度待积累</span>`
      + `<span class="ws-conf-note">历史样本 0 场，暂按全局基线（方向 ${nm}）显示，随每日完赛自动校准</span></div>`;
  }
  const lv = (c.exactLevel==="high") ? "high" : (c.dirLevel==="high" ? "high" : (c.exactLevel==="mid"||c.dirLevel==="mid" ? "mid" : "low"));
  const tag = lv==="high" ? "🔥 高可信" : (lv==="mid" ? "可信度中等" : "⚠️ 谨慎");
  return `<div class="ws-conf ${lv}">
    <div class="ws-conf-h"><span class="ws-conf-tag">${tag}</span>
      <span class="ws-conf-note">样本 ${c.sample} 场（联赛 ${c.leagueN} / 球队 ${c.teamN}）</span></div>
    <div class="ws-conf-bars">
      <div class="ws-conf-line"><span class="ws-conf-t">方向</span>
        <span class="ws-rank-bar"><i class="out ${c.dirLevel==="high"?"hi":""}" style="width:${Math.min(100,c.dir).toFixed(0)}%"></i></span>
        <span class="ws-conf-v">${c.dir}%</span></div>
      <div class="ws-conf-line"><span class="ws-conf-t">比分</span>
        <span class="ws-rank-bar"><i class="exact ${c.exactLevel==="high"?"hi":""}" style="width:${Math.min(100,c.exact*3).toFixed(0)}%"></i></span>
        <span class="ws-conf-v">${c.exact}%</span></div>
    </div>
    <div class="ws-conf-tip">${c.tip||""}</div>
  </div>`;
}

/* 自建 Poisson 模型区的竞彩过滤：只保留与竞彩赛程（当天 + 历史档案）队名组合一致的场次。
   主客顺序不敏感；翻译失败（spZh 返回英文）时保守隐藏——该区仅作交叉参考，
   宁可少显也不错配（错配正是用户投诉「对应不上竞彩赛程」的痛点）。 */
function spJcPairs(){
  if(spJcPairs._cache) return spJcPairs._cache;
  const s = new Set();
  const add = (h, a)=>{ if(h && a){ s.add(h+"|"+a); s.add(a+"|"+h); } };
  try{
    ((typeof BUILT_DATA!=="undefined" && BUILT_DATA.matches) ? BUILT_DATA.matches : [])
      .forEach(m=>add(m.home, m.away));
    ((typeof BUILT_HISTORY!=="undefined" && BUILT_HISTORY.records) ? BUILT_HISTORY.records : [])
      .forEach(r=>add(r.home, r.away));
  }catch(e){}
  spJcPairs._cache = s;
  return s;
}
function spJcFilter(list){
  const pairs = spJcPairs();
  if(!pairs.size) return list || [];
  return (list||[]).filter(m=>{
    const h = spZh(m.home), a = spZh(m.away);
    // 翻译成功（中文）才参与匹配；仍是英文说明映射缺失，无法可靠判定 → 隐藏
    if(!h || !a || /[A-Za-z]/.test(h) || /[A-Za-z]/.test(a)) return false;
    return pairs.has(h+"|"+a) || pairs.has(a+"|"+h);
  });
}

/* 按队名组合反查竞彩编号（供自建模型区徽章用）：当天赛程优先 → 档案同日 → 档案最近。
   date 可选（Poisson 回溯行带日期）；主客顺序不敏感。 */
function spJcNumOf(m, date){
  const h = spZh(m.home), a = spZh(m.away);
  if(!h || !a || /[A-Za-z]/.test(h) || /[A-Za-z]/.test(a)) return null;
  const same = (x, y)=> (x===h && y===a) || (x===a && y===h);
  try{
    const bd = (typeof BUILT_DATA!=="undefined" && BUILT_DATA.matches) ? BUILT_DATA.matches : [];
    for(const j of bd){ if(same(j.home, j.away)) return j.num || null; }
    const hr = (typeof BUILT_HISTORY!=="undefined" && BUILT_HISTORY.records) ? BUILT_HISTORY.records : [];
    if(date){
      for(const r of hr){ if(r.date===date && same(r.home, r.away)) return r.num || null; }
      // 同日无 → ±1 天容差（销售日与开球日可能差一天）
      try{
        const t = Date.parse(date+"T00:00:00Z");
        for(const off of (-1, 1)){
          const d = new Date(t + off*86400000).toISOString().slice(0,10);
          for(const r of hr){ if(r.date===d && same(r.home, r.away)) return r.num || null; }
        }
      }catch(e){}
    }
    let best = null;
    for(const r of hr){ if(same(r.home, r.away) && (!best || (r.date||"") > (best.date||""))) best = r; }
    return best ? (best.num || null) : null;
  }catch(e){ return null; }
}

function renderScorePred(){
  try{ renderWhoScored(); }catch(e){}
  const sp = BUILT_SCOREPRED || {matches:[], reliable:{}};
  const msAll = sp.matches || [];
  const rel = sp.reliable || {};
  const bdg = $("#spBdg");
  const wsAll = (typeof BUILT_WHOSCORED!=="undefined" && BUILT_WHOSCORED) ? (BUILT_WHOSCORED.matches||[]) : [];
  if(bdg){ bdg.textContent = wsAll.length || msAll.length; }
  /* 只显示竞彩开出的比赛（用户要求）：按「竞彩队名组合」过滤——
     队名集合取自当天赛程 + 竞彩历史档案（BUILT_HISTORY），翻译用 spZh，
     主客顺序不敏感（home|away 与 away|home 都命中） */
  const ms = spJcFilter(msAll);
  const summary = $("#spSummary");
  if(summary){
    const acc = sp.accuracy || {};
    summary.innerHTML = `仅显示对应竞彩的比赛：<b style="color:var(--text)">${ms.length}</b> 场（全源 ${msAll.length} 场，非竞彩场次已隐藏）`
      + ` · 大模型回溯 <b style="color:var(--text)">${acc.n||0}</b> 场`
      + `（精确比分命中 <b style="color:var(--text)">${acc.exactHit!=null?acc.exactHit+"%":"-"}</b>，方向命中 <b style="color:var(--text)">${acc.outcomeHit!=null?acc.outcomeHit+"%":"-"}</b>，平均误差 <b style="color:var(--text)">${acc.mae!=null?acc.mae:"-"}</b> 球）`
      + ` · 独立源：${sp.source||"-"} · 更新 ${sp.updatedAt||"-"}`;
  }

  /* ---- 可靠参考面板：整体 + 高准联赛 + 高准球队 ---- */
  const relBox = $("#spReliable");
  if(relBox){
    const ov = rel.overall || {};
    const lg = rel.leagues || [];
    const tm = rel.teams || [];
    let h = `<div class="sp-rel-grid">`;
    h += `<div class="sp-rel-card"><div class="sp-rel-h">整体模型命中（回溯${ov.n||0}场）</div>
      <div class="sp-big">${ov.exactHit!=null?ov.exactHit+"%":"-"}<span>精确比分</span></div>
      <div class="sp-sub">方向命中 ${ov.outcomeHit!=null?ov.outcomeHit+"%":"-"} · 平均误差 ${ov.mae!=null?ov.mae:"-"} 球</div></div>`;
    if(lg.length){
      h += `<div class="sp-rel-card"><div class="sp-rel-h">🏆 预测较准的联赛（按精确比分命中）</div><div class="sp-rows">`;
      lg.slice(0,6).forEach(x=>{
        h += `<div class="sp-row"><span class="sp-name">${x.league}</span>`
          + `<span class="sp-val good">${x.exactHit}%</span>`
          + `<span class="sp-meta">方向${x.outcomeHit}% · ${x.n}场</span></div>`;
      });
      h += `</div></div>`;
    }
    if(tm.length){
      h += `<div class="sp-rel-card"><div class="sp-rel-h">⭐ 预测较准的球队（按精确比分命中）</div><div class="sp-rows">`;
      tm.slice(0,8).forEach(x=>{
        const zhn = spZh(x.team);
        h += `<div class="sp-row"><span class="sp-name">${zhn}</span>`
          + (zhn!==x.team ? `<span class="sp-en">${x.team}</span>` : ``)
          + `<span class="sp-val good">${x.exactHit}%</span>`
          + `<span class="sp-meta">方向${x.outcomeHit}% · ${x.n}场</span></div>`;
      });
      h += `</div></div>`;
    }
    h += `</div>`;
    if(!lg.length && !tm.length){
      h += `<div class="sp-rel-note">回溯样本积累中（需≥6场/联赛或球队），暂无可推荐的「可靠参考」；随每日运行会自动补充。</div>`;
    }
    relBox.innerHTML = h;
  }

  /* ---- 联赛筛选 ---- */
  const filters = $("#spFilters");
  if(filters){
    const ligs = Array.from(new Set(ms.map(m=>m.league).filter(Boolean)));
    let fh = `<button class="sp-chip ${ (state.spFilter||"all")==="all" ? "on":"" }" data-lg="all">全部</button>`;
    ligs.forEach(lg=>{ fh += `<button class="sp-chip ${ (state.spFilter||"all")===lg ? "on":"" }" data-lg="${lg}">${lg}</button>`; });
    filters.innerHTML = fh;
    filters.querySelectorAll(".sp-chip").forEach(b=>b.onclick=()=>{ state.spFilter=b.dataset.lg; renderScorePred(); });
  }

  /* ---- 比赛列表 ---- */
  const list = $("#spList");
  if(!list) return;
  if(!ms.length){
    list.innerHTML = `<div class="empty">当日竞彩赛程中暂无自建 Poisson 模型覆盖的比赛${sp.note?("（"+sp.note+"）"):""}；非竞彩场次已按要求隐藏</div>`;
    return;
  }
  const filt = state.spFilter || "all";
  const view = (filt==="all" ? ms : ms.filter(m=>m.league===filt));
  const stName = {SCHEDULED:"未开赛", LIVE:"进行中", IN_PLAY:"进行中", PAUSED:"中场", FINISHED:"已结束", POSTPONED:"延期", SUSPENDED:"暂停", CANCELLED:"取消"};
  const outName = {H:"主胜", D:"平局", A:"客胜"};
  const groups = {};
  view.forEach(m=>{ const k=m.league||"其他"; (groups[k]=groups[k]||[]).push(m); });
  let html = "";
  Object.keys(groups).forEach(lg=>{
    html += `<div class="sp-group"><div class="sp-group-title">${lg}（${groups[lg].length}）</div>`;
    groups[lg].forEach(m=>{
      const finished = m.status==="FINISHED";
      const live = (m.status==="LIVE"||m.status==="IN_PLAY"||m.status==="PAUSED");
      // 概率条
      const pH=m.pHome||0, pD=m.pDraw||0, pA=m.pAway||0;
      const probBar = `<div class="sp-prob"><span class="sp-p sp-h" style="width:${pH}%">${pH}%</span>`
        + `<span class="sp-p sp-d" style="width:${pD}%">${pD}%</span>`
        + `<span class="sp-p sp-a" style="width:${pA}%">${pA}%</span></div>`;
      // 比分展示
      const predScore = `<span class="sp-pred">${m.predH} <i>:</i> ${m.predA}</span>`;
      let actual = "";
      let hit = "";
      if(finished && m.actH!=null){
        actual = `<span class="sp-actual">${m.actH} : ${m.actA}</span>`;
        if(m.evaluated){
          const ex = m.exactHit ? `<span class="sp-hit good">✓ 精确命中</span>` : `<span class="sp-hit bad">✗ 未中</span>`;
          const ou = m.outcomeHit ? `<span class="sp-hit good">方向✓</span>` : `<span class="sp-hit bad">方向✗</span>`;
          hit = ex + " " + ou;
        }
      } else if(live){
        actual = `<span class="sp-actual sp-live">${stName[m.status]||"进行中"}</span>`;
      } else {
        actual = `<span class="sp-actual sp-sched">${stName[m.status]||"未开赛"}</span>`;
      }
      const statusCls = finished ? "sp-fin" : (live ? "sp-live" : "sp-sched");
      const zhH = spZh(m.home), zhA = spZh(m.away);
      const jcNum = spJcNumOf(m, m.date);
      html += `<div class="sp-card ${statusCls}">
        <div class="sp-teams"><span class="sp-home">${zhH}</span><span class="sp-vs">vs</span><span class="sp-away">${zhA}</span>${jcNum?`<span class="sp-jcnum" title="对应竞彩赛程编号">竞彩 ${jcNum}</span>`:``}</div>
        ${(zhH!==m.home||zhA!==m.away)?`<div class="sp-enline">${m.home||""} vs ${m.away||""}</div>`:``}
        <div class="sp-scoreline">
          <div class="sp-predwrap"><div class="sp-label">预测比分</div>${predScore}</div>
          <div class="sp-actwrap"><div class="sp-label">实际赛果</div>${actual}</div>
        </div>
        ${probBar}
        <div class="sp-foot"><span class="sp-out">预测方向：${outName[m.predOutcome]||"-"}</span>${hit}</div>
      </div>`;
    });
    html += `</div>`;
  });
  list.innerHTML = html;

  /* ---- 日期回溯：按日期回看历史预测 vs 实际赛果（纯本地历史，不触发抓取） ---- */
  const dateBar = $("#spDateBar");
  const dateListBox = $("#spDateList");
  if(dateBar && dateListBox){
    const dl = sp.dateList || [];
    if(!dl.length){
      dateBar.innerHTML = `<div class="empty">暂无历史回溯数据（每日运行后自动累积）</div>`;
      dateListBox.innerHTML = "";
      return;
    }
    if(!state.spDate || dl.indexOf(state.spDate) < 0) state.spDate = dl[0];
    let dh = "";
    dl.slice(0, 30).forEach(d=>{
      dh += `<button class="sp-chip ${state.spDate===d?"on":""}" data-dt="${d}">${d}</button>`;
    });
    dateBar.innerHTML = dh;
    dateBar.querySelectorAll(".sp-chip").forEach(b=>{
      b.onclick=()=>{ state.spDate=b.dataset.dt; renderScorePred(); };
    });
    const rows = spJcFilter((sp.dateIndex||{})[state.spDate] || []);
    if(!rows.length){
      dateListBox.innerHTML = `<div class="empty">该日期无对应竞彩的记录（非竞彩场次已隐藏）</div>`;
      return;
    }
    let hitE=0, hitO=0;
    rows.forEach(r=>{ if(r.exactHit) hitE++; if(r.outcomeHit) hitO++; });
    let lh = `<div class="sp-date-sum">${state.spDate} · 共 <b>${rows.length}</b> 场 · 精确命中 <b>${hitE}</b> 场（${(hitE/rows.length*100).toFixed(1)}%）`
      + ` · 方向命中 <b>${hitO}</b> 场（${(hitO/rows.length*100).toFixed(1)}%）</div><div class="sp-date-grid">`;
    rows.forEach(r=>{
      const zhH = spZh(r.home), zhA = spZh(r.away);
      const jcN = spJcNumOf(r, state.spDate);
      lh += `<div class="sp-dcard${jcN?" ws-jc":""}">
        <div class="sp-dteams">${zhH} <span class="sp-vs">vs</span> ${zhA}${jcN?`<span class="ws-jcnum sm">竞彩 ${jcN}</span>`:``}</div>
        <div class="sp-dscores"><span class="sp-dpred">预测 ${r.predH}:${r.predA}</span><span class="sp-dact">实际 ${r.actH}:${r.actA}</span></div>
        <div class="sp-dfoot"><span class="${r.exactHit?"good":"bad"}">${r.exactHit?"✓精确":"✗未中"}</span>`
        + `<span class="${r.outcomeHit?"good":"bad"}">${r.outcomeHit?"方向✓":"方向✗"}</span>`
        + `<span class="sp-dlg">${r.league||""}</span></div>
      </div>`;
    });
    lh += `</div>`;
    dateListBox.innerHTML = lh;
  }
}

/* ================= 竞彩篮球专区（独立源，v1.7.30 专区+二级tab，v1.7.32 整页化） =================
   数据：BUILT_BASKETBALL（在售赛程+四玩法赔率）
        BUILT_BASKETBALL_HISTORY（档案，含赛后回填的赛果/让分/大小分结果）
   与足球完全隔离：不读 BUILT_DATA / 不参与任何足球模型计算。
   结构：renderBasketball（专区框架+二级tab分派）
        → renderBkSched（赛程赔率）/ renderBkHist（赛后回看）
        后续篮球新功能（AI预测/串关等）在此加二级 tab + render 函数即可。 */
const BK_PLAY_NAME = {mnl:"胜负", hdc:"让分胜负", hilo:"大小分", wnm:"胜分差"};
const BK_WNM_NAME = {l1:"1-5分", l2:"6-10分", l3:"11-15分", l4:"16-20分", l5:"21-25分", l6:"26+分"};

function renderBasketball(){
  const bk = state.basketball || {matches:[]};
  const histRecs = (state.basketballHist && state.basketballHist.records) || {};
  const msAll = bk.matches || [];
  const bdg = $("#bkBdg");
  if(bdg){ bdg.textContent = msAll.length; }
  if(!state.bkSubTab) state.bkSubTab = "sched";

  /* 档案合并：在售比赛 + 已滚出在售的近期比赛（有赛果的进「赛后回看」） */
  const byId = {};
  msAll.forEach(m => { byId[m.id] = Object.assign({}, m); });
  Object.keys(histRecs).forEach(id => {
    const r = histRecs[id];
    if(!byId[id]) byId[id] = Object.assign({}, r);
    // 在售件 + 档案已有赛果（回填已跑但比赛还没滚出在售列表的窗口期）：
    // 保留在售件的最新盘口，把赛果/判定字段补齐，避免被在售件遮挡导致「赛后回看」漏场（v1.7.32）
    else if(r.score){
      ["score","evaluated","hdcResult","hiloResult","resultAt"].forEach(k => {
        if(r[k] !== undefined) byId[id][k] = r[k];
      });
    }
  });
  const all = Object.keys(byId).map(k => byId[k]);
  const nDone = all.filter(m => m.score).length;
  const nPre = all.length - nDone;

  /* 专区头部 meta（数据源与更新时间） */
  const meta = $("#bkHeadMeta");
  if(meta){
    const parts = [];
    if(bk.updatedAt) parts.push(`赛程赔率更新 ${bk.updatedAt}`);
    if(state.basketballHist && state.basketballHist.updatedAt) parts.push(`赛果档案更新 ${state.basketballHist.updatedAt}`);
    parts.push("每 30 分钟自动更新");
    meta.innerHTML = parts.map(p => `<span>🕐 ${p}</span>`).join("");
  }

  /* 二级 tab 栏（篮球专区专属导航，后续功能往此处追加） */
  const subTabs = $("#bkSubTabs");
  if(subTabs){
    const tabs = [
      {k:"sched", label:"赛程赔率", n:nPre},
      {k:"hist",  label:"赛后回看", n:nDone},
      // ▼ 后续篮球功能在此追加二级 tab（如 {k:"ai", label:"AI预测"}）
    ];
    subTabs.innerHTML = tabs.map(t =>
      `<button class="bk-subtab ${state.bkSubTab===t.k?"on":""}" data-bksub="${t.k}">${t.label}${t.n!=null?`<span class="n">${t.n}</span>`:""}</button>`
    ).join("");
    subTabs.querySelectorAll("button[data-bksub]").forEach(b => {
      b.onclick = () => { state.bkSubTab = b.dataset.bksub; renderBasketball(); };
    });
  }

  /* pane 切换 + 分派渲染 */
  $("#bkSchedPane").style.display = state.bkSubTab === "sched" ? "block" : "none";
  $("#bkHistPane").style.display = state.bkSubTab === "hist" ? "block" : "none";
  if(state.bkSubTab === "hist"){ renderBkHist(all); return; }
  renderBkSched(all);
}

/* 二级 tab：赛程赔率（日期筛选 + 四玩法赔率卡片） */
function renderBkSched(all){
  const sumBox = $("#bkSummary");
  const dateBar = $("#bkDateBar");
  const listBox = $("#bkList");
  if(!listBox) return;
  /* 已完赛的只在「赛后回看」出现，赛程列表只留未开赛/待回填 */
  all = all.filter(m => !m.score);
  all.sort((a,b) => (a.kickoff||"").localeCompare(b.kickoff||""));

  const dates = [...new Set(all.map(m => bkDateOf(m)))].sort();
  if(state.bkDate !== "all" && dates.indexOf(state.bkDate) < 0) state.bkDate = "all";
  if(dateBar){
    let h = `<button class="chip ${state.bkDate==="all"?"on":""}" data-bkdate="all">全部 ${all.length}</button>`;
    dates.forEach(d => {
      const n = all.filter(m => bkDateOf(m) === d).length;
      h += `<button class="chip ${state.bkDate===d?"on":""}" data-bkdate="${d}">${d.slice(5)} ${n}</button>`;
    });
    dateBar.innerHTML = h;
    dateBar.querySelectorAll("button[data-bkdate]").forEach(b => {
      b.onclick = () => { state.bkDate = b.dataset.bkdate; renderBasketball(); };
    });
  }
  const shown = state.bkDate === "all" ? all : all.filter(m => bkDateOf(m) === state.bkDate);

  if(sumBox){
    sumBox.innerHTML = `未开赛/待回填 <b>${shown.length}</b> 场（已完赛的请到「赛后回看」查看）`
      + ` · 四种玩法：胜负 / 让分胜负 / 大小分 / 胜分差`;
  }
  let html = "";
  shown.forEach(m => { html += bkCardHtml(m); });
  if(!shown.length) html = `<div style="padding:20px;text-align:center;color:var(--sub)">暂无篮球赛程数据（数据源每 30 分钟自动更新）</div>`;
  listBox.innerHTML = html;
}

/* 二级 tab：赛后回看（已回填赛果的比赛，按日期倒序分组） */
function renderBkHist(all){
  const sumBox = $("#bkHistSummary");
  const dateBar = $("#bkHistDateBar");
  const listBox = $("#bkHistList");
  if(!listBox) return;
  const done = all.filter(m => m.score);
  done.sort((a,b) => (b.kickoff||"").localeCompare(a.kickoff||""));   // 最近比赛在前
  if(!state.bkHistDate) state.bkHistDate = "all";
  const dates = [...new Set(done.map(m => bkDateOf(m)))].sort().reverse();
  if(state.bkHistDate !== "all" && dates.indexOf(state.bkHistDate) < 0) state.bkHistDate = "all";
  if(dateBar){
    let h = `<button class="chip ${state.bkHistDate==="all"?"on":""}" data-bkhdate="all">全部 ${done.length}</button>`;
    dates.forEach(d => {
      const n = done.filter(m => bkDateOf(m) === d).length;
      h += `<button class="chip ${state.bkHistDate===d?"on":""}" data-bkhdate="${d}">${d.slice(5)} ${n}</button>`;
    });
    dateBar.innerHTML = h;
    dateBar.querySelectorAll("button[data-bkhdate]").forEach(b => {
      b.onclick = () => { state.bkHistDate = b.dataset.bkhdate; renderBasketball(); };
    });
  }
  const shown = state.bkHistDate === "all" ? done : done.filter(m => bkDateOf(m) === state.bkHistDate);
  if(sumBox){
    sumBox.innerHTML = `共 <b>${shown.length}</b> 场已回填赛果 · 开赛 2.5 小时后由定时任务自动回填官方赛果，并判定让分/大小分结果`
      + (shown.length ? ` · 最新一场：${shown[0].home} ${shown[0].score[0]}:${shown[0].score[1]} ${shown[0].away}` : "");
  }
  /* 按日期分组渲染 */
  let html = "";
  const groups = {};
  shown.forEach(m => { const d = bkDateOf(m); (groups[d] = groups[d] || []).push(m); });
  Object.keys(groups).sort().reverse().forEach(d => {
    html += `<div class="bk-group"><div class="bk-group-title">${d}</div>`;
    groups[d].forEach(m => { html += bkCardHtml(m, true); });
    html += `</div>`;
  });
  if(!shown.length) html = `<div style="padding:24px;text-align:center;color:var(--sub)">暂无已回填赛果<br><span style="font-size:11px">今晚美职篮开赛、明早定时任务跑完后自动出现在这里</span></div>`;
  listBox.innerHTML = html;
}

/* 篮球比赛卡片（赛程/回看共用） */
function bkCardHtml(m){
  const done = !!m.score;
  const hdc = m.hdc || {}, hilo = m.hilo || {}, mnl = m.mnl || {}, wnm = m.wnm || {};
  const kickBJ = (m.kickoff || "").slice(5, 16);
  let html = `<div class="bk-card">`
    + `<div class="bk-card-head">`
    + `<span class="bk-num">${m.num || ""}</span>`
    + `<span class="bk-league">${m.league || ""}</span>`
    + `<span class="bk-time">${kickBJ}</span>`
    + `<span class="bk-teams">${m.home || ""}<span class="bk-vs">vs</span>${m.away || ""}</span>`
    + (done
        ? `<span class="bk-status st-done">已完赛</span><span class="bk-score">${m.score[0]} : ${m.score[1]}</span>`
        : `<span class="bk-status st-pre">未开赛</span>`)
    + `</div>`;
  html += `<div class="bk-odds">`
    + bkOdCell("胜负", "", mnl.h, mnl.a, done ? (m.score[0] > m.score[1] ? "h" : "a") : null)
    + bkOdCell("让分胜负", hdc.goalLine ? "主队" + bkSign(hdc.goalLine) : "", hdc.h, hdc.a, done ? m.hdcResult : null)
    + bkOdCell("大小分", hilo.goalLine ? "总分" + bkLine(hilo.goalLine) : "", hilo.h, hilo.l, done ? m.hiloResult : null)
    + `<div class="bk-od"><div class="bk-od-k">胜分差</div><div class="bk-od-line">主胜区间赔率</div>`
    + `<div class="bk-od-v" style="font-size:10px">${wnm.l1 ? "1-5分 " + wnm.l1 : "-"}${wnm.l3 ? " / 11-15分 " + wnm.l3 : ""}</div></div>`
    + `</div>`;
  const wnmKeys = Object.keys(wnm).filter(k => /^l\d+$/.test(k)).sort();
  if(wnmKeys.length){
    html += `<div class="bk-wnm">` + wnmKeys.map(k =>
      `<span>${BK_WNM_NAME[k] || k} ${wnm[k]}</span>`).join("") + `</div>`;
  }
  if(done){
    const parts = [];
    if(m.hdcResult) parts.push(`让分${m.hdcResult === "h" ? "主胜" : m.hdcResult === "a" ? "客胜" : "走水"}`);
    if(m.hiloResult) parts.push(m.hiloResult === "h" ? "大分" : "小分");
    if(parts.length) html += `<div class="bk-res">判定：${parts.join(" · ")}</div>`;
  }
  return html + `</div>`;
}
function bkDateOf(m){ return (m.kickoff || m.date || "").slice(0, 10); }
function bkSign(s){ return String(s).indexOf("-") === 0 ? s : "+" + s; }
function bkLine(s){ return String(s).replace("+", ""); }
function bkOdCell(name, line, hv, av, result){
  /* result: "h"/"a"/"d"/null——命中方高亮 */
  let hCls = "", aCls = "";
  if(result === "h") hCls = "win";
  else if(result === "a") aCls = "win";
  return `<div class="bk-od"><div class="bk-od-k">${name}</div>`
    + (line ? `<div class="bk-od-line">${line}</div>` : "")
    + `<div class="bk-od-v ${hCls}">主 ${hv || "-"}</div>`
    + `<div class="bk-od-v ${aCls}">客 ${av || "-"}</div></div>`;
}

function renderExpert(){
  const exp = state.expert || {};
  const expH = state.expertHistory || {};
  const summary = $("#expertSummary");
  const list = $("#expertList");
  const bdg = $("#expertBdg");
  const view = state.expertView || "today";
  document.querySelectorAll("#expertView .seg button").forEach(b=>b.classList.toggle("on", b.dataset.expertView===view));

  /* 专家排行榜渲染 */
  const rankList = $("#expertRankList");
  const rankWrap = $("#expertRankWrap");
  const expStats = state.expertStats || {};
  const statsArr = Object.values(expStats).filter(s=>s && s.expert);
  if(statsArr.length > 0 && rankList){
    statsArr.sort((a,b)=> (b.score||0) - (a.score||0));
    let rankHtml = `<div style="display:grid;grid-template-columns:32px 1fr 50px 55px 45px 50px;gap:4px;padding:6px 4px;font-size:10.5px;font-weight:600;color:var(--sub);border-bottom:1px solid var(--border);">
      <span>#</span><span>专家</span><span style="text-align:center;">推荐分</span><span style="text-align:center;">命中率</span><span style="text-align:center;">已判定</span><span style="text-align:center;">连红</span>
    </div>`;
    statsArr.forEach((s,i)=>{
      const medal = i===0 ? "🥇" : (i===1 ? "🥈" : (i===2 ? "🥉" : (i+1)));
      const rateCls = s.hitRate>=60 ? "var(--good)" : (s.hitRate>=50 ? "var(--warn)" : "var(--bad)");
      const newTag = s.isNew ? '<span style="font-size:9px;background:var(--accent);color:#fff;padding:1px 4px;border-radius:3px;margin-left:3px;">新</span>' : '';
      rankHtml += `<div style="display:grid;grid-template-columns:32px 1fr 50px 55px 45px 50px;gap:4px;padding:6px 4px;font-size:11px;align-items:center;border-bottom:1px solid rgba(0,0,0,0.04);">
        <span style="font-weight:600;">${medal}</span>
        <span style="font-weight:600;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${s.expert}${newTag}</span>
        <span style="text-align:center;font-weight:700;color:var(--accent);">${s.score||0}</span>
        <span style="text-align:center;font-weight:600;color:${rateCls};">${s.hitRate||0}%</span>
        <span style="text-align:center;color:var(--sub);">${s.judged||0}场</span>
        <span style="text-align:center;color:${s.streak>0?'var(--good)':'var(--sub)'};">${s.streak>0?'🔥'+s.streak:'-'}</span>
      </div>`;
    });
    rankList.innerHTML = rankHtml;
  } else if(rankList) {
    rankList.innerHTML = '<div style="padding:12px;text-align:center;font-size:11.5px;color:var(--sub);">📊 暂无专家战绩数据，今日比赛结束赛果回溯后自动更新排行榜</div>';
  }
  if(rankWrap) rankWrap.style.display = "block";

  if(view==="history"){
    const dates = Object.keys(expH).sort().reverse();
    if(bdg) bdg.textContent = String(dates.length);
    if(!dates.length){
      if(summary) summary.innerHTML = '<span style="color:var(--bad)">暂无历史记录</span>';
      if(list) list.innerHTML = "";
      return;
    }
    let html = "";
    let totalPicks=0, totalHits=0;
    dates.forEach(d=>{
      const recs = expH[d] || [];
      const hits = recs.filter(r=>r.hit===true).length;
      const pending = recs.filter(r=>r.hit===null || r.hit===undefined).length;
      totalPicks += recs.length;
      totalHits += hits;
      html += `<div style="margin:12px 0 6px;font-size:13px;font-weight:600;color:var(--accent);">📅 ${d}（${recs.length}条推荐，命中${hits}/待赛${pending}）</div>`;
      recs.forEach(r=>{
        const hitCls = r.hit===true ? "var(--good)" : (r.hit===false ? "var(--bad)" : "var(--sub)");
        const hitTxt = r.hit===true ? "✓命中" : (r.hit===false ? "✗未中" : "待赛");
        const scoreTxt = r.actualScore ? ` 赛果${r.actualScore}` : "";
        html += `<div class="hf-card" style="margin:6px 0;padding:10px 12px;">
          <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:4px;">
            <span style="font-size:12.5px;font-weight:600;">${r.num||""} ${r.home||""} vs ${r.away||""}</span>
            <span style="font-size:11px;color:${hitCls};font-weight:600;">${hitTxt}${scoreTxt}</span>
          </div>
          <div style="font-size:11.5px;color:var(--sub);margin-top:4px;">
            推荐：<b style="color:var(--text);">${r.recommend||""}</b>（赔率${r.odds||"-"}）
            · 高手：<b>${r.expertName||""}</b>
            · 出处：${r.source||""}
            · 信心：${r.confidence||"-"}%
          </div>
          ${r.reason ? `<div style="font-size:11px;color:var(--sub);margin-top:3px;">理由：${r.reason}</div>` : ""}
        </div>`;
      });
    });
    if(summary) summary.innerHTML = `共 ${dates.length} 天历史记录，${totalPicks} 条推荐，累计命中 ${totalHits} 条（命中率${totalPicks? (totalHits/totalPicks*100).toFixed(1):0}%）`;
    if(list) list.innerHTML = html;
    return;
  }

  // 今日推荐：列出今天全部竞彩比赛，下方挂专家推荐
  const recs = exp.recommendations || [];
  const todayMatches = (BUILT_DATA && BUILT_DATA.matches) || [];
  if(bdg) bdg.textContent = String(recs.length);
  if(summary) summary.innerHTML = `今日 ${todayMatches.length} 场竞彩开售 · 专家推荐 ${recs.length} 场 · 更新于 ${exp.updatedAt||""}`;
  let html = "";
  todayMatches.forEach(m=>{
    const kickoffShort = (m.kickoff||"").slice(11,16);
    const goal = (m.hhad && m.hhad.goal) || "";
    // 找该场的专家推荐
    const matchRecs = recs.filter(r=> r.num===m.num || (r.home===m.home && r.away===m.away));
    html += `<div class="hf-card" style="margin:8px 0;padding:10px 12px;border-left:3px solid ${matchRecs.length?'var(--accent)':'var(--border)'};">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:6px;">
        <span style="font-size:13px;font-weight:600;">${m.num||""} ${m.league||""} ${m.home||""} vs ${m.away||""}</span>
        <span style="font-size:11px;color:var(--sub);">${kickoffShort}${goal?` · 让球${goal}`:""}</span>
      </div>`;
    if(matchRecs.length===0){
      html += `<div style="margin-top:6px;font-size:11.5px;color:var(--sub);">暂无专家推荐</div>`;
    } else {
      matchRecs.forEach(r=>{
        const stats = r.expertStats || {};
        const hitColor = (stats.hitRate||0)>=60 ? "var(--good)" : ((stats.hitRate||0)>=50 ? "var(--warn)" : "var(--bad)");
        html += `<div style="margin-top:8px;padding:8px;background:var(--panel2);border-radius:8px;">
          <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <span style="font-size:14px;font-weight:700;color:var(--accent);">${r.recommend||""}</span>
            ${r.scorePred ? `<span style="font-size:12px;color:var(--sub);">比分 ${r.scorePred}</span>` : ""}
            <span style="font-size:12px;color:var(--sub);">赔率 <b style="color:var(--text);">${r.odds||"-"}</b></span>
            <span style="font-size:12px;color:var(--sub);">信心 <b style="color:var(--good);">${r.confidence||"-"}%</b></span>
          </div>
          <div style="margin-top:5px;font-size:11.5px;color:var(--sub);display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
            <span>👤 <b style="color:var(--text);">${r.expertName||""}</b></span>
            ${(stats.judged||0)>0 ? `<span style="font-size:10px;padding:1px 7px;border-radius:9px;background:${hitColor};color:#fff;">命中率${stats.hitRate||0}%(${stats.judged}场)</span>` : '<span style="font-size:10px;padding:1px 7px;border-radius:9px;background:var(--panel);color:var(--sub);">新专家</span>'}
            <a href="javascript:void(0)" onclick="openExpertArticle('${r.sourceUrl||'#'}','92玩球')" style="color:var(--accent);text-decoration:underline;">原文</a>
          </div>
          ${r.reason ? `<div style="margin-top:5px;font-size:11px;color:var(--sub);line-height:1.5;">📝 ${r.reason}</div>` : ""}
          ${r.otherExperts && r.otherExperts.length>0 ? `<div style="margin-top:5px;font-size:11px;border-top:1px solid var(--border);padding-top:4px;">
            ${r.otherExperts.map(o=>`<div style="margin:3px 0;">
              <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
                <span style="color:var(--text);">${o.expertName||""}</span>
                <span style="color:var(--accent);font-weight:600;">${o.recommend||""}</span>
                ${o.scorePred ? `<span style="color:var(--sub);">${o.scorePred}</span>` : ""}
                ${o.sourceUrl ? `<a href="javascript:void(0)" onclick="openExpertArticle('${o.sourceUrl}','92玩球')" style="color:var(--accent);text-decoration:underline;font-size:10px;">原文</a>` : ""}
              </div>
              ${o.reason ? `<div style="margin-top:2px;color:var(--sub);line-height:1.5;">📝 ${o.reason}</div>` : ""}
            </div>`).join('')}
          </div>` : ""}
        </div>`;
      });
    }
    html += `</div>`;
  });
  if(list) list.innerHTML = html;
}

/* 高手推荐原文查看（覆盖层+返回键） */
function openExpertArticle(url, source){
  if(!url || url === '#') return;
  const overlay = document.getElementById('expertArticleOverlay');
  const frame = document.getElementById('expertArticleFrame');
  const title = document.getElementById('expertArticleTitle');
  const newTab = document.getElementById('expertArticleNewTab');
  if(overlay){ overlay.style.display = 'flex'; }
  if(frame){ frame.src = url; }
  if(title){ title.textContent = (source || '92玩球') + ' 原文'; }
  if(newTab){ newTab.href = url; }
  document.body.style.overflow = 'hidden';
}
function closeExpertArticle(){
  const overlay = document.getElementById('expertArticleOverlay');
  const frame = document.getElementById('expertArticleFrame');
  if(overlay){ overlay.style.display = 'none'; }
  if(frame){ frame.src = ''; }
  document.body.style.overflow = '';
}

/* ============ 半全场胜平负推荐渲染 ============ */
function renderHalfFull(){
  const hf = state.halfFull || {};
  const hfh = state.halfFullHistory || {};
  const summary = $("#hfSummary");
  const list = $("#hfList");
  const bdg = $("#hfBdg");
  const matches = hf.matches || [];

  if(bdg) bdg.textContent = matches.length;
  if(summary) summary.innerHTML = `共 ${matches.length} 场半全场推荐 · 数据更新于 ${hf.generatedAt||"-"} · 算法：全场概率+半场泊松分布+强弱条件概率矩阵`;

  if(!matches.length){
    if(list) list.innerHTML = `<div class="empty">当前暂无半全场推荐数据</div>`;
    return;
  }

  let html = "";
  matches.forEach((m,idx)=>{
    const conf = m.confidence || 0;
    const confColor = conf >= 35 ? "var(--good)" : conf >= 25 ? "var(--accent)" : "var(--warn)";
    const probDist = m.probDist || {};
    const reasons = m.reasons || [];
    const fullProb = m.fullProb || {};
    const halfProb = m.halfProb || {};
    const expGoals = m.expGoals || {};

    // 9种结果概率条
    let probBars = "";
    const allLabels = ["胜胜","胜平","胜负","平胜","平平","平负","负胜","负平","负负"];
    allLabels.forEach(label=>{
      const p = probDist[label] || 0;
      const isRec = label === m.recommend;
      const isRec2 = label === m.recommend2;
      const barColor = isRec ? "var(--good)" : isRec2 ? "var(--accent)" : "var(--sub)";
      probBars += `<div style="display:flex;align-items:center;gap:4px;margin:2px 0;max-width:100%;">
        <span style="width:28px;flex-shrink:0;font-size:10px;color:${isRec?'var(--good)':isRec2?'var(--accent)':'var(--sub)'};font-weight:${isRec?'700':'400'}">${label}</span>
        <div style="flex:1;min-width:0;height:14px;background:var(--bg);border-radius:3px;overflow:hidden;">
          <div style="width:${Math.min(p*2,100)}%;height:100%;background:${barColor};opacity:${isRec?1:0.5};"></div>
        </div>
        <span style="width:34px;flex-shrink:0;text-align:right;font-size:10px;color:${isRec?'var(--good)':'var(--sub)'};font-weight:${isRec?'700':'400'}">${p.toFixed(1)}%</span>
      </div>`;
    });

    html += `<div class="ho-card" style="border-left:3px solid ${confColor};margin-bottom:12px;">
      <div class="ho-head">
        <span class="ho-type" style="color:${confColor}">${m.num||""} ${m.league||""}</span>
        <span class="ho-total" style="color:${confColor}">${m.recommend||""} <small>${conf}%</small></span>
      </div>
      <div style="display:flex;justify-content:space-between;align-items:center;margin:8px 0;flex-wrap:wrap;gap:4px;max-width:100%;">
        <span style="font-size:14px;font-weight:700;word-break:break-all;">${m.home||""} <span style="color:var(--sub);font-weight:400;font-size:11px;">vs</span> ${m.away||""}</span>
        <span style="font-size:11px;color:var(--sub);white-space:nowrap;">${m.kickoff||""}</span>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0;max-width:100%;">
        <div style="flex:1;min-width:75px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;box-sizing:border-box;">
          <div style="font-size:20px;font-weight:700;color:var(--good)">${m.recommend||""}</div>
          <div style="font-size:11px;color:var(--sub)">主推 · 信心${conf}%</div>
        </div>
        ${m.recommend2 ? `<div style="flex:1;min-width:75px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;box-sizing:border-box;">
          <div style="font-size:20px;font-weight:700;color:var(--accent)">${m.recommend2||""}</div>
          <div style="font-size:11px;color:var(--sub)">次推 · 信心${m.confidence2||0}%</div>
        </div>` : ""}
        <div style="flex:1;min-width:75px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;box-sizing:border-box;">
          <div style="font-size:16px;font-weight:700;">${expGoals.homeHalf||0}-${expGoals.awayHalf||0}</div>
          <div style="font-size:11px;color:var(--sub)">半场预期进球</div>
        </div>
      </div>
      <div style="margin:8px 0;padding:8px;background:var(--bg);border-radius:8px;box-sizing:border-box;max-width:100%;overflow:hidden;">
        <div style="font-size:11px;color:var(--sub);margin-bottom:4px;">9种组合概率分布（绿=主推，蓝=次推）</div>
        ${probBars}
      </div>
      <div style="margin-top:8px;font-size:11px;color:var(--sub);">
        <span style="color:var(--text);font-weight:600;">推荐依据：</span>
        ${reasons.map(r=>`<span style="display:inline-block;margin-right:8px;">• ${r}</span>`).join("")}
      </div>
      <div style="margin-top:4px;font-size:10px;color:var(--weak);">
        全场概率：主${fullProb.h||0}% 平${fullProb.d||0}% 客${fullProb.a||0}% · 
        半场概率：主${halfProb.h||0}% 平${halfProb.d||0}% 客${halfProb.a||0}% · 
        数据质量${m.dataQuality||0}%
      </div>
    </div>`;
  });

  if(list) list.innerHTML = html;
}

/* 半全场历史战绩渲染 */
function renderHFHistory(filterDate){
  const hfh = state.halfFullHistory || {};
  const list = $("#hfHistoryList");
  const dateBar = $("#hfDateBar");
  if(!list) return;

  const dates = Object.keys(hfh).sort().reverse();
  if(!dates.length){
    list.innerHTML = `<div class="empty">暂无半全场历史记录</div>`;
    return;
  }

  // 日期选择栏
  if(dateBar){
    dateBar.innerHTML = dates.map(d=>{
      const dayData = hfh[d] || {};
      const recs = dayData.matches || [];
      const hit = recs.filter(r=>r.hit===true).length;
      const miss = recs.filter(r=>r.hit===false).length;
      const pending = recs.filter(r=>r.hit===null).length;
      const active = (!filterDate && d===dates[0]) || filterDate===d;
      return `<button class="hf-date-btn" data-date="${d}" style="padding:6px 12px;border-radius:6px;border:1px solid ${active?'var(--accent)':'var(--border)'};background:${active?'var(--accent-dim)':'transparent'};color:${active?'var(--accent)':'var(--sub)'};font-size:11px;cursor:pointer;margin:2px;">
        ${d.slice(5)} <span style="font-size:9px;">${hit}✓${miss}✗${pending}?</span>
      </button>`;
    }).join("");
    dateBar.querySelectorAll(".hf-date-btn").forEach(btn=>{
      btn.addEventListener("click", ()=>renderHFHistory(btn.dataset.date));
    });
  }

  const targetDate = filterDate || dates[0];
  const dayData = hfh[targetDate] || {};
  const recs = dayData.matches || [];

  if(!recs.length){
    list.innerHTML = `<div class="empty">${targetDate} 暂无记录</div>`;
    return;
  }

  let html = `<div style="margin:8px 0;font-size:12px;color:var(--sub);">${targetDate} 共 ${recs.length} 场推荐</div>`;
  recs.forEach(r=>{
    const hitColor = r.hit===true?"var(--good)":r.hit===false?"var(--bad)":"var(--warn)";
    const hitText = r.hit===true?"✅命中":r.hit===false?"❌未中":"⏳待赛";
    const actualText = r.actualHalfFull ? `实际：${r.actualHalfFull}` : "半场比分待获取";
    const fullScore = r.fullScore || {};
    const scoreText = fullScore.home!==undefined ? `全场 ${fullScore.home}:${fullScore.away}` : "";

    html += `<div style="padding:10px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
      <div>
        <span style="font-size:12px;font-weight:600;">${r.num||""}</span>
        <span style="font-size:12px;color:var(--text);margin-left:6px;">${r.home||""} vs ${r.away||""}</span>
        <div style="font-size:11px;color:var(--sub);margin-top:2px;">
          推荐：<b style="color:var(--accent)">${r.recommend||""}</b>（信心${r.confidence||0}%）
          ${r.recommend2 ? ` / 次推${r.recommend2}（${r.confidence2||0}%）` : ""}
        </div>
        <div style="font-size:10.5px;color:var(--weak);margin-top:2px;">${actualText} ${scoreText}</div>
      </div>
      <span style="font-size:13px;font-weight:700;color:${hitColor}">${hitText}</span>
    </div>`;
  });

  list.innerHTML = html;
}

