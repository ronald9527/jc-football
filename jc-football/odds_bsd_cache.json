<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0b0f14">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<link rel="manifest" href='data:application/manifest+json,%7B%22name%22%3A%22%E7%AB%9E%E5%BD%A9%E8%B6%B3%E7%90%83%E6%95%B0%E6%8D%AE%E5%88%86%E6%9E%90%E5%8F%B0%22%2C%22short_name%22%3A%22%E7%AB%9E%E5%BD%A9%E5%88%86%E6%9E%90%22%2C%22display%22%3A%22standalone%22%2C%22orientation%22%3A%22portrait%22%2C%22background_color%22%3A%22%230b0f14%22%2C%22theme_color%22%3A%22%23ffd54d%22%2C%22start_url%22%3A%22.%22%2C%22icons%22%3A%5B%7B%22src%22%3A%22data%3Aimage%2Fsvg%2Bxml%2C%253Csvg%2520xmlns%3D%2527http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%2527%2520viewBox%3D%25270%25200%2520100%2520100%2527%253E%253Crect%2520width%3D%2527100%2527%2520height%3D%2527100%2527%2520rx%3D%252722%2527%2520fill%3D%2527%25230b0f14%2527%2F%253E%253Ccircle%2520cx%3D%252750%2527%2520cy%3D%252750%2527%2520r%3D%252730%2527%2520fill%3D%2527%2523fff%2527%2F%253E%253Cpath%2520d%3D%2527M50%252020l10%252030h30l-24%252018%25209%252030-25-18-25%252018%25209-30-24-18h30z%2527%2520fill%3D%2527%2523ffd54d%2527%2F%253E%253C%2Fsvg%253E%22%2C%22sizes%22%3A%22any%22%2C%22type%22%3A%22image%2Fsvg%2Bxml%22%7D%5D%7D'>
<title>竞彩智析 · 足球数据中枢</title>
<style>
/* ============ 主题变量 ============ */
:root{
  --bg:#0b0f14; --panel:#11161d; --panel2:#151c26; --panel3:#0e141c;
  --line:#1f2933; --line2:#26323f;
  --text:#e6edf3; --sub:#96a3b0; --weak:#5f6b78;
  --accent:#4da3ff; --accent-dim:rgba(77,163,255,.12);
  --good:#3fb950; --good-bg:rgba(63,185,80,.12);
  --bad:#f85149; --bad-bg:rgba(248,81,73,.12);
  --warn:#d29922; --warn-bg:rgba(210,153,34,.14);
  --cold:#a371f7; --cold-bg:rgba(163,113,247,.14);
  --header-h:56px;
}
/* 不同 tab 强调色区分：今日=蓝（默认），历史=绿，北单=橙 */
:root[data-active-tab="history"]{
  --accent:#3fb950; --accent-dim:rgba(63,185,80,.14);
}
:root[data-active-tab="bd"]{
  --accent:#f0883e; --accent-dim:rgba(240,136,62,.14);
}
[data-theme="light"][data-active-tab="history"]{
  --accent:#1a7f37; --accent-dim:rgba(26,127,55,.09);
}
[data-theme="light"][data-active-tab="bd"]{
  --accent:#bc4c00; --accent-dim:rgba(188,76,0,.08);
}
[data-theme="light"]{
  --bg:#eef1f5; --panel:#ffffff; --panel2:#f6f8fa; --panel3:#eef1f5;
  --line:#d8dee6; --line2:#c6cfd9;
  --text:#1b232c; --sub:#57636f; --weak:#8b97a4;
  --accent:#1f6feb; --accent-dim:rgba(31,111,235,.08);
  --good:#1a7f37; --good-bg:rgba(26,127,55,.09);
  --bad:#cf222e; --bad-bg:rgba(207,34,46,.08);
  --warn:#9a6700; --warn-bg:rgba(154,103,0,.1);
  --cold:#8250df; --cold-bg:rgba(130,80,223,.09);
}
/* 暗夜黑：纯黑背景，高对比 */
[data-theme="black"]{
  --bg:#000000; --panel:#0a0a0a; --panel2:#111111; --panel3:#080808;
  --line:#1f1f1f; --line2:#2a2a2a;
  --text:#f0f0f0; --sub:#999999; --weak:#666666;
  --accent:#00d4ff; --accent-dim:rgba(0,212,255,.1);
  --good:#00ff88; --good-bg:rgba(0,255,136,.1);
  --bad:#ff4444; --bad-bg:rgba(255,68,68,.1);
  --warn:#ffcc00; --warn-bg:rgba(255,204,0,.1);
  --cold:#cc88ff; --cold-bg:rgba(204,136,255,.1);
}
/* 护眼绿：墨绿背景，柔和护眼 */
[data-theme="green"]{
  --bg:#0d1f17; --panel:#132a1f; --panel2:#173326; --panel3:#0f2619;
  --line:#1f3d2e; --line2:#2a4d3a;
  --text:#d4e8dc; --sub:#8ab09a; --weak:#5f8573;
  --accent:#4ade80; --accent-dim:rgba(74,222,128,.1);
  --good:#4ade80; --good-bg:rgba(74,222,128,.1);
  --bad:#f87171; --bad-bg:rgba(248,113,113,.1);
  --warn:#fbbf24; --warn-bg:rgba(251,191,36,.1);
  --cold:#c084fc; --cold-bg:rgba(192,132,252,.1);
}
/* 赛博朋克：紫蓝霓虹，高饱和 */
[data-theme="cyber"]{
  --bg:#0a0a1a; --panel:#12122a; --panel2:#1a1a3a; --panel3:#0e0e22;
  --line:#2a2a5a; --line2:#3a3a7a;
  --text:#e0e0ff; --sub:#9090cc; --weak:#606099;
  --accent:#ff00ff; --accent-dim:rgba(255,0,255,.12);
  --good:#00ffff; --good-bg:rgba(0,255,255,.1);
  --bad:#ff3366; --bad-bg:rgba(255,51,102,.1);
  --warn:#ffff00; --warn-bg:rgba(255,255,0,.1);
  --cold:#ff9900; --cold-bg:rgba(255,153,0,.1);
}
/* 暖橙：暖色背景，温馨舒适 */
[data-theme="warm"]{
  --bg:#1a1208; --panel:#241a0e; --panel2:#2e2214; --panel3:#1f160a;
  --line:#3d2e1a; --line2:#4d3a22;
  --text:#f0e0c8; --sub:#b09878; --weak:#806850;
  --accent:#ff8c42; --accent-dim:rgba(255,140,66,.12);
  --good:#6bcb77; --good-bg:rgba(107,203,119,.1);
  --bad:#ff6b6b; --bad-bg:rgba(255,107,107,.1);
  --warn:#ffd93d; --warn-bg:rgba(255,217,61,.1);
  --cold:#c490e4; --cold-bg:rgba(196,144,228,.1);
}
/* ============ 基础 ============ */
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%}
body{
  background:var(--bg); color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  font-size:14px; line-height:1.5; min-height:100vh;
  transition:background .25s,color .25s;
}
.num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}
svg.ico{width:15px;height:15px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
button:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
/* ============ 顶栏 ============ */
header{
  position:sticky;top:0;z-index:50;backdrop-filter:blur(8px);
  background:color-mix(in srgb,var(--bg) 86%,transparent);
  border-bottom:1px solid var(--line);
}
.hdr-in{max-width:1500px;margin:0 auto;padding:0 16px;height:var(--header-h);display:flex;align-items:center;gap:16px}
.brand{display:flex;align-items:center;gap:10px;min-width:0}
.brand .logo{
  width:30px;height:30px;border-radius:8px;flex:none;
  background:linear-gradient(135deg,#2b7de9,#4da3ff);
  display:flex;align-items:center;justify-content:center;color:#fff;
}
.brand h1{font-size:16px;font-weight:700;letter-spacing:.2px;white-space:nowrap}
.brand .sub{font-size:11px;color:var(--weak);white-space:nowrap}
.brand .ver-tag{display:inline-block;font-size:10px;font-weight:600;color:var(--accent);background:var(--accent-bg);border:1px solid var(--accent);padding:1px 7px;border-radius:999px;margin-left:8px;vertical-align:middle;letter-spacing:0.3px}
.stats{display:flex;gap:6px;margin-left:auto;flex-wrap:wrap}
.stat{
  display:flex;flex-direction:column;align-items:center;padding:5px 12px;
  background:var(--panel);border:1px solid var(--line);border-radius:8px;min-width:62px;
}
.stat b{font-size:16px;line-height:1.2}
.stat span{font-size:10px;color:var(--sub);margin-top:1px}
.stat.good b{color:var(--good)} .stat.bad b{color:var(--bad)} .stat.warn b{color:var(--warn)} .stat.cold b{color:var(--cold)}
.hdr-actions{display:flex;align-items:center;gap:6px}
.hbtn{
  display:flex;align-items:center;gap:6px;padding:7px 11px;border-radius:8px;
  border:1px solid var(--line2);background:var(--panel);color:var(--sub);
  font-size:12px;white-space:nowrap;transition:all .15s;
}
.hbtn:hover{color:var(--text);border-color:var(--accent)}
.hbtn.on{color:var(--accent);border-color:var(--accent);background:var(--accent-dim)}
/* ============ 主区 ============ */
main{max-width:1500px;margin:0 auto;padding:14px 16px 40px}
.toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:14px}
.toolbar .label{font-size:12px;color:var(--weak);margin-right:2px}
.chips{display:flex;gap:6px;flex-wrap:wrap}
.date-filter{display:flex;gap:4px;align-items:center}
.date-filter select{background:var(--panel);border:1px solid var(--line);color:var(--text);font-size:12px;padding:5px 6px;border-radius:6px;cursor:pointer;min-height:32px}
.chip{
  padding:5px 13px;border-radius:999px;font-size:12px;
  border:1px solid var(--line2);background:var(--panel);color:var(--sub);transition:all .15s;
}
.chip:hover{color:var(--text);border-color:var(--accent)}
.chip.on{color:var(--accent);border-color:var(--accent);background:var(--accent-dim);font-weight:600}
.chip .bdg{font-size:9.5px;background:var(--accent-dim);color:var(--accent);border-radius:999px;padding:0 5px;margin-left:4px;font-weight:700}
.seg{display:flex;border:1px solid var(--line2);border-radius:8px;overflow:hidden;margin-left:auto}
.seg button{padding:6px 14px;font-size:12px;color:var(--sub);background:var(--panel)}
.seg button+button{border-left:1px solid var(--line2)}
.seg button.on{color:var(--accent);background:var(--accent-dim);font-weight:600}
.upd{font-size:11px;color:var(--weak);margin-left:auto}
/* 日期分组 */
.day-group{margin-bottom:20px}
.day-head{
  display:flex;align-items:center;gap:10px;margin:4px 2px 10px;
  font-size:13px;font-weight:700;color:var(--sub);
}
.day-head .bar{width:4px;height:16px;border-radius:2px;background:var(--accent)}
.day-head .cnt{font-size:11px;color:var(--weak);font-weight:400;margin-left:auto}
/* ============ 赛事卡片 ============ */
.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(760px,1fr));gap:14px}
@media (max-width:900px){.cards{grid-template-columns:1fr}}
.match{
  background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow:hidden;
}
.match.bordered{border-color:var(--accent)}
.m-head{
  display:flex;align-items:center;gap:10px;padding:10px 14px;
  background:var(--panel2);border-bottom:1px solid var(--line);flex-wrap:wrap;
}
.m-num{font-size:11px;font-weight:700;color:var(--accent);background:var(--accent-dim);padding:3px 8px;border-radius:5px;white-space:nowrap}
.league-tag{font-size:11px;color:var(--sub);white-space:nowrap}
.m-time{font-size:12px;color:var(--sub);white-space:nowrap}
.m-vs{font-weight:700;font-size:14px;display:flex;align-items:center;gap:6px;min-width:0;flex-wrap:wrap}
.m-vs .rank{font-size:10px;color:var(--weak);font-weight:400}
.m-vs .vs-sep{color:var(--weak);font-weight:400}
.goal{
  font-size:11px;font-weight:700;color:var(--warn);
  border:1px solid var(--warn);border-radius:6px;padding:2px 8px;white-space:nowrap;
}
.m-right{margin-left:auto;display:flex;align-items:center;gap:8px}
.rrate{font-size:11px;color:var(--weak);white-space:nowrap}
.stage{font-size:10px;padding:2px 7px;border-radius:4px;background:var(--line);color:var(--sub)}
/* 结论带 */
.verdict{
  display:flex;align-items:flex-start;gap:8px;padding:8px 14px;font-size:12.5px;
  border-bottom:1px solid var(--line);flex-wrap:wrap;
}
.verdict .v-tag{flex:none;font-size:11px;font-weight:700;padding:3px 9px;border-radius:5px;margin-top:1px}
.verdict .v-text{flex:1;min-width:200px}
.verdict.good{background:var(--good-bg);color:var(--good)}
.verdict.good .v-tag{background:var(--good);color:#fff}
.verdict.bad{background:var(--bad-bg);color:var(--bad)}
.verdict.bad .v-tag{background:var(--bad);color:#fff}
.verdict.warn{background:var(--warn-bg);color:var(--warn)}
.verdict.warn .v-tag{background:var(--warn);color:#fff}
.verdict.cold{background:var(--cold-bg);color:var(--cold)}
.verdict.cold .v-tag{background:var(--cold);color:#fff}
.hit-line{
  display:flex;align-items:center;gap:8px;padding:6px 14px;font-size:11.5px;color:var(--sub);
  border-bottom:1px solid var(--line);flex-wrap:wrap;background:var(--panel3);
}
.hit-line .hk{color:var(--warn);font-weight:700}
/* 三向表 */
.tbl-wrap{padding:10px 14px 4px;overflow-x:auto}
.tbl-head,.tbl-row{
  display:grid;grid-template-columns:58px 74px 1.2fr 1.2fr 74px 76px;
  gap:10px;align-items:center;min-width:640px;
}
.tbl-head{font-size:10.5px;color:var(--weak);padding:0 0 6px;border-bottom:1px solid var(--line)}
.tbl-head span{white-space:nowrap}
.tbl-row{padding:7px 0;border-bottom:1px dashed var(--line);font-size:12.5px}
.tbl-row:last-child{border-bottom:none}
.tbl-row .d-name{font-weight:700;display:flex;align-items:center;gap:6px;white-space:nowrap}
.tbl-row .d-name .side{width:3px;height:16px;border-radius:2px;flex:none}
.side.h{background:var(--accent)} .side.d{background:var(--warn)} .side.a{background:var(--cold)}
.tbl-row .odds{font-weight:800;font-size:13.5px;white-space:nowrap}
.bar-cell{display:flex;align-items:center;gap:8px;min-width:0}
.bar-cell .lbl{font-size:11px;color:var(--sub);width:30px;flex:none;text-align:right}
.bar{flex:1;height:7px;border-radius:4px;background:var(--line);overflow:hidden;min-width:40px;position:relative}
.bar i{display:block;height:100%;border-radius:4px}
.bar.p i{background:var(--accent)}
.bar.s i{background:var(--warn)}
.diff{font-weight:700;white-space:nowrap;font-size:12px}
.diff.pos{color:var(--bad)} .diff.neg{color:var(--good)} .diff.zero{color:var(--sub)}
.votes{color:var(--sub);white-space:nowrap;text-align:right}
/* 让球行 */
.hhad-row{
  display:flex;align-items:center;gap:14px;padding:8px 14px;flex-wrap:wrap;
  background:var(--panel3);border-top:1px solid var(--line);
  font-size:12px;
}
.hhad-row .gl{font-weight:800;color:var(--warn);font-size:12.5px}
.hhad-item{display:flex;align-items:center;gap:6px}
.hhad-item .hname{color:var(--sub);font-size:11px}
.hhad-item b{font-size:13px}
.m-foot{display:flex;align-items:center;gap:10px;padding:8px 14px;font-size:11.5px;color:var(--weak);border-top:1px solid var(--line);flex-wrap:wrap}
.m-foot .cond{flex:1;min-width:220px;color:var(--sub)}
.m-foot .cond b{color:var(--warn)}
/* ============ BSD深度数据 ============ */
.bsd-sec{margin:0;padding:0;border-top:1px solid var(--line)}
.bsd-toggle{display:flex;align-items:center;gap:8px;padding:8px 14px;cursor:pointer;background:var(--panel2);font-size:11.5px;user-select:none;transition:background .15s}
.bsd-toggle:hover{background:var(--panel3)}
.bsd-icon{font-size:13px}
.bsd-title{font-weight:700;color:var(--accent)}
.bsd-tags{flex:1;color:var(--sub);font-size:10.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bsd-arrow{color:var(--weak);font-size:10px;transition:transform .2s}
.bsd-detail.show + .bsd-toggle .bsd-arrow,
.bsd-toggle:active .bsd-arrow{transform:rotate(180deg)}
.bsd-detail{display:none;padding:10px 14px;background:var(--panel);max-height:600px;overflow-y:auto}
.bsd-detail.show{display:block}
.bsd-block{margin-bottom:12px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.bsd-block:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none}
.bsd-block-title{font-size:11px;font-weight:700;color:var(--accent);margin-bottom:6px}
.bsd-injuries{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.inj-col b{font-size:11px;color:var(--text);display:block;margin-bottom:4px}
.inj-empty{font-size:10.5px;color:var(--good);padding:2px 0}
.inj-item{display:flex;align-items:center;gap:4px;flex-wrap:wrap;padding:2px 0;font-size:10.5px}
.inj-name{color:var(--text);font-weight:500}
.inj-status{display:inline-block;padding:0 4px;border-radius:3px;font-size:9px;font-weight:700}
.inj-status.injured{background:rgba(234,102,104,.15);color:#ea6668}
.inj-status.suspended{background:rgba(250,173,20,.15);color:#faad14}
.inj-reason{color:var(--sub);font-size:10px}
.inj-return{color:var(--good);font-size:9.5px}
.bsd-lineups{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.lu-col b{font-size:11px;color:var(--text);display:block;margin-bottom:4px}
.lu-players{display:flex;flex-wrap:wrap;gap:3px}
.lu-player{display:inline-block;padding:2px 6px;background:var(--panel2);border-radius:4px;font-size:10px;color:var(--sub)}
.bsd-coaches{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.coach-item{display:flex;flex-direction:column;gap:2px;font-size:10.5px}
.coach-item b{color:var(--text);font-size:11px}
.coach-item span{color:var(--sub)}
.bsd-referee{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font-size:10.5px}
.bsd-referee b{color:var(--text)}
.bsd-referee span{color:var(--sub)}
.bsd-ai{font-size:11px;color:var(--text);line-height:1.7;background:var(--panel2);padding:8px 10px;border-radius:8px;max-height:300px;overflow-y:auto}
.bsd-ai b{color:var(--accent)}
.bsd-funfacts{font-size:10.5px;color:var(--sub);line-height:1.8}
.funfact{padding:1px 0}
@media(max-width:768px){
  .bsd-injuries,.bsd-lineups,.bsd-coaches{grid-template-columns:1fr}
  .bsd-toggle{padding:8px 10px;font-size:11px}
  .bsd-detail{padding:8px 10px}
}
/* ============ 表格视图 ============ */
.tview{display:none;background:var(--panel);border:1px solid var(--line);border-radius:12px;overflow-x:auto}
.tview.show{display:block}
table{width:100%;border-collapse:collapse;min-width:1080px;font-size:12px}
th,td{padding:8px 10px;border-bottom:1px solid var(--line);white-space:nowrap;text-align:right}
th{font-size:10.5px;color:var(--weak);background:var(--panel2);position:sticky;top:var(--header-h);z-index:5;font-weight:600}
td:first-child,th:first-child{text-align:left;position:sticky;left:0;background:var(--panel);z-index:6;font-weight:600}
th:first-child{background:var(--panel2);z-index:7}
tr:last-child td{border-bottom:none}
tbody tr:hover td{background:var(--accent-dim)}
td .mini{display:flex;align-items:center;gap:5px;justify-content:flex-end}
.mini .bar{width:44px;min-width:44px}
/* ============ 弹窗 ============ */
.modal-mask{
  position:fixed;inset:0;background:rgba(5,8,12,.65);z-index:100;
  display:none;align-items:center;justify-content:center;padding:16px;
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
}
#loginMask{z-index:99999;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);background:rgba(5,8,12,.75)}
.modal-mask.show{display:flex}
.modal{
  width:min(760px,100%);max-height:86vh;overflow:auto;background:var(--panel);
  border:1px solid var(--line2);border-radius:14px;padding:18px;
}
.modal h3{font-size:15px;margin-bottom:4px}
.modal .tip{font-size:12px;color:var(--sub);margin-bottom:12px}
.modal textarea{
  width:100%;height:280px;background:var(--panel3);color:var(--text);
  border:1px solid var(--line2);border-radius:8px;padding:10px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:12px;resize:vertical;
}
.modal .m-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap}
.btn{padding:8px 16px;border-radius:8px;font-size:13px;font-weight:600;background:var(--accent);color:#fff;transition:opacity .15s}
.btn:hover{opacity:.88}
.btn.ghost{background:var(--panel);color:var(--sub);border:1px solid var(--line2)}
.btn.ghost:hover{color:var(--text);border-color:var(--accent)}
.import-status{margin-top:10px;font-size:12px}
/* ============ 赔率对照弹窗 ============ */
.oc-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:12px;overflow:hidden}
.odds-view{padding:4px 0}
.odds-view .fb-title{margin-bottom:8px}
.oc-head{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--panel2);font-size:11.5px;flex-wrap:wrap}
.oc-num{font-weight:700;color:var(--accent);background:var(--accent-dim);padding:1px 6px;border-radius:4px}
.oc-league{color:var(--sub)}
.oc-teams{font-weight:600;color:var(--text);flex:1;min-width:120px}
.oc-kick{color:var(--weak);font-size:10.5px}
.oc-agree{font-weight:700;font-size:11px}
.oc-asian{color:#7fd8c8;font-size:10.5px;background:rgba(127,216,200,.1);padding:1px 6px;border-radius:4px}
.oc-type{font-size:10.5px;font-weight:700;padding:2px 8px;border-radius:999px}
.oc-goal{font-size:10.5px;font-weight:700;padding:1px 6px;border-radius:4px;background:var(--panel3)}
.oc-table{display:flex;flex-direction:column}
.oc-table.oc-wide{overflow-x:auto;-webkit-overflow-scrolling:touch}
.oc-table.oc-wide .oc-row{grid-template-columns:70px 80px 80px 100px 80px 80px 80px 80px 90px;min-width:760px}
.oc-row{display:grid;grid-template-columns:0.8fr 1fr 1fr 0.8fr 1fr 1fr 1fr;gap:0;padding:6px 12px;font-size:11px;border-bottom:1px solid var(--line)}
.oc-row:last-child{border-bottom:none}
.oc-header{background:var(--panel3);font-weight:700;color:var(--sub);font-size:10.5px}
.oc-col{text-align:center;padding:2px 4px}
.oc-dir{text-align:left;font-weight:600;color:var(--text)}
.oc-hhad{padding:8px 12px;font-size:11px;color:var(--sub);background:var(--panel2);border-top:1px solid var(--line)}
.oc-hhad b{color:var(--accent)}
/* ============ 港澳赔率 ============ */
.hkmo-btn{position:relative}
.hkmo-tab-badge{position:relative;top:-1px;margin-left:4px;min-width:16px;height:16px;padding:0 4px;background:var(--bad);color:#fff;font-size:10px;font-weight:700;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;animation:hkmoPulse 1.5s ease-in-out infinite}
@keyframes hkmoPulse{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(234,102,104,.5)}50%{transform:scale(1.1);box-shadow:0 0 0 6px rgba(234,102,104,0)}}
.hkmo-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;margin-bottom:12px;overflow:hidden}
.hkmo-view{padding:12px 0}
.highodds-view{padding:12px 0}
.ho-card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:12px;box-sizing:border-box;overflow:hidden;max-width:100%}
.ho-card .ho-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;gap:6px}
.ho-card .ho-type{font-size:16px;font-weight:700;color:var(--accent)}
.ho-card .ho-total{font-size:20px;font-weight:800;color:var(--good)}
.ho-card .ho-total small{font-size:11px;color:var(--sub);font-weight:400}
.ho-legs{display:flex;flex-direction:column;gap:8px}
.ho-leg{display:grid;grid-template-columns:60px 1fr auto;gap:10px;align-items:center;padding:10px;background:var(--bg);border-radius:8px;border:1px solid var(--line2)}
.ho-leg .ho-num{font-size:11px;color:var(--sub);text-align:center}
.ho-leg .ho-match{font-size:13px;font-weight:600;color:var(--text)}
.ho-leg .ho-match .ho-league{font-size:10px;color:var(--sub);font-weight:400;margin-right:4px}
.ho-leg .ho-pick{font-size:12px;color:var(--accent);margin-top:2px}
.ho-leg .ho-odds{font-size:18px;font-weight:800;color:var(--good);text-align:right}
.ho-leg .ho-odds small{font-size:10px;color:var(--sub);font-weight:400;display:block}
.ho-meta{display:flex;gap:12px;margin-top:10px;font-size:11px;color:var(--sub);flex-wrap:wrap}
.ho-meta span{display:flex;align-items:center;gap:3px}
@media(max-width:480px){
  .ho-leg{grid-template-columns:50px 1fr auto;gap:6px;padding:8px}
  .ho-leg .ho-match{font-size:12px}
  .ho-leg .ho-odds{font-size:16px}
  .ho-card .ho-total{font-size:18px}
  .ho-card{padding:10px}
  .ho-card .ho-type{font-size:14px}
}
.hkmo-card.hkmo-drop{border-color:var(--bad);border-width:2px;box-shadow:0 0 12px rgba(234,102,104,.2)}
.hkmo-head{display:flex;align-items:center;gap:8px;padding:8px 12px;background:var(--panel2);font-size:11.5px;flex-wrap:wrap}
.hkmo-drop-tag{color:var(--bad);font-weight:700;font-size:11px;background:rgba(234,102,104,.1);padding:2px 8px;border-radius:4px}
.hkmo-asian-up{color:var(--accent);font-weight:700;font-size:11px;background:rgba(74,144,226,.12);padding:2px 8px;border-radius:4px;border:1px solid rgba(74,144,226,.3)}
.hkmo-asian-down{color:#fa8c16;font-weight:700;font-size:11px;background:rgba(250,140,22,.1);padding:2px 8px;border-radius:4px;border:1px solid rgba(250,140,22,.3)}
.hkmo-asian-none{color:var(--sub);font-size:11px;background:var(--panel3);padding:2px 8px;border-radius:4px}
.hkmo-srctime{display:flex;gap:16px;font-size:10.5px;color:var(--weak);padding:4px 12px;background:var(--panel3);border-radius:0 0 8px 8px;flex-wrap:wrap}
@media(max-width:768px){.hkmo-srctime{font-size:10px;gap:8px}}
/* 港澳卡片-让球盘推荐区 */
.hkmo-rec-sec{padding:8px 12px;border-top:1px solid var(--line);background:var(--panel2)}
.hkmo-rec-title{font-size:11px;font-weight:700;color:var(--accent);margin-bottom:6px}
.hkmo-rec-row{display:flex;gap:12px;flex-wrap:wrap;align-items:center}
.hkmo-rec-item{flex:1;min-width:140px;background:var(--panel);border:1px solid var(--line);border-radius:6px;padding:6px 10px}
.hkmo-rec-label{font-size:10px;color:var(--weak);margin-bottom:2px}
.hkmo-rec-val{font-size:12.5px;font-weight:700}
/* 国际权威赔率 */
.obsd-sec{padding:8px 12px;border-top:1px solid var(--line);background:linear-gradient(180deg,rgba(74,144,226,.04),transparent)}
.obsd-title{font-size:11px;font-weight:700;color:var(--accent);margin-bottom:6px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.obsd-drop-badge{color:var(--bad);font-size:10px;background:rgba(234,102,104,.12);padding:1px 6px;border-radius:4px;font-weight:700}
.obsd-rise-badge{color:var(--good);font-size:10px;background:rgba(82,196,26,.1);padding:1px 6px;border-radius:4px;font-weight:700}
.obsd-table{display:flex;flex-direction:column;gap:2px}
.obsd-row{display:flex;gap:4px;align-items:center}
.obsd-header{font-size:10px;color:var(--weak);border-bottom:1px solid var(--line);padding-bottom:3px;margin-bottom:2px}
.obsd-dir{flex:0 0 42px;font-size:11px}
.obsd-cell{flex:1;min-width:0;text-align:center;font-size:11px;padding:3px 2px;background:var(--panel);border-radius:4px;border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:1px}
.obsd-book{background:var(--panel2);border:none;font-weight:700;color:var(--sub);font-size:9.5px;padding:2px}
.obsd-cur{font-weight:700;font-size:12px}
