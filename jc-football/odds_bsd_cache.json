/* ---------- 通用日期筛选器 ---------- */
function dateSelectHtml(prefix, selected, years){
  const sy = selected==="all"?"":selected.slice(0,4);
  const sm = selected==="all"?"":selected.slice(5,7);
  const sd = selected==="all"?"":selected.slice(8,10);
  const yOpts = ['<option value="">全部</option>'].concat(years.map(y=>`<option value="${y}"${sy===String(y)?" selected":""}>${y}年</option>`)).join("");
  const mOpts = ['<option value="">月</option>'].concat(Array.from({length:12},(_,i)=>{const m=String(i+1).padStart(2,"0");return `<option value="${m}"${sm===m?" selected":""}>${m}月</option>`})).join("");
  const dOpts = ['<option value="">日</option>'].concat(Array.from({length:31},(_,i)=>{const d=String(i+1).padStart(2,"0");return `<option value="${d}"${sd===d?" selected":""}>${d}日</option>`})).join("");
  return `<div class="date-filter" id="${prefix}DateFilter">
    <select data-p="${prefix}" data-t="y">${yOpts}</select>
    <select data-p="${prefix}" data-t="m">${mOpts}</select>
    <select data-p="${prefix}" data-t="d">${dOpts}</select>
  </div>`;
}
function applyDateFilter(prefix, y, m, d){
  const key = prefix==="hist"?"histDate":prefix==="bd"?"bdHistDate":"parlayDate";
  if(!y && !m && !d){ state[key]="all"; }
  else if(y && m && d){ state[key]=`${y}-${m}-${d}`; }
  else { state[key]="all"; return; }
  if(prefix==="hist"){ renderHistory(); }
  else if(prefix==="bd"){ renderBD(); }
  else { renderHighOdds(); }
}

/* ---------- 规则引擎（竞彩版，与数据管道一致） ---------- */
function diffOf(m, d){
  const p = m.hadProb && m.hadProb[d];
  const s = m.hadSup && m.hadSup[d];
  if (p == null || s == null) return null;
  return +(s - p).toFixed(1);
}
function evaluate(m){
  const hits = [];
  const prob = m.hadProb || {}, sup = m.hadSup || {};
  const goal = (m.hhad && m.hhad.goal) || "";
  const rrate = m.returnRate;

  for (const [d, name] of [["h","主胜"],["d","平局"],["a","客胜"]]){
    const dv = diffOf(m, d);
    if (dv != null && dv >= 15)
      hits.push({g:"组1热度深负", t:"bad", dir:d, label:`${name}支持率${sup[d]}%高于概率${prob[d]}%达${dv}pt，投注过热，该方向危险`, cond:`${name} 支持率-概率=${dv}pt(≥15)`});
  }
  for (const [d, name] of [["h","主胜"],["d","平局"],["a","客胜"]]){
    const dv = diffOf(m, d);
    if (dv != null && dv >= 22)
      hits.push({g:"组6深度过热", t:"bad", dir:d, label:`${name}支持率远超概率${dv}pt，深度过热，机构放任资金涌入`, cond:`${name} 支持率-概率=${dv}pt(≥22)`});
  }
  let hot = "h"; let hotP = -1;
  for (const d of ["h","d","a"]) if ((prob[d]||0) > hotP){ hot = d; hotP = prob[d]||0; }
  if (hotP >= 50){
    const dv = diffOf(m, hot);
    if (dv != null && Math.abs(dv) < 8)
      hits.push({g:"组2正路确认", t:"good", dir:hot, label:`${dname(hot)}概率${hotP}%为热门且支持率偏差仅${dv}pt，方向一致，正路更易打出`, cond:`热门方向概率${hotP}%≥50%，支持率-概率=${dv}pt(<8)`});
  }
  let gv = 0;
  try { gv = parseInt(goal, 10); } catch(e){}
  if (Math.abs(gv) >= 2 && hotP >= 55){
    const dv = diffOf(m, hot);
    if (dv != null && dv <= -10)
      hits.push({g:"组3冷门监控", t:"cold", dir:hot, label:`深盘让球${gv}但${dname(hot)}支持率${sup[hot]}%低于概率${hotP}%达${-dv}pt，小心爆冷`, cond:`让球|${gv}|≥2、热门概率${hotP}%≥55%、支持率-概率=${dv}pt(≤-10)`});
  }
  if (rrate != null && rrate < 87)
    hits.push({g:"组4异常水位", t:"warn", dir:"", label:`胜平负返还率仅${rrate}%，水位异常偏低，谨慎参与`, cond:`返还率${rrate}%<87%`});

  const order = {bad:0, cold:1, good:2, warn:3};
  hits.sort((a,b)=>order[a.t]-order[b.t]);
  const verdict = hits.length ? {t:hits[0].t, txt:hits[0].label} : null;
  return {verdict, hits};
}

/* ---------- 渲染：统计条 ---------- */
function renderStats(){
  const list = state.data;
  const ev = list.map(m=>{ const r = evaluate(m); return {m, r}; });
  const nBad = ev.filter(x=>x.r.verdict && x.r.verdict.t==="bad").length;
  const nGood = ev.filter(x=>x.r.verdict && x.r.verdict.t==="good").length;
  const nCold = ev.filter(x=>x.r.verdict && x.r.verdict.t==="cold").length;
  const nWarn = ev.filter(x=>x.r.verdict && x.r.verdict.t==="warn").length;
  const nHit = ev.filter(x=>x.r.hits.length>0).length;
  const nX = list.filter(m=>m.cross && m.cross.agree).length;
  $("#statBar").innerHTML =
    `<div class="stat"><b class="num">${list.length}</b><span>赛事</span></div>` +
    `<div class="stat"><b class="num">${nHit}</b><span>信号</span></div>` +
    `<div class="stat good"><b class="num">${nGood}</b><span>正路</span></div>` +
    `<div class="stat bad"><b class="num">${nBad}</b><span>危险</span></div>` +
    `<div class="stat cold"><b class="num">${nCold}</b><span>冷门</span></div>` +
    `<div class="stat warn"><b class="num">${nWarn}</b><span>谨慎</span></div>` +
    (nX?`<div class="stat" style="border-color:rgba(82,196,26,.4)"><b class="num" style="color:var(--good)">${nX}</b><span>北单双确认</span></div>`:"");
  updateClock();
}

/* ---------- 今日关注高信心榜 ---------- */
function renderFocus(){
  const list = state.data;
  const ev = list.map(m=>{ const r = evaluate(m); return {m, r}; });
  // 按星级+评分排序，取 Top8 高信心场次
  const ranked = ev
    .map(x=>({m:x.m, r:x.r, sc:(x.m.score||{}).stars||0, pts:(x.m.score||{}).score||0}))
    .filter(x=>x.sc>=2)
    .sort((a,b)=> b.sc-a.sc || b.pts-a.pts)
    .slice(0,8);
  const box = $("#focusBoard");
  if (!ranked.length){ box.style.display="none"; return; }
  box.style.display="block";
  const vname = t => t==="good"?"正路":t==="bad"?"危险":t==="warn"?"谨慎":t==="cold"?"冷门":"—";
  const items = ranked.map(x=>{
    const {m, r} = x;
    const v = r.verdict;
    const dirName = (m.score&&m.score.dir)?({"h":"主胜","d":"平局","a":"客胜"})[m.score.dir]:"";
    const fh = (m.form||{}).home, fa = (m.form||{}).away;
    const formTxt = (fh&&fh.n)||(fa&&fa.n)
      ? `近况 ${fh&&fh.n?`主${fh.wr}%`:"主-"} / ${fa&&fa.n?`客${fa.wr}%`:"客-"}`
      : "";
    const crossTxt = m.cross ? (m.cross.agree?"北单一致":"北单分歧") : "";
    return `<div class="focus-item">
      <div class="fi-vs">${m.num?`<span class="fi-num">${m.num}</span>`:""}${m.home} <span style="color:var(--weak)">vs</span> ${m.away}</div>
      <div class="fi-sub">
        <span class="fi-league">${m.league||""}</span>
        ${(m.hr||m.ar)?`<span class="fi-rank">${m.hr||"—"} vs ${m.ar||"—"}</span>`:""}
        <span class="fi-star">${"★".repeat(x.sc)}</span>
        <span class="fi-dir ${v?v.t:"warn"}">${dirName||"观望"}</span>
        ${formTxt?`<span class="fi-form">${formTxt}</span>`:""}
        ${crossTxt?`<span class="fi-cross ${m.cross.agree?"ok":"diff"}">${crossTxt}</span>`:""}
        <span>${m.kickoff?m.kickoff.slice(5):""}</span>
      </div>
      ${v?`<div class="fi-verdict">${vname(v.t)}：${v.txt}</div>`:""}
    </div>`;
  }).join("");
  box.innerHTML = `<div class="fb-title">今日关注 · 高信心场次
      <span class="tip">按综合星级筛选（≥2★），优先关注高星方向</span></div>
    <div class="focus-items">${items}</div>`;
}

/* ---------- 串关精选保存（16:00后锁定，页面加载时自动保存） ---------- */
function renderFilters(){
  const defs = [["all","全部"],["good","正路"],["bad","危险"],["cold","冷门"],["warn","谨慎"]];
  // 统计各类别场次数
  const cnt = {all: state.data.length, good:0, bad:0, cold:0, warn:0};
  state.data.forEach(m=>{
    const v = evaluate(m).verdict;
    if (v && cnt[v.t]!=null) cnt[v.t]++;
  });
  $("#filterChips").innerHTML = defs.map(([k,v])=>
    `<button class="chip${state.filter===k?" on":""}" data-f="${k}">${v}<span class="bdg">${cnt[k]||0}</span></button>`).join("");
}
function applyFilter(m){
  if (state.filter==="all") return true;
  const v = evaluate(m).verdict;
  if (!v) return false;
  return v.t === state.filter;
}

/* ---------- 渲染：卡片 ---------- */
function diffCls(v){ return v>0.5?"pos":v<-0.5?"neg":"zero"; }
function barCell(label, pct, cls, diffV){
  return `<div class="bar-cell">
    <span class="lbl">${label}</span>
    <div class="bar ${cls}"><i style="width:${Math.min(100,Math.max(2,pct||0))}%"></i></div>
    <span class="num" style="width:34px;text-align:right">${pct==null?"-":pct+"%"}</span>
    ${diffV==null?`<span class="diff zero num" style="width:52px">—</span>`:`<span class="diff ${diffCls(diffV)} num" style="width:52px">${diffV>0?"+":""}${diffV}</span>`}
  </div>`;
}
function cardHtml(m){
  const {verdict, hits} = evaluate(m);
  const vCls = verdict ? verdict.t : "";
  const vTag = verdict ? (verdict.t==="good"?"正路":verdict.t==="bad"?"危险":verdict.t==="warn"?"谨慎":"冷门") : "无";
  const hitStr = hits.map(h=>`[${h.g}] ${h.cond}`).join("；");
  const goal = (m.hhad && m.hhad.goal) || "";
  const rr = m.returnRate;
  const odds = m.had || {};
  const hh = m.hhad || {};
  const sc = m.score || {};
  const stars = sc.stars || 0;
  const starsHtml = `<span class="stars">${"★".repeat(stars)}<i>${"★".repeat(5-stars)}</i></span>`;
  const dirName = sc.dir ? {"h":"主胜","d":"平局","a":"客胜"}[sc.dir] : "";
  const rows = [
    ["主胜","h", odds.h, (m.hadProb||{}).h, (m.hadSup||{}).h],
    ["平局","d", odds.d, (m.hadProb||{}).d, (m.hadSup||{}).d],
    ["客胜","a", odds.a, (m.hadProb||{}).a, (m.hadSup||{}).a]
  ];
  const rowH = rows.map(([name,key,od,p,s])=>{
    const dv = diffOf(m, key);
    const vt = m.votes ? m.votes[key] : null;
    return `<div class="tbl-row">
      <div class="d-name"><span class="side ${key}"></span>${name}</div>
      <div class="odds num">${od==null?"-":od}</div>
      ${barCell("概率", p, "p", null)}
      ${barCell("支持", s, "s", dv)}
      <div class="votes num">${vt==null?"—":fmt(vt)+"票"}</div>
    </div>`;
  }).join("");
  // 赔率变动 + 凯利行
  const mov = sc.mov || {};
  const movCell = d => {
    const pct = mov[d];
    if (pct == null) return `<span class="mvd na">未变价</span>`;
    const cls = pct <= -3 ? "in" : (pct >= 3 ? "out" : "flat");
    const arrow = pct <= -3 ? "↓" : (pct >= 3 ? "↑" : "→");
    return `<span class="mvd ${cls}">${arrow}${Math.abs(pct)}%</span>`;
  };
  const hadOpen = m.hadOpen || {};
  const hadCur = m.had || {};
  const openCurCell = d => {
    const o = hadOpen[d], c = hadCur[d];
    if (o == null || c == null) return `<span class="num">${c!=null?c:"—"}</span>`;
    const diff = (c - o).toFixed(2);
    const cls = c < o ? "in" : (c > o ? "out" : "flat");
    return `<span class="num"><span style="color:var(--weak);font-weight:400">${o}</span>→<b>${c}</b><i class="kdif" style="color:var(--${cls==='in'?'good':cls==='out'?'bad':'sub'})">${diff>0?"+":""}${diff}</i></span>`;
  };
  const kelly = sc.kelly || {};
  const kd = sc.kellyDiff || {};
  const kellyCell = d => {
    if (kelly[d] == null) return `<span class="num">—</span>`;
    const v = kd[d];
    const cls = v != null && v >= 1.5 ? "val" : (v != null && v <= -1.5 ? "trap" : "");
    return `<span class="num ${cls}">${kelly[d].toFixed(3)}<i class="kdif">${v!=null?(v>0?"+":"")+v:""}</i></span>`;
  };
  return `
  <article class="match${verdict?" bordered":""}">
    <div class="m-head">
      <span class="m-num">${m.num||""}</span>
      <span class="league-tag">${m.league||""}</span>
      <span class="m-time num">${m.kickoff? m.kickoff.slice(5): (m.date?m.date.slice(5)+" ":"")+(m.time||"")}</span>
      <div class="m-vs"><span>${m.home}<span class="rank">[${m.hr||""}]</span></span><span class="vs-sep">vs</span><span>${m.away}<span class="rank">[${m.ar||""}]</span></span></div>
      ${goal?`<span class="goal">让球 ${goal}</span>`:""}
      <div class="m-right">
        ${rr!=null?`<span class="rrate num">返还率 ${rr}%</span>`:""}
        <span class="stage">${m.status==="Selling"?"销售中":(m.status||"")}</span>
      </div>
    </div>
    ${verdict?`<div class="verdict ${vCls}">
      <span class="v-tag">${vTag}</span>${starsHtml}
      <span class="v-text">${verdict.txt}</span>
    </div>`:`
    <div class="verdict"><span class="v-tag none">观望</span>${starsHtml}
      <span class="v-text" style="color:var(--sub)">暂无规则命中，保持观望${dirName?`；综合偏向：${dirName}`:""}</span>
    </div>`}
    <div class="hit-line">
      <span>命中：</span>
      ${hits.length?`<span class="hk">${hitStr}</span>`:`<span style="color:var(--weak)">未命中任何规则组</span>`}
    </div>
    <div class="tbl-wrap">
      <div class="tbl-head">
        <span>方向</span><span>固定奖金</span><span>官方概率</span><span>彩民支持率 / 偏差</span><span>投注人数</span>
      </div>
      ${rowH}
    </div>
    <div class="mv-row">
      <span class="gl">初盘→当前</span>
      <span class="mv-item"><span class="hname">主胜</span>${openCurCell("h")}</span>
      <span class="mv-item"><span class="hname">平局</span>${openCurCell("d")}</span>
      <span class="mv-item"><span class="hname">客胜</span>${openCurCell("a")}</span>
      <span style="margin-left:auto;color:var(--weak);font-size:11px">赔率变动%</span>
      <span class="mv-item"><span class="hname">胜</span>${movCell("h")}</span>
      <span class="mv-item"><span class="hname">平</span>${movCell("d")}</span>
      <span class="mv-item"><span class="hname">负</span>${movCell("a")}</span>
      <span style="margin-left:8px;color:var(--weak);font-size:11px">凯利(价值/陷阱)</span>
      <span class="mv-item"><span class="hname">胜</span>${kellyCell("h")}</span>
      <span class="mv-item"><span class="hname">平</span>${kellyCell("d")}</span>
      <span class="mv-item"><span class="hname">负</span>${kellyCell("a")}</span>
    </div>
    <div class="hhad-row">
      <span class="gl">让球胜平负${goal?`（让球 ${goal}）`:""}</span>
      <span class="hhad-item"><span class="hname">胜</span><b class="num">${hh.h==null?"-":hh.h}</b></span>
      <span class="hhad-item"><span class="hname">平</span><b class="num">${hh.d==null?"-":hh.d}</b></span>
      <span class="hhad-item"><span class="hname">负</span><b class="num">${hh.a==null?"-":hh.a}</b></span>
      <span style="margin-left:auto;color:var(--weak);font-size:11px">官方概率 ${(m.hhadProb?Object.values(m.hhadProb).join("/"):"-")} · 支持率 ${(m.hhadSup?Object.values(m.hhadSup).join("/"):"-")}</span>
    </div>
    ${sigRow(m)}
    <div class="m-foot">
      <span class="cond"><b>综合评分</b>：${(sc.reasons&&sc.reasons.length)?sc.reasons.join("；"):"—"}${dirName?`　<b>综合偏向 ${dirName}</b>（${sc.score||0}分）`:""}</span>
    </div>
    ${renderExpertForMatch(m)}
    ${renderBSDDetail(m)}
  </article>`;
}
/* 单场比赛专家推荐 */
function renderExpertForMatch(m){
  const recs = (state.expert && state.expert.recommendations) || [];
  const matchRecs = recs.filter(r=> r.num===m.num || (r.home===m.home && r.away===m.away));
  if(!matchRecs.length) return "";
  let html = `<div style="margin-top:8px;padding:8px 10px;background:var(--panel2);border-radius:8px;border-left:3px solid var(--accent);">
    <div style="font-size:11.5px;font-weight:600;color:var(--text);margin-bottom:4px;">👥 专家推荐（92玩球）</div>`;
  matchRecs.forEach(r=>{
    const stats = r.expertStats || {};
    const hitColor = (stats.hitRate||0)>=60 ? "var(--good)" : ((stats.hitRate||0)>=50 ? "var(--warn)" : "var(--bad)");
    html += `<div style="margin:4px 0;font-size:11.5px;display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
      <span style="color:var(--text);font-weight:600;">${r.expertName||""}</span>
      <span style="color:var(--accent);font-weight:700;">${r.recommend||""}</span>
      ${r.scorePred ? `<span style="color:var(--sub);">比分 ${r.scorePred}</span>` : ""}
      ${(stats.judged||0)>0 ? `<span style="font-size:10px;padding:1px 6px;border-radius:8px;background:${hitColor};color:#fff;">命中率${stats.hitRate||0}%(${stats.judged}场)</span>` : ""}
      <a href="javascript:void(0)" onclick="openExpertArticle('${r.sourceUrl||'#'}','92玩球')" style="color:var(--accent);text-decoration:underline;font-size:10px;">原文</a>
    </div>`;
    if(r.reason) html += `<div style="font-size:10.5px;color:var(--sub);margin:2px 0 4px 0;line-height:1.4;">📝 ${r.reason}</div>`;
    if(r.otherExperts && r.otherExperts.length>0){
      r.otherExperts.forEach(o=>{
        html += `<div style="margin:2px 0;font-size:11px;display:flex;gap:6px;flex-wrap:wrap;align-items:center;">
          <span style="color:var(--sub);">└</span>
          <span style="color:var(--text);">${o.expertName||""}</span>
          <span style="color:var(--accent);">${o.recommend||""}</span>
          ${o.scorePred ? `<span style="color:var(--sub);">${o.scorePred}</span>` : ""}
          ${(o.judged||0)>0 ? `<span style="font-size:10px;color:var(--sub);">${o.hitRate}%</span>` : ""}
        </div>`;
      });
    }
  });
  html += `</div>`;
  return html;
}
function renderCards(){
  const list = state.data.filter(applyFilter);
  if (!list.length){ $("#cardsView").innerHTML = `<div class="empty">当前筛选条件下没有赛事</div>`; return; }
  // 按日期分组
  const groups = {};
  list.forEach(m=>{
    const k = m.date || "未排期";
    (groups[k] = groups[k] || []).push(m);
  });
  const weekMap = {};
  let html = Object.keys(groups).sort().map(date=>{
    const arr = groups[date];
    const w = arr[0].num ? arr[0].num.replace(/\d+$/,"") : "";
    return `<div class="day-group">
      <div class="day-head"><span class="bar"></span><span>${date}（${w}）</span><span class="cnt">${arr.length} 场</span></div>
      <div class="cards">${arr.map(cardHtml).join("")}</div>
    </div>`;
  }).join("");
  $("#cardsView").innerHTML = html;
}

/* ---------- 渲染：表格 ---------- */
function tableHtml(){
  const list = state.data.filter(applyFilter);
  const head = `<table>
  <thead><tr>
    <th>编号/对阵</th><th>联赛</th><th>时间</th><th>让球</th>
    <th>胜</th><th>平</th><th>负</th>
    <th>概率 胜/平/负</th><th>支持率 胜/平/负</th><th>偏差(热)</th><th>返还率</th><th>信心</th><th>结论</th>
  </tr></thead><tbody>`;
  const rows = list.map(m=>{
    const {verdict, hits} = evaluate(m);
    const hot = diffOf(m,"h"); const ddraw = diffOf(m,"d"); const ahot = diffOf(m,"a");
    const maxHot = Math.max(hot||0, ddraw||0, ahot||0);
    const vc = verdict ? (verdict.t==="good"?"var(--good)":verdict.t==="bad"?"var(--bad)":verdict.t==="warn"?"var(--warn)":"var(--cold)") : "var(--weak)";
    const stars = (m.score&&m.score.stars)||0;
    return `<tr>
      <td>${m.num||""} ${m.home}<span style="color:var(--weak)"> vs </span>${m.away}</td>
      <td>${m.league||""}</td><td class="num">${m.kickoff?m.kickoff.slice(5):(m.date?m.date.slice(5):"")+" "+(m.time||"")}</td>
      <td class="num">${(m.hhad&&m.hhad.goal)||"—"}</td>
      <td class="num"><b>${(m.had&&m.had.h)||"-"}</b></td>
      <td class="num">${(m.had&&m.had.d)||"-"}</td>
      <td class="num">${(m.had&&m.had.a)||"-"}</td>
      <td class="num">${m.hadProb?Object.values(m.hadProb).join("/"):"-"}</td>
      <td class="num">${m.hadSup?Object.values(m.hadSup).join("/"):"-"}</td>
      <td class="num" style="color:${maxHot>=15?"var(--bad)":"var(--sub)"}">${maxHot>=15?"+"+maxHot:maxHot||0}</td>
      <td class="num">${m.returnRate!=null?m.returnRate+"%":"-"}</td>
      <td style="color:var(--warn);font-weight:700">${stars?"★".repeat(stars):"—"}</td>
      <td style="color:${vc};text-align:left">${verdict?verdict.txt:"—"}</td>
    </tr>`;
  }).join("");
  return head + rows + `</tbody></table>`;
}
function renderTable(){
  $("#tableView").innerHTML = tableHtml();
}

/* ---------- 渲染：历史战绩 ---------- */
function histTag(t){
  if (t==="good") return `<span class="vtag good">正路</span>`;
  if (t==="bad") return `<span class="vtag bad">危险</span>`;
  if (t==="cold") return `<span class="vtag cold">冷门</span>`;
  if (t==="warn") return `<span class="vtag warn">谨慎</span>`;
  return `<span class="vtag none">无判定</span>`;
}
function histDir(d){
  if (!d) return "";
  return {"h":"主胜","d":"平局","a":"客胜"}[d] || "";
}
function histFlag(r){
  if (r.result && r.result.cancel) return `<span class="h-flag na">取消</span>`;
  if (r.hitFlag==="hit") return `<span class="h-flag hit">✓ 命中</span>`;
  if (r.hitFlag==="miss") return `<span class="h-flag miss">✗ 错误</span>`;
  if (r.hitFlag==="n-a") return `<span class="h-flag na">不计</span>`;
  return `<span class="h-flag pend">待开奖回填</span>`;
}
function histFilterFn(r){
  const f = state.histFilter;
  if (f==="hit") return r.hitFlag==="hit";
  if (f==="miss") return r.hitFlag==="miss";
  if (f==="pend") return r.hitFlag==null && !(r.result && r.result.cancel);
  if (f==="na") return r.hitFlag==="n-a";
  if (state.histDate!=="all" && r.date && r.date!==state.histDate) return false;
  return true;
}
function renderHistFilters(){
  const defs = [["all","全部"],["hit","命中"],["miss","错误"],["pend","待回填"],["na","不计"]];
  $("#histFilterChips").innerHTML = defs.map(([k,v])=>
    `<button class="chip${state.histFilter===k?" on":""}" data-f="${k}">${v}</button>`).join("");
  const years = [...new Set((state.history||[]).map(r=>(r.date||"").slice(0,4)).filter(Boolean))].sort().reverse();
  if(!years.length) years.push(new Date().getFullYear());
  $("#histDateFilterWrap").innerHTML = dateSelectHtml("hist", state.histDate, years);
}
function renderHistStats(){
  const list = state.history;
  const total = list.length;
  const hit = list.filter(r=>r.hitFlag==="hit").length;
  const miss = list.filter(r=>r.hitFlag==="miss").length;
  const pend = list.filter(r=>r.hitFlag==null && !(r.result && r.result.cancel)).length;
  const na = total - hit - miss - pend;
  const rate = (hit+miss) ? Math.round(hit/(hit+miss)*1000)/10 : null;
  const bdBdgEl = $("#bdBdg"); if(bdBdgEl) bdBdgEl.textContent = (state.bd && state.bd.count) || 0;
  $("#histBdg").textContent = total;
  $("#histStats").innerHTML =
    `<div class="hstat"><b class="num">${total}</b><span>累计判定</span></div>` +
    `<div class="hstat hit"><b class="num">${hit}</b><span>命中</span></div>` +
    `<div class="hstat miss"><b class="num">${miss}</b><span>错误</span></div>` +
    `<div class="hstat pend"><b class="num">${pend}</b><span>待开奖回填</span></div>` +
    `<div class="hstat"><b class="num">${rate==null?"—":rate+"%"}</b><span>命中率</span></div>` +
    `<div class="hstat"><b class="num">${na}</b><span>不计入</span></div>`;
  updateClock();
  $("#histNote").innerHTML = `<b>判定机制</b>：比赛结束后官方发布开奖结果，自动回填比分并按判定方向标注命中/错误（正路=预测热门方向打出；危险/冷门=预测该方向不会打出；谨慎及无判定不计入命中率）。历史库从 2026-09-06 起每日自动积累。`;
}
function renderHistList(){
  const list = state.history.filter(histFilterFn);
  if (!list.length){ $("#histList").innerHTML = `<div class="empty">当前筛选下没有记录</div>`; return; }
  // 按日期分组
  const groups = {};
  list.forEach(r=>{
    const k = r.date || "未排期";
    (groups[k] = groups[k] || []).push(r);
  });
  const html = Object.keys(groups).sort().reverse().map(date=>{
    const arr = groups[date];
    const rows = arr.map(r=>{
      const v = r.verdict || {};
      const vt = v.t || "";
      const score = r.result ? r.result.score : null;
      const hadr = r.result ? ({"h":"胜","d":"平","a":"负"}[r.result.had] || "") : "";
      return `<div class="hrec">
        <div class="h-time num">${r.kickoff?r.kickoff.slice(5):""}</div>
        <div class="h-vs">
          <div class="teams"><span>${r.home||""}</span><span style="color:var(--weak);font-weight:400">vs</span><span>${r.away||""}</span>
            <span class="num" style="color:var(--weak);font-size:11px;font-weight:400">${r.num||""}</span></div>
          <div class="h-meta"><span>${r.league||""}</span>${r.goal?`<span>让球 ${r.goal}</span>`:""}
            <span>预测于 ${r.predAt?r.predAt.slice(5,16):"—"}</span></div>
          <div class="h-verdict">${histTag(vt)}${v.dir?`<span class="vtag na">方向：${histDir(v.dir)}</span>`:""}
            ${v.txt?`<span style="color:var(--sub)">${v.txt}</span>`:""}</div>
          ${(()=>{
            const hv = r.hhadVerdict || {};
            const av = r.asianVerdict || {};
            const sr = r.scoreRec || {};
            const hhadDirName = {h:"让胜",d:"让平",a:"让负"};
            const hhadType = hv.t || "good";
            const hhadDisplay = hhadDirName[hv.dir]||"";
            // 竞彩让球数格式化
            const hgoal = hv.goal || r.goal || "0";
            let hgoalText = hgoal;
            try {
              const gv = parseInt(hgoal);
              if(gv < 0) hgoalText = `让${Math.abs(gv)}球`;
              else if(gv > 0) hgoalText = `受让${gv}球`;
              else hgoalText = "平手";
            } catch(e) {}
            // 亚指盘口推荐转换为让球/受让表述
            let asianRecText = "-";
            const asianLine = av.asianLine || "";
            const asianDir = av.dir;
            if(asianLine && asianDir){
              const homeIsUpper = !asianLine.startsWith("受") && !asianLine.startsWith("客");
              const lineClean = asianLine.replace(/^受/,"").replace(/^客/,"");
              if(asianDir === "d"){
                asianRecText = "走水";
              } else if(homeIsUpper){
                asianRecText = asianDir === "h" ? `主队让${lineClean}` : `客队受让${lineClean}`;
              } else {
                asianRecText = asianDir === "h" ? `客队让${lineClean}` : `主队受让${lineClean}`;
              }
            } else if(asianDir){
              asianRecText = {h:"上盘",d:"走水",a:"下盘"}[asianDir] || "-";
            }
            const parts = [];
            if(hv.dir){
              const hc = r.hhadHit;
              parts.push(`<span class="vtag ${hc==='hit'?'hit':(hc==='miss'?'miss':'na')}" style="font-size:10px">竞彩让球(${hgoalText}) ${hhadDisplay}${hc?` ${hc==='hit'?'✓':hc==='miss'?'✗':''}`:""}</span>`);
            }
            if(av.dir){
              const ac = r.asianHit;
              parts.push(`<span class="vtag ${ac==='hit'?'hit':(ac==='miss'?'miss':'na')}" style="font-size:10px">亚指(${asianLine||"-"}) ${asianRecText}${ac?` ${ac==='hit'?'✓':ac==='miss'?'✗':''}`:""}</span>`);
            }
            if(sr.predicted){
              const sc = r.scoreHit;
              const actual = r.scoreActual || (r.result?`${r.result.home}:${r.result.away}`:null);
              parts.push(`<span class="vtag ${sc==='hit'?'hit':(sc==='partial'?'partial':(sc==='miss'?'miss':'na'))}" style="font-size:10px">比分 ${sr.predicted}${actual?`→${actual}`:""}${sc?` ${sc==='hit'?'✓':sc==='partial'?'◐':sc==='miss'?'✗':''}`:""}</span>`);
            }
            return parts.length?`<div class="h-verdict" style="margin-top:3px">${parts.join("")}</div>`:"";
          })()}
        </div>
        <div class="h-right">
          <div class="h-score num">${score?score.replace(":"," : "):"—"}${hadr?`<span class="hadr">${hadr}</span>`:""}</div>
          ${histFlag(r)}
        </div>
      </div>`;
    }).join("");
    return `<div class="day-group">
      <div class="day-head"><span class="bar"></span><span>${date}</span><span class="cnt">${arr.length} 场</span></div>
      <div class="hlist">${rows}</div>
    </div>`;
  }).join("");
  $("#histList").innerHTML = html;
}
function renderHistory(){
  renderHistStats();
  renderHistFilters();
  renderStarBoard();
  renderRuleBoard();
  renderHistList();
}

/* ---------- 规则组命中率榜（回测调参） ---------- */
function renderRuleBoard(){
  const cfg = state.config || {};
  const keys = Object.keys(cfg);
  if (!keys.length){ $("#rgBoard").innerHTML = ""; return; }
  const rows = keys.map(k=>{
    const c = cfg[k];
    const n = c.samples || 0;
    const rate = c.hitRate;
    const ok = n >= 20;
    let rateCell;
    if (!ok){
      rateCell = `<span class="rate-mid">样本积累中 ${n}/20</span>`;
    } else if (rate == null){
      rateCell = `<span class="rate-mid">—</span>`;
    } else {
      const cls = rate >= 65 ? "rate-high" : (rate >= 40 ? "rate-mid" : "rate-low");
      const barCls = rate >= 65 ? "var(--good)" : (rate >= 40 ? "var(--warn)" : "var(--bad)");
      rateCell = `<span class="${cls}"><b>${rate}%</b></span>
        <span class="ratebar"><i style="width:${Math.min(100,rate)}%;background:${barCls}"></i></span>`;
    }
    const adj = c.threshold !== c.base ? `<span style="color:var(--warn)">${c.base}→${c.threshold}</span>` : c.threshold;
    return `<tr>
      <td style="text-align:left;font-weight:600">${k}</td>
      <td class="num">${c.hit||0}</td>
      <td class="num">${c.miss||0}</td>
      <td class="num">${n}</td>
      <td>${rateCell}</td>
      <td class="num">${adj}</td>
    </tr>`;
  }).join("");
  $("#rgBoard").innerHTML = `<div class="rg-title">规则组命中率榜（回测自动调参）
      <span class="tip">样本≥20 场后自动按命中率调整阈值：&lt;40% 收紧，&gt;65% 放宽</span></div>
    <table>
      <thead><tr><th style="text-align:left">规则组</th><th>命中</th><th>错误</th><th>样本</th><th>命中率</th><th>阈值(基础→当前)</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
}

function fmtForm(f){
  if (!f || !f.n) return `<span style="color:var(--weak)">暂无</span>`;
  const cls = f.wr>=60?"":f.wr>=40?"mid":"low";
  return `<span class="frm-wr ${cls}">${f.wr}%胜</span><span style="color:var(--weak)">${f.form}${f.n<6?"("+f.n+"场)":""}</span>`;
}
function sigRow(m){
  const gap = (m.hrn!=null && m.arn!=null) ? (m.arn - m.hrn) : null;
  const cells = [];
  if (gap != null){
    const cls = Math.abs(gap)>=8 ? "strong" : "";
    cells.push(`<span class="mv-item"><span class="hname">排名</span><b class="${cls}">${m.hr||"-"} vs ${m.ar||"-"}（差${gap>0?"+":""}${gap}）</b></span>`);
  }
  if (m.goalsExp != null){
    const cls = m.goalsExp>=3 ? "high" : (m.goalsExp<=2.2 ? "low" : "");
    cells.push(`<span class="mv-item"><span class="hname">期望进球</span><b class="${cls}">${m.goalsExp}球</b></span>`);
  }
  if (m.hhProb != null || m.aaProb != null){
    cells.push(`<span class="mv-item"><span class="hname">半场掌控</span><b>主/主${m.hhProb!=null?m.hhProb+"%":"-"} · 客/客${m.aaProb!=null?m.aaProb+"%":"-"}</b></span>`);
  }
  // 球队近况（500 球队页 / 自建历史库）
  const fh = (m.form||{}).home, fa = (m.form||{}).away;
  if (fh || fa){
    cells.push(`<span class="mv-item"><span class="hname">近况</span><b>${fmtForm(fh)}</b><b style="color:var(--weak)">vs</b><b>${fmtForm(fa)}</b>${(fh&&fh.src)||(fa&&fa.src)?`<span class="hname">${(fh&&fh.src)||(fa&&fa.src)==="500球队页"?"500近6":"自建库"}</span>`:""}</span>`);
  }
  // 历史交锋（自建库，随积累增长）
  if (m.h2h){
    cells.push(`<span class="mv-item"><span class="hname">交锋近${m.h2h.n}</span><b>主${m.h2h.hw}胜 ${m.h2h.dd}平 客${m.h2h.aw}胜</b><span class="hname">${m.h2h.last}</span></span>`);
  }
  // 攻防效率（北单+竞彩历史池自算）
  const ak = (m.attack||{}).home, aa2 = (m.attack||{}).away;
  if (ak || aa2){
    const fmtAtk = x => x ? `${x.gf}/${x.ga}球` : "-";
    cells.push(`<span class="mv-item"><span class="hname">攻防近${ak?ak.n:(aa2?aa2.n:6)}</span><b>主${fmtAtk(ak)}</b><b style="color:var(--weak)">vs</b><b>客${fmtAtk(aa2)}</b><span class="hname">进/失球</span></span>`);
  }
  // 竞彩×北单交叉验证 + 亚盘
  if (m.cross){
    const ok = m.cross.agree;
    const level = ok ? (Math.abs(m.cross.diff)>=6 ? "微偏" : "双确认") : "方向分歧";
    cells.push(`<span class="mv-item"><span class="hname">北单参考</span><b class="${ok?"xok":"xdiff"}">${level}</b><span class="hname">概率差${m.cross.diff>0?"+":""}${m.cross.diff}pt${m.cross.asian?` · 亚盘 <i class="asian-pill">${m.cross.asian}</i>`:""}</span></span>`);
  }
  // BSD伤停信息
  if (BUILT_BSD[m.num]){
    const ih = BUILT_BSD[m.num].injury_count_home || 0;
    const ia = BUILT_BSD[m.num].injury_count_away || 0;
    if (ih>0 || ia>0){
      const severity = (ih+ia) >= 8 ? "严重" : (ih+ia)>=4 ? "较多" : "一般";
      const sevColor = (ih+ia)>=8 ? "var(--bad)" : (ih+ia)>=4 ? "var(--warn)" : "var(--good)";
      cells.push(`<span class="mv-item"><span class="hname">伤停</span><b style="color:${sevColor}">主${ih}人 客${ia}人</b><span class="hname">${severity}</span></span>`);
    }
    // 天气
    if (BUILT_BSD[m.num].weather && BUILT_BSD[m.num].weather.temperature_c){
      cells.push(`<span class="mv-item"><span class="hname">天气</span><b>${BUILT_BSD[m.num].weather.temperature_c}°C</b><span class="hname">风速${BUILT_BSD[m.num].weather.wind_speed||"-"}m/s</span></span>`);
    }
  }
  if (!cells.length) return "";
  return `<div class="mv-row sig-row"><span class="gl">深度信号</span>${cells.join("")}</div>`;
}

/* ---------- BSD伤停首发详情 ---------- */
function renderBSDDetail(m){
  if (!BUILT_BSD[m.num]) return "";
  const b = BUILT_BSD[m.num];
  const mid = "bsd_" + (m.num||"").replace(/\W/g,"");
  let html = `<div class="bsd-sec">`;
  const hasInjury = (b.injury_count_home||0)>0 || (b.injury_count_away||0)>0;
  const hasLineup = b.expected_lineups && (b.expected_lineups.home||[]).length>0;
  const hasCoach = b.home_coach || b.away_coach;
  const hasAI = b.ai_preview && b.ai_preview.length>20;
  const tags = [];
  if (hasInjury) tags.push(`伤停主${b.injury_count_home||0}/客${b.injury_count_away||0}`);
  if (hasLineup) tags.push("预期首发");
  if (hasCoach) tags.push("教练战术");
  if (hasAI) tags.push("AI预测");
  html += `<div class="bsd-toggle" onclick="document.getElementById('${mid}').classList.toggle('show')">
    <span class="bsd-icon">🏥</span>
    <span class="bsd-title">BSD深度数据</span>
    <span class="bsd-tags">${tags.join(" · ")}</span>
    <span class="bsd-arrow">▼</span>
  </div>`;
  html += `<div class="bsd-detail" id="${mid}">`;
  if (hasInjury){
    html += `<div class="bsd-block"><div class="bsd-block-title">伤停名单</div><div class="bsd-injuries">`;
    const renderInj = (list, team) => {
      if (!list || !list.length) return `<div class="inj-col"><b>${team}</b><div class="inj-empty">无</div></div>`;
      const items = list.map(p=>`<div class="inj-item"><span class="inj-name">${p.name||""}</span><span class="inj-status ${p.status||""}">${p.status==="injured"?"伤":p.status==="suspended"?"停":p.status||""}</span><span class="inj-reason">${p.reason||""}</span>${p.expected_return?`<span class="inj-return">${p.expected_return}回归</span>`:""}</div>`).join("");
      return `<div class="inj-col"><b>${team}</b>${items}</div>`;
    };
    html += renderInj(b.injuries_home, m.home||"主队");
    html += renderInj(b.injuries_away, m.away||"客队");
    html += `</div></div>`;
  }
  if (hasLineup){
    const lu = b.expected_lineups;
    html += `<div class="bsd-block"><div class="bsd-block-title">预期首发阵容</div><div class="bsd-lineups">
      <div class="lu-col"><b>${lu.home_team||m.home||"主队"}</b><div class="lu-players">${(lu.home||[]).map(p=>`<span class="lu-player">${p}</span>`).join("")}</div></div>
      <div class="lu-col"><b>${lu.away_team||m.away||"客队"}</b><div class="lu-players">${(lu.away||[]).map(p=>`<span class="lu-player">${p}</span>`).join("")}</div></div>
    </div></div>`;
  }
  if (hasCoach){
    const renderCoach = (c, team) => {
      if (!c) return "";
      return `<div class="coach-item"><b>${team}：${c.name||""}</b><span>战术：${c.profile||"-"} | 阵型：${c.formation||"-"}</span>${c.pressing!=null?`<span>压迫强度：${(c.pressing*100).toFixed(0)}%</span>`:""}${c.defensive_line?`<span>防线：${c.defensive_line}</span>`:""}${c.styles&&c.styles.length?`<span>风格：${c.styles.join("/")}</span>`:""}</div>`;
    };
    html += `<div class="bsd-block"><div class="bsd-block-title">教练战术对比</div><div class="bsd-coaches">${renderCoach(b.home_coach, m.home||"主队")}${renderCoach(b.away_coach, m.away||"客队")}</div></div>`;
  }
  if (b.referee && b.referee.name){
    const r = b.referee;
    html += `<div class="bsd-block"><div class="bsd-block-title">裁判信息</div><div class="bsd-referee"><b>${r.name}</b>${r.career_games?`<span>执法${r.career_games}场</span>`:""}${r.yellow_cards!=null?`<span>场均黄牌${(r.yellow_cards/Math.max(r.career_games||1,1)).toFixed(1)}</span>`:""}${r.red_cards!=null?`<span>场均红牌${(r.red_cards/Math.max(r.career_games||1,1)).toFixed(2)}</span>`:""}</div></div>`;
  }
  if (hasAI){
    html += `<div class="bsd-block"><div class="bsd-block-title">AI赛事分析预测</div><div class="bsd-ai">${b.ai_preview.replace(/\n/g,"<br>")}</div></div>`;
  }
  if (b.funfacts && b.funfacts.length){
    html += `<div class="bsd-block"><div class="bsd-block-title">趣味数据</div><div class="bsd-funfacts">${b.funfacts.map(f=>`<div class="funfact">• ${f}</div>`).join("")}</div></div>`;
  }
  html += `</div></div>`;
  return html;
}

/* ---------- 星级分层命中率 ---------- */
function renderStarBoard(){
  const box = $("#starBoard");
  const recs = state.history || [];
  const tiers = {};
  for (let i=0;i<=5;i++) tiers[i] = {n:0, hit:0, miss:0};
  let withScore = 0;
  recs.forEach(r=>{
    const st = (r.score && r.score.stars)!=null ? r.score.stars : null;
    if (st==null) return;
    withScore++;
    tiers[st].n++;
    if (r.hitFlag==="hit") tiers[st].hit++;
    else if (r.hitFlag==="miss") tiers[st].miss++;
  });
  if (!withScore){ box.style.display="none"; return; }
  box.style.display="block";
  const rows = Object.keys(tiers).reverse().map(s=>{
    const t = tiers[s];
    const judged = t.hit + t.miss;
    if (!t.n && !judged) return "";
    const rate = judged ? Math.round(t.hit/judged*100) : null;
    const cls = rate==null ? "" : (rate>=65?"rate-high":rate>=40?"rate-mid":"rate-low");
    return `<tr>
      <td style="color:var(--warn);font-weight:700">${"★".repeat(+s)||"—"}</td>
      <td class="num">${t.n}</td>
      <td class="num">${judged}</td>
      <td class="num">${t.hit}</td>
      <td class="num">${t.miss}</td>
      <td>${rate==null?`<span class="rate-mid">待回填</span>`:`<span class="${cls}"><b>${rate}%</b></span>`}</td>
    </tr>`;
  }).join("");
  box.innerHTML = `<div class="sb-title">星级分层命中率（验证高信心策略）
      <span class="tip">统计各星级场次的判定命中率，样本积累后可见高星是否更准</span></div>
    <table>
      <thead><tr><th style="text-align:left">星级</th><th>判定场次</th><th>已回填</th><th>命中</th><th>错误</th><th>命中率</th></tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
}

/* ---------- 总渲染 ---------- */
function render(){
  const wasBK = document.documentElement.dataset.activeTab === "basketball";  // 翻页动效只在真正切 tab 时播放
  document.documentElement.dataset.activeTab = state.tab;
  renderStats();
  renderFilters();
  renderFocus();
  saveBDPicks();
  $("#todayBdg").textContent = state.data.length;
  $("#histBdg").textContent = (state.history||[]).length;
  const bdBdgEl2 = $("#bdBdg"); if(bdBdgEl2) bdBdgEl2.textContent = (state.bd && state.bd.count) || ((state.bd && state.bd.matches||[]).length) || 0;
  const bkBdg = $("#bkBdg");
  if(bkBdg){ bkBdg.textContent = ((state.basketball && state.basketball.matches) || []).length; }
  const swBdg = $("#swBdg");
  if(swBdg){ swBdg.textContent = (state.strongWeak && state.strongWeak.count) || 0; }
  const hfBdg = $("#hfBdg");
  if(hfBdg){ hfBdg.textContent = (state.halfFull && state.halfFull.count) || 0; }
  // 港澳赔率双方同时降水角标
  const hkmoBadge = $("#hkmoTabBadge");
  if(hkmoBadge){
    const hkmoDrop = state.data.filter(m=>m.hkmo && m.hkmo.both_drop).length;
    if(hkmoDrop > 0){ hkmoBadge.textContent = hkmoDrop; hkmoBadge.style.display = "inline-flex"; }
    else hkmoBadge.style.display = "none";
  }
  // 北单/半全场 tab 已下线，旧 localStorage 状态重置为今日
  if(state.tab==="bd" || state.tab==="halffull"){ state.tab="today"; }
  const isToday = state.tab==="today";
  const isBD = false;
  const isSW = state.tab==="strongweak";
  const isHKMO = state.tab==="hkmo";
  const isHighOdds = state.tab==="highodds";
  const isHF = false;
  const isExpert = state.tab==="expert";
  const isFD = state.tab==="fd";
  const isScorePred = state.tab==="scorepred";
  const isBK = state.tab==="basketball";
  // 整页化（v1.7.32）：篮球专区激活时，隐藏足球 tab 栏与头部统计条，
  // 专区独占内容区——像翻到独立的一页，不再被足球导航遮挡；返回时恢复
  if(!isBK){ state.lastFbTab = state.tab; }
  const maintabEl = document.querySelector(".maintab");
  if(maintabEl) maintabEl.style.display = isBK ? "none" : "";
  const statBarEl = $("#statBar");
  if(statBarEl) statBarEl.style.display = isBK ? "none" : "";
  document.querySelectorAll(".maintab button").forEach(b=>b.classList.toggle("on", b.dataset.tab===state.tab));
  $("#todayToolbar").style.display = isToday ? "flex" : "none";
  $("#cardsView").style.display = isToday ? "block" : "none";
  $("#tableView").style.display = isToday ? "block" : "none";
  $("#focusBoard").style.display = isToday ? "block" : "none";
  $("#historyView").classList.toggle("show", state.tab==="history");
  const bdViewEl = $("#bdView"); if(bdViewEl) bdViewEl.classList.toggle("show", false);
  $("#swView").style.display = isSW ? "block" : "none";
  $("#hkmoView").style.display = isHKMO ? "block" : "none";
  $("#highOddsView").style.display = isHighOdds ? "block" : "none";
  const hfViewEl = $("#hfView"); if(hfViewEl) hfViewEl.style.display = "none";
  $("#expertView").style.display = isExpert ? "block" : "none";
  $("#fdView").style.display = isFD ? "block" : "none";
  $("#scorePredView").style.display = isScorePred ? "block" : "none";
  const bkViewEl = $("#basketballView");
  if(bkViewEl){
    bkViewEl.style.display = isBK ? "block" : "none";
    if(isBK && !wasBK){ bkViewEl.classList.remove("bk-in"); void bkViewEl.offsetWidth; bkViewEl.classList.add("bk-in"); }
  }
  if (isSW){ renderStrongWeak(); return; }
  if (isHKMO){ renderHKMO(); return; }
  if (isHighOdds){ renderHighOdds(); return; }
  if (isExpert){ renderExpert(); return; }
  if (isFD){ renderFD(); return; }
  if (isScorePred){ renderScorePred(); return; }
  if (isBK){ renderBasketball(); return; }
  if (!isToday){ renderHistory(); return; }
  if (state.view==="card"){ renderCards(); $("#cardsView").style.display="block"; $("#tableView").style.display="none"; }
  else { renderTable(); $("#tableView").style.display="block"; $("#cardsView").style.display="none"; }
}

/* ---------- 北单推荐保存（页面加载时自动保存，赛后回溯命中） ---------- */
function saveBDPicks(){
  const bd = state.bd || {matches:[]};
  const all = bd.matches || [];
  if(!all.length) return;
  const bdPicksKey = "bd_picks_v1";
  let bdPicks = {};
  try { bdPicks = JSON.parse(localStorage.getItem(bdPicksKey) || "{}"); } catch(e) {}
  const dirNameMap = {h:"主胜",d:"平",a:"客胜"};
  all.forEach(m=>{
    if(!m.odds) return;
    const d = (m.date||"").slice(5);
    if(!d) return;
    const key = d + "_" + m.index;
    let dir = null, txt = "";
    if(m.verdict && m.verdict.dir){ dir = m.verdict.dir; txt = m.verdict.txt||""; }
    else if(m.odds.h && m.odds.d && m.odds.a){
      const o = m.odds;
      dir = o.h<=o.d && o.h<=o.a ? "h" : o.d<=o.a ? "d" : "a";
      txt = "赔率最低方向";
    }
    if(!dir) return;
    const existing = bdPicks[key];
    if(existing && existing.txt && existing.txt!=="赔率最低方向" && txt==="赔率最低方向") return;
    bdPicks[key] = {dir, dirName: dirNameMap[dir], txt, date: m.date||"", home: m.home||"", away: m.away||"", goal: m.goal!=null?m.goal:null};
  });
  try { localStorage.setItem(bdPicksKey, JSON.stringify(bdPicks)); } catch(e) {}
}

/* ---------- 北单 ---------- */
function bdStarBadge(n){
  return `<span class="fi-star" style="font-size:9.5px">${"★".repeat(Math.max(0,Math.min(5,n)))}</span>`;
}
function renderBD(){
  const bd = state.bd || {matches:[],records:[]};
  let sched = (bd.matches||[]).filter(m=>m.disabled!=="yes" && m.odds && m.odds.h);
  const hist = (state.bdHist||{}).records || [];
  $("#bdUpd").textContent = "更新 " + (bd.updateTime || "").slice(0,16);

  // 北单筛选 chips
  const today = new Date();
  const ymd = `${today.getFullYear()}-${String(today.getMonth()+1).padStart(2,"0")}-${String(today.getDate()).padStart(2,"0")}`;
  const bdDefs = [["all","全部"],["today","今日"],["high","高信心≥3★"],["asian","有亚盘"]];
  const bdCnt = {
    all: sched.length,
    today: sched.filter(m=>(m.date||"")===ymd).length,
    high: sched.filter(m=>m.verdict && m.verdict.stars>=3).length,
    asian: sched.filter(m=>m.verdict && m.verdict.asianTxt).length
  };
  $("#bdFilterChips").innerHTML = bdDefs.map(([k,v])=>
    `<button class="chip${state.bdFilter===k?" on":""}" data-bdf="${k}">${v}<span class="bdg">${bdCnt[k]||0}</span></button>`).join("");
  // 应用筛选
  if(state.bdFilter==="today") sched = sched.filter(m=>(m.date||"")===ymd);
  else if(state.bdFilter==="high") sched = sched.filter(m=>m.verdict && m.verdict.stars>=3);
  else if(state.bdFilter==="asian") sched = sched.filter(m=>m.verdict && m.verdict.asianTxt);

  // 统计
  const high = sched.filter(m=>m.verdict && m.verdict.stars>=3);
  $("#bdStats").innerHTML = `
    <div class="hstat clickable" data-bdstat="sched"><b>${sched.length}</b><span>在售场次</span></div>
    <div class="hstat clickable" data-bdstat="hist"><b>${hist.length}</b><span>开奖历史</span></div>
    <div class="hstat clickable" data-bdstat="high"><b>${high.length}</b><span>高信心(≥3★)</span></div>
    <div class="hstat clickable" data-bdstat="all"><b>${bd.matches.length||0}</b><span>全期赛程</span></div>`;

  // 让球徽章：负=主让，正=主受让
  const goalTxt = g => (g!=null && g!==0) ? `<span class="bd-goal">${g<0?`让${-g}`:`受让${g}`}</span>` : "";

  // 读取已保存的北单推荐（saveBDPicks 在页面加载时已保存）
  const bdPicksKey = "bd_picks_v1";
  let bdPicks = {};
  try { bdPicks = JSON.parse(localStorage.getItem(bdPicksKey) || "{}"); } catch(e) {}

  // 赛程：按日期分组（今天及之后在前），组内按时间
  const groups = {};
  sched.forEach(m=>{ const d=m.date||""; (groups[d]=groups[d]||[]).push(m); });
  const dates = Object.keys(groups).sort((a,b)=>{
    const af = a>=ymd?0:1, bf = b>=ymd?0:1;
    return af!==bf ? af-bf : (a<b?-1:1);
  });
  $("#bdSchedCnt").textContent = `${sched.length} 场 · ${dates.length} 个比赛日`;
  $("#bdSchedList").innerHTML = dates.map(d=>{
    const items = groups[d].sort((a,b)=>(a.time||"").localeCompare(b.time||"")).map(m=>{
      const o = m.odds, v = m.verdict||{};
      const dirTxt = v.txt || "—";
      const hot = v.dir==="h"?"hot":v.dir==="a"?"hot":v.dir==="d"?"hot":"";
      return `<div class="bd-card">
        <div class="bd-top">
          <span class="bd-no">${m.index||""}</span>
          <span class="bd-league">${m.league||""}</span>
          <span class="bd-time">${(m.time||"").slice(5)}</span>
          ${m.hrn!=null||m.arn!=null?`<span class="bd-rank">${m.hrn!=null?`主${m.hrn}`:""}${m.arn!=null?` · 客${m.arn}`:""}</span>`:""}
          ${v.asianTxt?`<span class="bd-asian">亚盘 ${v.asianTxt}</span>`:""}
          ${bdStarBadge(v.stars||0)}
        </div>
        <div class="bd-vs">
          <span class="bd-team l">${m.home}${goalTxt(m.goal)}</span>
          <span class="bd-mid">VS</span>
          <span class="bd-team r">${m.away}</span>
        </div>
        <div class="bd-odds">
          <div class="bd-odd ${hot==="hot"&&v.dir==="h"?"hot":""}"><b>${o.h??"—"}</b><i>主胜</i></div>
          <div class="bd-odd ${hot==="hot"&&v.dir==="d"?"hot":""}"><b>${o.d??"—"}</b><i>平局</i></div>
          <div class="bd-odd ${hot==="hot"&&v.dir==="a"?"hot":""}"><b>${o.a??"—"}</b><i>客胜</i></div>
        </div>
        <div class="bd-dir">
          <span class="fi-dir ${v.t||'warn'}">${dirTxt}</span>
          <span class="bd-dir-txt">${v.prob?`让球概率 主${v.prob.h}% 平${v.prob.d}% 客${v.prob.a}%`:""}${v.rankDiff!=null?` · 排名差${v.rankDiff>0?"+":""}${v.rankDiff}`:""}</span>
        </div>
        ${(v.biz&&v.biz.length)?`<div class="bd-biz">⚠ ${v.biz.join("；")}</div>`:""}
      </div>`;
    }).join("");
    const wd = {0:"日",1:"一",2:"二",3:"三",4:"四",5:"五",6:"六"};
    let dw = "";
    try{ dw = " 周"+wd[new Date(d+"T12:00:00").getDay()]; }catch(e){}
    return `<div class="hist-day"><b>${(d||"").slice(5)}${dw}</b></div>${items}`;
  }).join("");

  // 开奖历史：时间倒序，加推荐命中回溯
  let bdHit=0, bdMiss=0, bdNoPick=0;
  const resultToDir = {"胜":"h","平":"d","负":"a"};
  // 日期筛选
  const curYear = new Date().getFullYear();
  const bdYears = [...new Set(hist.map(r=>(r.time||"").slice(0,5)).filter(Boolean).map(()=>curYear))];
  $("#bdHistDateFilterWrap").innerHTML = dateSelectHtml("bd", state.bdHistDate, bdYears.length?bdYears:[curYear]);
  let filteredHist = hist;
  if(state.bdHistDate!=="all"){
    const md = state.bdHistDate.slice(5);
    filteredHist = hist.filter(r=>(r.time||"").slice(0,5)===md);
  }
  $("#bdHistCnt").textContent = `${filteredHist.length} 场`;
  $("#bdHistList").innerHTML = filteredHist.map(r=>{
    const rc = r.result==="胜"?"ok":r.result==="负"?"no":"dr";
    const d = (r.time||"").slice(0,5);
    const key = d + "_" + r.index;
    let pick = bdPicks[key];
    // 队名验证：如果 key 匹配但队名不匹配，尝试模糊匹配
    if(pick && pick.home && r.home && pick.home!==r.home){
      // 队名不匹配，可能是编号复用，搜索同日期同队名的推荐
      const altKey = Object.keys(bdPicks).find(k=>{
        const p = bdPicks[k];
        return k.startsWith(d+"_") && p.home===r.home && p.away===r.away;
      });
      pick = altKey ? bdPicks[altKey] : null;
    }
    let hitTag = "", pickTag = "";
    if(pick){
      const actualDir = resultToDir[r.result];
      if(pick.dir === actualDir){ bdHit++; hitTag = '<span class="bd-hit ok">✓ 命中</span>'; }
      else { bdMiss++; hitTag = '<span class="bd-hit no">✗ 错误</span>'; }
      pickTag = `<span class="bd-pick">推荐${pick.dirName}</span>`;
    } else { bdNoPick++; }
    return `<div class="bd-card">
      <div class="bd-top">
        <span class="bd-no">${r.index||""}</span>
        <span class="bd-league">${r.league||""}</span>
        <span class="bd-time">${r.time||""}</span>
        ${r.round?`<span>${r.round}</span>`:""}
        ${r.sp!=null?`<span class="bd-sp">SP ${r.sp}</span>`:""}
        ${hitTag}
      </div>
      <div class="bd-vs">
        <span class="bd-team l">${r.home}${goalTxt(r.hgoal)}</span>
        <span class="bd-score">${r.score||"—"}</span>
        <span class="bd-team r">${r.away}${goalTxt(r.agoal)}</span>
      </div>
      <div class="bd-histsub">
        <span>半场 ${r.half||"—"} ｜ 让球 主${r.hgoal!=null?r.hgoal:0} / 客${r.agoal!=null?r.agoal:0}</span>
        ${pickTag}
        <span class="bd-tag ${rc}">${r.result||"—"}</span>
      </div>
    </div>`;
  }).join("");
  // 命中统计注入到开奖历史标题旁
  const hitRate = (bdHit+bdMiss)>0 ? Math.round(bdHit/(bdHit+bdMiss)*100) : 0;
  $("#bdHistCnt").textContent = `${hist.length} 场 · 命中${bdHit}/错误${bdMiss}/无推荐${bdNoPick} · 命中率${hitRate}%`;

  // 内部 tab 切换：今日赛程 / 开奖历史
  document.querySelectorAll("#bdSubTab button").forEach(b=>{
    b.classList.toggle("on", b.dataset.bdsub===state.bdSubTab);
  });
  $("#bdSchedWrap").style.display = state.bdSubTab==="sched" ? "" : "none";
  $("#bdHistWrap").style.display = state.bdSubTab==="hist" ? "" : "none";
}

/* ---------- 主题（6套循环切换） ---------- */
/* ---------- 主题（点击弹出选择面板，直接切换） ---------- */
function applyTheme(key){
  const t = THEMES.find(x=>x.key===key);
  if(!t) return;
  state.theme = key;
  document.documentElement.setAttribute("data-theme", key);
  try{ localStorage.setItem("jcTheme", key); }catch(e){}
  // 临时提示
  const tip = document.createElement("div");
  tip.style.cssText = "position:fixed;top:60px;left:50%;transform:translateX(-50%);background:var(--panel);color:var(--text);border:1px solid var(--line);padding:8px 16px;border-radius:8px;font-size:13px;z-index:99999;box-shadow:0 4px 12px rgba(0,0,0,.3);";
  tip.textContent = "主题：" + t.name;
  document.body.appendChild(tip);
  setTimeout(()=>tip.remove(), 1200);
}
function toggleTheme(){
  // 弹出主题选择面板
  let existing = document.getElementById("themePicker");
  if(existing){ existing.remove(); return; }
  const picker = document.createElement("div");
  picker.id = "themePicker";
  picker.style.cssText = "position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:99998;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px;box-shadow:0 12px 32px rgba(0,0,0,.5);min-width:220px;max-width:90vw;";
  let html = '<div style="font-size:12px;font-weight:700;color:var(--text);margin-bottom:8px;padding:0 4px;">选择主题</div>';
  THEMES.forEach(t=>{
    const active = state.theme===t.key;
    html += `<div class="theme-opt${active?' active':''}" data-key="${t.key}" style="display:flex;align-items:center;gap:10px;padding:8px 10px;border-radius:8px;cursor:pointer;margin-bottom:2px;${active?'background:var(--accent-dim);border:1px solid var(--accent);':'border:1px solid transparent;'}">
      <span style="width:20px;height:20px;border-radius:50%;background:${t.preview};border:1px solid var(--line);flex:none;"></span>
      <span style="font-size:13px;color:var(--text);flex:1;">${t.name}</span>
      ${active?'<span style="color:var(--accent);font-size:14px;">✓</span>':''}
    </div>`;
  });
  picker.innerHTML = html;
  document.body.appendChild(picker);
  // 点击选项切换
  picker.querySelectorAll(".theme-opt").forEach(opt=>{
    opt.addEventListener("click", ()=>{
      applyTheme(opt.dataset.key);
      picker.remove();
    });
  });
  // 点击外部关闭
  setTimeout(()=>{
    document.addEventListener("click", function close(e){
      if(!picker.contains(e.target) && e.target.id!=="themeBtn" && !e.target.closest("#themeBtn")){
        picker.remove();
        document.removeEventListener("click", close);
      }
    });
  }, 10);
}

/* ---------- 导入 ---------- */
function normalize(list){
  if (!Array.isArray(list)) throw new Error("数据必须是数组");
  return list.map((m,i)=>{
    if (!m || m.home==null || m.away==null) throw new Error("第"+(i+1)+"场缺少 home/away");
    m.had = m.had || {h:null,d:null,a:null};
    m.hhad = m.hhad || {h:null,d:null,a:null,goal:""};
    m.hadProb = m.hadProb || {}; m.hadSup = m.hadSup || {};
    m.num = m.num || "场次"+(i+1);
    return m;
  });
}
function applyImport(){
  const status = $("#importStatus");
  try{
    const parsed = JSON.parse($("#importArea").value);
    const arr = Array.isArray(parsed) ? parsed : parsed.matches;
    state.data = normalize(arr);
    state.meta.updateTime = parsed.updateTime || nowStr();
    status.className = "import-status ok";
    status.textContent = "导入成功：" + state.data.length + " 场赛事，已重算全部规则。";
    $("#modalMask").classList.remove("show");
    render();
  }catch(e){
    status.className = "import-status err";
    status.textContent = "导入失败：" + e.message;
  }
}

