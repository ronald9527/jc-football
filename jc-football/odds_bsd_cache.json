.bk-group{margin-bottom:14px}
.bk-group-title{font-size:12px;font-weight:700;color:var(--accent);margin:6px 2px 6px;border-left:3px solid var(--accent);padding-left:8px}
.bk-card{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 12px;margin-bottom:8px}
.bk-card-head{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px}
.bk-num{font-size:10px;color:var(--accent);background:var(--accent-dim);padding:1px 6px;border-radius:4px;font-weight:700}
.bk-league{font-size:9.5px;color:var(--weak);background:var(--panel3);padding:1px 6px;border-radius:4px}
.bk-time{font-size:10px;color:var(--sub);font-variant-numeric:tabular-nums}
