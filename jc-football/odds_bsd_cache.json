/* 强弱对战渲染 */
function renderStrongWeak(){
  const list = $("#swList");
  const summary = $("#swSummary");
  if(!list) return;
  const sw = state.strongWeak || {matches:[]};
  const swMatches = sw.matches || [];
  if(summary){
    const xuanShu = swMatches.filter(m=>m.gapLevel==="悬殊").length;
    const mingXian = swMatches.filter(m=>m.gapLevel==="明显").length;
    const brutalCount = swMatches.filter(m=>m.isBrutal).length;
    summary.textContent = `共 ${swMatches.length} 场强弱对战 · 悬殊${xuanShu}场 · 明显${mingXian}场 · 大人打小孩${brutalCount}场 · 数据核验于 ${sw.searchDate||"-"} · 更新于 ${state.meta.updateTime||"-"}`;
  }
  if(!swMatches.length){
    list.innerHTML = `<div class="empty">当前暂无强弱对战数据</div>`;
    return;
  }
  let html = "";
  swMatches.forEach(m=>{
    const levelColor = m.gapLevel==="悬殊"?"var(--bad)":(m.gapLevel==="明显"?"var(--warn)":"var(--accent)");
    const levelBg = m.gapLevel==="悬殊"?"rgba(234,102,104,0.12)":(m.gapLevel==="明显"?"rgba(250,173,20,0.12)":"rgba(139,200,234,0.12)");
    const brutalTag = m.isBrutal?'<span style="margin-left:6px;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;color:#fff;background:linear-gradient(135deg,#EA6668,#FAAD14)">大人打小孩</span>':"";
    const topScorerHtml = m.topScorer?`<div style="margin-top:6px;font-size:11px;color:var(--warn)">★最强射手: <b style="color:var(--text)">${m.topScorer}</b></div>`:"";
    const scorersHtml = (m.scorers||[]).length ? `<div style="margin-top:4px;font-size:11px;color:var(--sub)">关键球员: ${m.scorers.join(" · ")}</div>` : "";
    const injuryDetailHtml = (m.injuryDetail||[]).length ? `<div style="margin-top:6px;font-size:10.5px;color:var(--bad);line-height:1.6">伤停详情: ${m.injuryDetail.join("；")}</div>` : "";
    html += `<div class="score-card">
      <div class="score-head">
        <span class="score-num">${m.num||""}</span>
        <span class="score-league">${m.league||""}</span>
        <span class="score-teams">${m.home||""} vs ${m.away||""}</span>
        <span class="score-kick">${m.kickoff||""}</span>
        <span style="margin-left:auto;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;color:${levelColor};background:${levelBg}">强弱${m.gapLevel}</span>${brutalTag}
      </div>
      <div class="score-body">
        <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin-bottom:10px">
          <div style="text-align:right">
            <div style="font-size:13px;font-weight:700;color:${m.strongIsHome?'var(--good)':'var(--text)'}">${m.home||""} ${m.strongIsHome?'<span style="font-size:10px;color:var(--good)">★强队</span>':'<span style="font-size:10px;color:var(--sub)">主队</span>'}</div>
            <div style="font-size:10.5px;color:var(--sub);margin-top:2px">${m.strongIsHome?m.strongInfo:m.weakInfo||""}</div>
          </div>
          <div style="font-size:18px;font-weight:800;color:var(--sub)">VS</div>
          <div style="text-align:left">
            <div style="font-size:13px;font-weight:700;color:${!m.strongIsHome?'var(--good)':'var(--text)'}">${!m.strongIsHome?'<span style="font-size:10px;color:var(--good)">★强队</span>':'<span style="font-size:10px;color:var(--sub)">客队</span>'} ${m.away||""}</div>
            <div style="font-size:10.5px;color:var(--sub);margin-top:2px">${!m.strongIsHome?m.strongInfo:m.weakInfo||""}</div>
          </div>
        </div>
        <div class="score-reasons">
          ${(m.reasons||[]).map(r=>`<div>· ${r}</div>`).join("")}
        </div>
        ${topScorerHtml}
        ${scorersHtml}
        ${injuryDetailHtml}
        <div style="margin-top:8px;display:flex;gap:8px;flex-wrap:wrap;font-size:10.5px">
          ${m.rankGap?`<span style="padding:2px 6px;border-radius:4px;background:rgba(139,200,234,0.12);color:var(--accent)">${m.rankGap}</span>`:""}
          ${m.injuryInfo?`<span style="padding:2px 6px;border-radius:4px;background:rgba(234,102,104,0.12);color:var(--bad)">${m.injuryInfo}</span>`:""}
          ${m.h2hInfo?`<span style="padding:2px 6px;border-radius:4px;background:rgba(82,196,26,0.12);color:var(--good)">${m.h2hInfo}</span>`:""}
          ${m.haInfo?`<span style="padding:2px 6px;border-radius:4px;background:rgba(250,173,20,0.12);color:var(--warn)">${m.haInfo}</span>`:""}
        </div>
        <div style="margin-top:10px;display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;padding-top:8px;border-top:1px solid var(--border)">
          <span style="color:var(--sub)">胜平负推荐: <b style="color:var(--good);font-size:13px">${m.recommendation||"-"}</b> 赔率 <b>${m.recommendOdds||"-"}</b></span>
          <span style="color:var(--sub)">让球盘(${m.goal>0?('受让'+m.goal):(m.goal<0?('让'+Math.abs(m.goal)):'平手')}): <b style="color:var(--accent)">${m.hhadRecommendation||"-"}</b>${m.hhadStars?` <span style="color:var(--warn)">${'★'.repeat(m.hhadStars)}</span>`:""}</span>
        </div>
        <div style="margin-top:8px;font-size:10px;color:var(--sub);opacity:0.8">
          数据来源: ${m.dataSource||"-"} | 核验时间: ${m.searchDate||"-"} | ${m.verified?'<span style="color:var(--good)">核心数据已验证</span>':'<span style="color:var(--warn)">数据待补充</span>'}
        </div>
      </div>
    </div>`;
  });
  list.innerHTML = html;
}

function renderSWHistory(filterDate){
  const list = $("#swHistoryList");
  const dateBar = $("#swDateBar");
  if(!list) return;
  const swHist = state.strongWeakHistory || {};
  const allDates = Object.keys(swHist).sort().reverse();
  if(!allDates.length){
    list.innerHTML = `<div class="empty">暂无强弱对战历史记录</div>`;
    if(dateBar) dateBar.innerHTML = "";
    return;
  }
  // 渲染日期选择器
  if(dateBar){
    let barHtml = `<button class="hkmo-date-btn hkmo-date-all ${!filterDate?'on':''}" data-swhdate="">全部日期</button>`;
    allDates.forEach(d=>{
      const rec = swHist[d] || {};
      const matches = rec.matches || [];
      const hit = matches.filter(m=>m.hit===true).length;
      const miss = matches.filter(m=>m.hit===false).length;
      const rate = (hit+miss)>0 ? ((hit/(hit+miss))*100).toFixed(0) : "-";
      barHtml += `<button class="hkmo-date-btn ${filterDate===d?'on':''}" data-swhdate="${d}">${d} <span style="opacity:.7">(${matches.length}场 ${rate}%)</span></button>`;
    });
    dateBar.innerHTML = barHtml;
    dateBar.querySelectorAll(".hkmo-date-btn").forEach(btn=>{
      btn.addEventListener("click", ()=>{
        const d = btn.dataset.swhdate || "";
        renderSWHistory(d);
      });
    });
  }
  let html = "";
  const dates = filterDate ? [filterDate] : allDates;
  dates.forEach(date=>{
    const rec = swHist[date] || {};
    const matches = rec.matches || [];
    if(!matches.length) return;
    const hit = matches.filter(m=>m.hit===true).length;
    const miss = matches.filter(m=>m.hit===false).length;
    const na = matches.filter(m=>m.hit===null||m.hit===undefined).length;
    const hhadHit = matches.filter(m=>m.hhadHit===true).length;
    const hhadMiss = matches.filter(m=>m.hhadHit===false).length;
    const rate = (hit+miss)>0 ? ((hit/(hit+miss))*100).toFixed(1) : "-";
    html += `<div class="hkmo-hist-section">
      <div class="hkmo-hist-section-head">
        <span class="hkmo-hist-section-title">${date}</span>
        <span class="hkmo-hist-section-stats">共${matches.length}场 · 胜平负命中${hit}/错误${miss}/待定${na} · 让球命中${hhadHit}/错误${hhadMiss} · 命中率${rate}%</span>
      </div>`;
    matches.forEach(m=>{
      const levelColor = m.gapLevel==="悬殊"?"var(--bad)":(m.gapLevel==="明显"?"var(--warn)":"var(--accent)");
      const levelBg = m.gapLevel==="悬殊"?"rgba(234,102,104,0.12)":(m.gapLevel==="明显"?"rgba(250,173,20,0.12)":"rgba(139,200,234,0.12)");
      const brutalTag = m.isBrutal?'<span style="margin-left:6px;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;color:#fff;background:linear-gradient(135deg,#EA6668,#FAAD14)">大人打小孩</span>':"";
      // 命中状态
      const hitFlag = m.hit;
      const hitClass = hitFlag===true?"hkmo-hit":(hitFlag===false?"hkmo-miss":"hkmo-na");
      const hitText = hitFlag===true?"✓命中":(hitFlag===false?"✗错误":"待开奖");
      const hhadHitFlag = m.hhadHit;
      const hhadHitClass = hhadHitFlag===true?"hkmo-hit":(hhadHitFlag===false?"hkmo-miss":"hkmo-na");
      const hhadHitText = hhadHitFlag===true?"✓命中":(hhadHitFlag===false?"✗错误":"待开奖");
      const resultText = m.result ? `<span style="color:var(--text)">赛果: <b>${m.result}</b></span>` : `<span style="color:var(--sub)">赛果: 待开奖</span>`;
      const topScorerHtml = m.topScorer?`<div style="margin-top:4px;font-size:10.5px;color:var(--warn)">★最强射手: <b style="color:var(--text)">${m.topScorer}</b></div>`:"";
      html += `<div class="score-card ${hitClass}">
        <div class="score-head">
          <span class="score-num">${m.num||""}</span>
          <span class="score-teams">${m.home||""} vs ${m.away||""}</span>
          <span style="margin-left:auto;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;color:${levelColor};background:${levelBg}">强弱${m.gapLevel}</span>${brutalTag}
          <span class="${hitClass}" style="margin-left:8px;font-size:12px;font-weight:700">${hitText}</span>
        </div>
        <div class="score-body">
          <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin-bottom:8px">
            <div style="text-align:right">
              <div style="font-size:12px;font-weight:700;color:${m.strongTeam===m.home?'var(--good)':'var(--text)'}">${m.home||""} ${m.strongTeam===m.home?'<span style="font-size:10px;color:var(--good)">★强队</span>':''}</div>
            </div>
            <div style="font-size:18px;font-weight:800;color:${m.hit===true?'var(--good)':(m.hit===false?'var(--bad)':'var(--sub)')}">
              ${m.actualScore ? m.actualScore : 'VS'}
            </div>
            <div style="text-align:left">
              <div style="font-size:12px;font-weight:700;color:${m.strongTeam===m.away?'var(--good)':'var(--text)'}">${m.strongTeam===m.away?'<span style="font-size:10px;color:var(--good)">★强队</span>':''} ${m.away||""}</div>
            </div>
          </div>
          ${topScorerHtml}
          <div style="margin-top:8px;display:flex;gap:12px;flex-wrap:wrap;font-size:11px;padding-top:8px;border-top:1px solid var(--border)">
            <span style="color:var(--sub)">胜平负推荐: <b style="color:var(--good);font-size:12px">${m.recommendation||"-"}</b> 赔率 <b>${m.recommendOdds||"-"}</b> <span class="${hitClass}" style="font-size:10px">${hitText}</span></span>
            <span style="color:var(--sub)">让球盘(${m.goal>0?('受让'+m.goal):(m.goal<0?('让'+Math.abs(m.goal)):'平手')}): <b style="color:var(--accent)">${m.hhadRecommendation||"-"}</b> <span class="${hhadHitClass}" style="font-size:10px">${hhadHitText}</span></span>
          </div>
          <div style="margin-top:6px;font-size:10.5px;color:var(--sub)">
            ${resultText} · 差距评分: <b>${m.gapScore||0}</b>分
          </div>
        </div>
      </div>`;
    });
    html += `</div>`;
  });
  list.innerHTML = html;
}

function renderHKMO(){
  const list = $("#hkmoList");
  const badge = $("#hkmoTabBadge");
  const summary = $("#hkmoSummary");
  if(!list) return;
  const matches = (state.data||{}).matches || state.data || [];
  const hkmoMatches = matches.filter(m=>(m.hkmo && (m.hkmo.hk || m.hkmo.mo)) || ODDS_BSD[m.num]);
  const bothDrop = hkmoMatches.filter(m=>m.hkmo && m.hkmo.both_drop);
  if(badge){
    if(bothDrop.length > 0){
      badge.textContent = bothDrop.length;
      badge.style.display = "inline-flex";
    } else {
      badge.style.display = "none";
    }
  }
  if(summary){
    const asianUp = hkmoMatches.filter(m=>m.hkmo && m.hkmo.asian && m.hkmo.asian.change==="up").length;
    const asianDown = hkmoMatches.filter(m=>m.hkmo && m.hkmo.asian && m.hkmo.asian.change==="down").length;
    const obsdCount = hkmoMatches.filter(m=>ODDS_BSD[m.num]).length;
    summary.textContent = `共 ${hkmoMatches.length} 场数据（港澳${hkmoMatches.filter(m=>m.hkmo).length}场+国际权威${obsdCount}场） · 双方同时降水 ${bothDrop.length} 场 · 亚盘升盘 ${asianUp} 场 · 降盘 ${asianDown} 场 · 更新于 ${state.meta.updateTime||"-"}`;
  }
  if(!hkmoMatches.length){
    list.innerHTML = `<div class="empty">当前暂无港澳赔率数据</div>`;
    return;
  }
  const dirName = {h:"主胜",d:"平局",a:"客胜"};
  let html = "";
  // 双方同时降水的排在前面
  const sorted = [...bothDrop, ...hkmoMatches.filter(m=>!(m.hkmo && m.hkmo.both_drop))];
  sorted.forEach((m,idx)=>{
    const hm = m.hkmo || {};
    const hk = hm.hk || {};
    const mo = hm.mo || {};
    const hkCur = hk.current || {};
    const hkOpen = hk.open || {};
    const moCur = mo.current || {};
    const moOpen = mo.open || {};
    const isBothDrop = hm.both_drop;
    const commonDirs = hm.common_drop_dirs || [];
    const commonDirText = commonDirs.map(d=>dirName[d]).join("/");
    // 亚盘升/降盘
    const asian = hm.asian || {};
    const asianChange = asian.change || "none";
    const asianOpen = asian.open || "—";
    const asianCur = asian.current || "—";
    const asianTag = asianChange==="up" ? `<span class="hkmo-asian-up">⬆️ 升盘 ${asianOpen}→${asianCur}</span>` :
                     asianChange==="down" ? `<span class="hkmo-asian-down">⬇️ 降盘 ${asianOpen}→${asianCur}</span>` :
                     (asianOpen!=="—"||asianCur!=="—") ? `<span class="hkmo-asian-none">亚盘 ${asianOpen}→${asianCur}</span>` : "";
    // 赔率单元格：初盘→当前，降水标红
    const oddsCell = (openV, curV)=>{
      if(openV==null||curV==null) return `<span class="num">${curV!=null?curV:"—"}</span>`;
      const isDrop = curV < openV - 0.01;
      const isRise = curV > openV + 0.01;
      const color = isDrop ? "var(--bad)" : (isRise ? "var(--good)" : "var(--sub)");
      const arrow = isDrop ? "↓" : (isRise ? "↑" : "→");
      return `<span class="num"><span style="color:var(--weak);font-weight:400">${openV}</span>→<b style="color:${color}">${curV}</b><i class="kdif" style="color:${color}">${arrow}</i></span>`;
    };
    html += `<div class="hkmo-card${isBothDrop?' hkmo-drop':''}">
      <div class="hkmo-head">
        <span class="oc-num">${m.num||""}</span>
        <span class="oc-league">${m.league||""}</span>
        <span class="oc-teams">${m.home||""} vs ${m.away||""}</span>
        <span class="oc-kick">${m.kickoff||""}</span>
        ${isBothDrop?`<span class="hkmo-drop-tag">⚠️ 双方同时降水 ${commonDirText}</span>`:""}
        ${asianTag}
      </div>
      ${m.hkmo?`<div class="hkmo-srctime">
        <span>🇭🇰 香港源数据: ${hkCur.time||"—"}</span>
        <span>🇲🇴 澳门源数据: ${moCur.time||"—"}</span>
        <span>页面刷新: ${__lastRealtimeFetch||state.meta.updateTime||"-"}</span>
      </div>
      <div class="hkmo-table">
        <div class="hkmo-row hkmo-header">
          <div class="hkmo-col hkmo-dir">方向</div>
          <div class="hkmo-col">🇭🇰 香港马会 初→现</div>
          <div class="hkmo-col">🇲🇴 澳门彩票 初→现</div>
          <div class="hkmo-col">香港降水</div>
          <div class="hkmo-col">澳门降水</div>
        </div>
        ${["h","d","a"].map(k=>{
          const hkDrop = (hk.drop_dirs||[]).includes(k);
          const moDrop = (mo.drop_dirs||[]).includes(k);
          return `<div class="hkmo-row">
          <div class="hkmo-col hkmo-dir"><b>${dirName[k]}</b></div>
          <div class="hkmo-col">${oddsCell(hkOpen[k], hkCur[k])}</div>
          <div class="hkmo-col">${oddsCell(moOpen[k], moCur[k])}</div>
          <div class="hkmo-col">${hkDrop?'<span style="color:var(--bad);font-weight:700">↓降水</span>':'—'}</div>
          <div class="hkmo-col">${moDrop?'<span style="color:var(--bad);font-weight:700">↓降水</span>':'—'}</div>
        </div>`;
        }).join("")}
      </div>`:""}
      ${(()=>{
        const obsd = ODDS_BSD[m.num];
        if(!obsd || !obsd.bookmakers) return "";
        const books = obsd.bookmakers;
        const bookList = Object.keys(books);
        if(!bookList.length) return "";
        const movements = obsd.movements || [];
        const dropCount = movements.filter(mv=>mv.direction==="drop").length;
        const riseCount = movements.filter(mv=>mv.direction==="rise").length;
        let rows = "";
        ["HOME","DRAW","AWAY"].forEach(outcome=>{
          const outName = {HOME:"主胜",DRAW:"平局",AWAY:"客胜"}[outcome];
          let cells = "";
          bookList.forEach(book=>{
            const data = (books[book]||{})[outcome] || {};
            const cur = data.odds;
            const prev = data.prev_odds;
            if(cur==null) { cells += `<div class="obsd-cell">—</div>`; return; }
            let color = "var(--sub)";
            let arrow = "";
            if(prev!=null && cur < prev - 0.01) { color = "var(--bad)"; arrow = "↓"; }
            else if(prev!=null && cur > prev + 0.01) { color = "var(--good)"; arrow = "↑"; }
            cells += `<div class="obsd-cell">
              <span class="obsd-cur" style="color:${color}">${cur}</span>
              ${prev!=null?`<span class="obsd-prev">${prev}</span>`:""}
              ${arrow?`<span class="obsd-arrow" style="color:${color}">${arrow}</span>`:""}
            </div>`;
          });
          rows += `<div class="obsd-row">
            <div class="obsd-dir"><b>${outName}</b></div>
            ${cells}
          </div>`;
        });
        return `<div class="obsd-sec">
          <div class="obsd-title">🌍 国际权威赔率（Pinnacle/Bet365等，更新更灵敏）
            ${dropCount>0?`<span class="obsd-drop-badge">降水${dropCount}</span>`:""}
            ${riseCount>0?`<span class="obsd-rise-badge">升水${riseCount}</span>`:""}
          </div>
          <div class="obsd-table">
            <div class="obsd-row obsd-header">
              <div class="obsd-dir">方向</div>
              ${bookList.map(b=>`<div class="obsd-cell obsd-book">${b}</div>`).join("")}
            </div>
            ${rows}
          </div>
        </div>`;
      })()}
      ${(()=>{
        const hhadV = m.hhadVerdict || {};
        const asianV = m.asianVerdict || {};
        const hhadDirName = {h:"让胜",d:"让平",a:"让负"};
        const hhadType = hhadV.t || "good";
        const hhadDisplay = hhadDirName[hhadV.dir]||"-";
        const hhadHit = m.hhadHit;
        const asianHit = m.asianHit;
        // 竞彩让球数格式化：-1→让1球，+1→受让1球
        const goal = hhadV.goal || m.hhad?.goal || "0";
        let goalText = goal;
        try {
          const gv = parseInt(goal);
          if(gv < 0) goalText = `让${Math.abs(gv)}球`;
          else if(gv > 0) goalText = `受让${gv}球`;
          else goalText = "平手";
        } catch(e) {}
        // 亚指盘口推荐转换为让球/受让表述
        let asianRecText = "-";
        const asianLine = asianV.asianLine || "";
        const asianDir = asianV.dir;
        if(asianLine && asianDir){
          const homeIsUpper = !asianLine.startsWith("受") && !asianLine.startsWith("客");
          const lineClean = asianLine.replace(/^受/,"").replace(/^客/,"");
          if(asianDir === "d"){
            asianRecText = "走水";
          } else if(homeIsUpper){
            // 主队让球
            asianRecText = asianDir === "h" ? `主队让${lineClean}` : `客队受让${lineClean}`;
          } else {
            // 主队受让（客队让球）
            asianRecText = asianDir === "h" ? `客队让${lineClean}` : `主队受让${lineClean}`;
          }
        } else if(asianDir){
          asianRecText = {h:"上盘",d:"走水",a:"下盘"}[asianDir] || "-";
        }
        if(!hhadV.dir && !asianV.dir) return "";
        return `<div class="hkmo-rec-sec">
          <div class="hkmo-rec-title">🎯 盘口推荐（赛后自动回填命中）</div>
          <div class="hkmo-rec-row">
            ${hhadV.dir?`<div class="hkmo-rec-item">
              <div class="hkmo-rec-label">竞彩让球胜平负 (${goalText})</div>
              <div class="hkmo-rec-val ${hhadHit==='hit'?'hit':(hhadHit==='miss'?'miss':'')}">${hhadDisplay} <span class="hkmo-rec-stars">${hhadV.stars?"★".repeat(hhadV.stars):""}</span></div>
              ${hhadV.txt?`<div style="font-size:10px;color:var(--weak);margin-top:2px">${hhadV.txt}</div>`:""}
              ${hhadHit?`<div style="font-size:10px;margin-top:2px;color:${hhadHit==='hit'?'var(--good)':'var(--bad)'}">${hhadHit==='hit'?'✓ 命中':'✗ 未中'}</div>`:""}
            </div>`:""}
            ${asianV.dir?`<div class="hkmo-rec-item">
              <div class="hkmo-rec-label">亚指盘口 (${asianLine||"-"})</div>
              <div class="hkmo-rec-val ${asianHit==='hit'?'hit':(asianHit==='miss'?'miss':'')}">${asianRecText} <span class="hkmo-rec-stars">${asianV.stars?"★".repeat(asianV.stars):""}</span></div>
              ${asianV.txt?`<div style="font-size:10px;color:var(--weak);margin-top:2px">${asianV.txt}</div>`:""}
              ${asianHit?`<div style="font-size:10px;margin-top:2px;color:${asianHit==='hit'?'var(--good)':'var(--bad)'}">${asianHit==='hit'?'✓ 命中':'✗ 未中'}</div>`:""}
            </div>`:""}
          </div>
        </div>`;
      })()}
    </div>`;
  });
  list.innerHTML = html;
}

/* 港澳赔率历史记录渲染 */
function renderHKMOHistory(filterDate){
  const list = $("#hkmoHistoryList");
  const dateBar = $("#hkmoDateBar");
  if(!list) return;
  const hkmoHist = state.hkmoHistory || [];
  if(!hkmoHist.length){
    list.innerHTML = `<div class="empty">暂无港澳赔率历史记录</div>`;
    if(dateBar) dateBar.innerHTML = "";
    return;
  }
  // 按日期分组
  const byDate = {};
  hkmoHist.forEach(r=>{
    const d = r.date || "未知";
    if(!byDate[d]) byDate[d] = [];
    byDate[d].push(r);
  });
  const allDates = Object.keys(byDate).sort().reverse();
  // 渲染日期选择器
  if(dateBar){
    let barHtml = `<button class="hkmo-date-btn hkmo-date-all ${!filterDate?'on':''}" data-hdate="">全部日期</button>`;
    allDates.forEach(d=>{
      const recs = byDate[d];
      const hit = recs.filter(r=>r.hitFlag==="hit").length;
      const miss = recs.filter(r=>r.hitFlag==="miss").length;
      const rate = (hit+miss)>0 ? ((hit/(hit+miss))*100).toFixed(0) : "-";
      barHtml += `<button class="hkmo-date-btn ${filterDate===d?'on':''}" data-hdate="${d}">${d} <span style="opacity:.7">(${recs.length}场 ${rate}%)</span></button>`;
    });
    dateBar.innerHTML = barHtml;
    dateBar.querySelectorAll(".hkmo-date-btn").forEach(btn=>{
      btn.addEventListener("click", ()=>{
        const d = btn.dataset.hdate || "";
        renderHKMOHistory(d);
      });
    });
  }
  const dirName = {h:"主胜",d:"平局",a:"客胜"};
  const oddsCell = (openV, curV)=>{
    if(openV==null||curV==null) return `<span class="num">${curV!=null?curV:"—"}</span>`;
    const isDrop = curV < openV - 0.01;
    const isRise = curV > openV + 0.01;
    const color = isDrop ? "var(--bad)" : (isRise ? "var(--good)" : "var(--sub)");
    const arrow = isDrop ? "↓" : (isRise ? "↑" : "→");
    return `<span class="num"><span style="color:var(--weak);font-weight:400">${openV}</span>→<b style="color:${color}">${curV}</b><i class="kdif" style="color:${color}">${arrow}</i></span>`;
  };
  let html = "";
  const dates = filterDate ? [filterDate] : allDates;
  dates.forEach(date=>{
    const records = byDate[date] || [];
    if(!records.length) return;
    const hit = records.filter(r=>r.hitFlag==="hit").length;
    const miss = records.filter(r=>r.hitFlag==="miss").length;
    const na = records.filter(r=>r.hitFlag==="n-a"||!r.hitFlag).length;
    const rate = (hit+miss)>0 ? ((hit/(hit+miss))*100).toFixed(1) : "-";
    html += `<div class="hkmo-hist-section">
      <div class="hkmo-hist-section-head">
        <span class="hkmo-hist-section-title">${date}</span>
        <span class="hkmo-hist-section-stats">共${records.length}场 · 命中${hit} · 错误${miss} · 待定${na} · 命中率${rate}%</span>
      </div>`;
    // 双方同时降水的排在前面
    const sorted = [...records.filter(r=>(r.common_drop_dirs||[]).length>0), ...records.filter(r=>(r.common_drop_dirs||[]).length===0)];
    sorted.forEach(r=>{
      const hk = r.hk || {};
      const mo = r.mo || {};
      const hkCur = hk.current || {};
      const hkOpen = hk.open || {};
      const moCur = mo.current || {};
      const moOpen = mo.open || {};
      const dirs = r.common_drop_dirs || [];
      const isBothDrop = dirs.length > 0;
      const commonDirText = dirs.map(d=>dirName[d]).join("/");
      const pickDir = r.pickDir || (dirs.length?dirs[0]:"");
      const hitFlag = r.hitFlag || "";
      const hitClass = hitFlag==="hit"?"hkmo-hit":(hitFlag==="miss"?"hkmo-miss":"hkmo-na");
      const hitText = hitFlag==="hit"?"✓命中":(hitFlag==="miss"?"✗错误":"待开奖");
      // 亚盘
      const asian = r.asian || {};
      const asianChange = asian.change || "none";
      const asianOpen = asian.open || "—";
      const asianCur = asian.current || "—";
      const asianTag = asianChange==="up" ? `<span class="hkmo-asian-up">⬆️ 升盘 ${asianOpen}→${asianCur}</span>` :
                       asianChange==="down" ? `<span class="hkmo-asian-down">⬇️ 降盘 ${asianOpen}→${asianCur}</span>` :
                       (asianOpen!=="—"||asianCur!=="—") ? `<span class="hkmo-asian-none">亚盘 ${asianOpen}→${asianCur}</span>` : "";
      html += `<div class="hkmo-card${isBothDrop?' hkmo-drop':''}" style="margin-bottom:8px">
        <div class="hkmo-head">
          <span class="oc-num">${r.num||""}</span>
          <span class="oc-league">${r.league||""}</span>
          <span class="oc-teams">${r.home||""} vs ${r.away||""}</span>
          <span class="oc-kick">${r.kickoff||""}</span>
          ${isBothDrop?`<span class="hkmo-drop-tag">⚠️ 双方同时降水 ${commonDirText}</span>`:""}
          ${asianTag}
        </div>
        <div class="hkmo-srctime">
          <span>🇭🇰 香港源数据: ${hkCur.time||"—"}</span>
          <span>🇲🇴 澳门源数据: ${moCur.time||"—"}</span>
          <span>抓取时间: ${r.fetched_at||"-"}</span>
        </div>
        <div class="hkmo-table">
          <div class="hkmo-row hkmo-header">
            <div class="hkmo-col hkmo-dir">方向</div>
            <div class="hkmo-col">🇭🇰 香港马会 初→现</div>
            <div class="hkmo-col">🇲🇴 澳门彩票 初→现</div>
            <div class="hkmo-col">香港降水</div>
            <div class="hkmo-col">澳门降水</div>
          </div>
          ${["h","d","a"].map(k=>{
            const hkDrop = (hk.drop_dirs||[]).includes(k);
            const moDrop = (mo.drop_dirs||[]).includes(k);
            return `<div class="hkmo-row">
            <div class="hkmo-col hkmo-dir"><b>${dirName[k]}</b></div>
            <div class="hkmo-col">${oddsCell(hkOpen[k], hkCur[k])}</div>
            <div class="hkmo-col">${oddsCell(moOpen[k], moCur[k])}</div>
            <div class="hkmo-col">${hkDrop?'<span style="color:var(--bad);font-weight:700">↓降水</span>':'—'}</div>
            <div class="hkmo-col">${moDrop?'<span style="color:var(--bad);font-weight:700">↓降水</span>':'—'}</div>
          </div>`;
          }).join("")}
        </div>
        <div class="hkmo-hist-resultbar">
          <span>赛果:</span>
          <span class="res-score">${r.result||"—"}</span>
          <span style="color:var(--weak)">|</span>
          <span>推荐方向:</span>
          <span class="res-pick">${pickDir?dirName[pickDir]||pickDir:"—"}</span>
          <span style="color:var(--weak)">|</span>
          <span class="hkmo-hist-flag ${hitClass}">${hitText}</span>
        </div>
        ${(()=>{
          const hhadV = r.hhadVerdict || {};
          const asianV = r.asianVerdict || {};
          const hhadDir = hhadV.dir || "";
          const hhadGoal = hhadV.goal != null ? hhadV.goal : "";
          const hhadType = hhadV.t || "good";
          const hhadDirName = {h:"让胜",d:"让平",a:"让负"}[hhadDir] || hhadDir;
          const hhadDisplay = hhadDirName;
          // 竞彩让球数格式化
          let hgoalText = hhadGoal;
          try {
            const gv = parseInt(hhadGoal);
            if(gv < 0) hgoalText = `让${Math.abs(gv)}球`;
            else if(gv > 0) hgoalText = `受让${gv}球`;
            else hgoalText = "平手";
          } catch(e) {}
          const hhadHit = r.hhadHit || "";
          const hhadHitClass = hhadHit==="hit"?"hkmo-hit":(hhadHit==="miss"?"hkmo-miss":"hkmo-na");
          const hhadHitText = hhadHit==="hit"?"✓命中":(hhadHit==="miss"?"✗错误":"待开奖");
          const hhadStars = hhadV.stars || 0;
          const hhadStarText = hhadStars > 0 ? "★".repeat(hhadStars) + "☆".repeat(5-hhadStars) : "";
          const asianDir = asianV.dir || "";
          const asianLine = asianV.asianLine || "";
          const asianStars = asianV.stars || 0;
          const asianStarText = asianStars > 0 ? "★".repeat(asianStars) + "☆".repeat(5-asianStars) : "";
          // 亚指盘口推荐转换为让球/受让表述
          let asianRecText = "-";
          if(asianLine && asianDir){
            const homeIsUpper = !asianLine.startsWith("受") && !asianLine.startsWith("客");
            const lineClean = asianLine.replace(/^受/,"").replace(/^客/,"");
            if(asianDir === "d"){
              asianRecText = "走水";
            } else if(homeIsUpper){
              asianRecText = asianDir === "h" ? `主队让${lineClean}` : `客队受让${lineClean}`;
            } else {
              asianRecText = asianDir === "h" ? `客队让${lineClean}` : `主队受让${lineClean}`;
            }
          } else if(asianDir){
            asianRecText = {h:"上盘",d:"走水",a:"下盘"}[asianDir] || asianDir;
          }
          const asianHit = r.asianHit || "";
          const asianHitClass = asianHit==="hit"?"hkmo-hit":(asianHit==="miss"?"hkmo-miss":"hkmo-na");
          const asianHitText = asianHit==="hit"?"✓命中":(asianHit==="miss"?"✗错误":(asianHit==="n-a"?"走水":"待开奖"));
          if(!hhadDir && !asianDir) return "";
          return `<div class="hkmo-hist-picksbar">
            ${hhadDir?`<span class="hkmo-hist-pick">
              <span class="hkmo-hist-pick-label">竞彩让球胜平负</span>
              <span class="hkmo-hist-pick-val">${hgoalText!=""?hgoalText+" ":""}${hhadDisplay}</span>
              ${hhadStarText?`<span style="color:var(--warn);font-size:12px;margin:0 4px">${hhadStarText}</span>`:""}
              <span class="hkmo-hist-flag ${hhadHitClass}">${hhadHitText}</span>
            </span>`:""}
            ${asianDir?`<span class="hkmo-hist-pick">
              <span class="hkmo-hist-pick-label">亚指盘口</span>
              <span class="hkmo-hist-pick-val">${asianLine?asianLine+" ":""}${asianRecText}</span>
              ${asianStarText?`<span style="color:var(--warn);font-size:12px;margin:0 4px">${asianStarText}</span>`:""}
              <span class="hkmo-hist-flag ${asianHitClass}">${asianHitText}</span>
            </span>`:""}
          </div>`;
        })()}
      </div>`;
    });
    html += `</div>`;
  });
  list.innerHTML = html;
}

/* ---------- 高倍串关 ---------- */
/* ---------- 串关 legs 渲染（推荐与不推荐共用，确保不推荐也展示完整赛程） ---------- */
function parlayLegsHtml(legs){
  if(!legs || !legs.length) return "";
  return `<div class="ho-legs">` + legs.map((leg,i)=>{
    const conf = leg.confidence || 0;
    const reasons = leg.reasons || [];
    const reasonsHtml = reasons.map(r=>`<span style="display:inline-block;background:var(--bg);padding:1px 6px;border-radius:4px;font-size:10px;margin-right:4px;color:var(--sub)">${r}</span>`).join("");
    // 历史同指徽标（免费自建，竞彩官方赛果库）：绿=价值 / 红=偏冷陷阱 / 黄=中性
    const so = leg.sameOddsHit, son = leg.sameOddsN || 0;
    let soBadge = "";
    if(so != null && son >= 5){
      const soc = so >= 60 ? "var(--good)" : (so < 45 ? "var(--bad)" : "var(--warn)");
      const sot = so >= 60 ? "同指价值" : (so < 45 ? "同指偏冷" : "同指中性");
      soBadge = `<span style="display:inline-block;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:6px;color:${soc};border:1px solid ${soc};">${sot} ${so}%(n=${son})</span>`;
    }
    // 五维雷达徽标（已接线，真实输出）
    const fd = leg.fiveDim;
    let fdBadge = (fd != null) ? `<span style="display:inline-block;padding:1px 6px;border-radius:4px;font-size:10px;margin-left:4px;color:var(--accent);border:1px solid var(--accent);">五维 ${fd}分</span>` : "";
    const oddsTxt = (typeof leg.odds === "number") ? leg.odds.toFixed(2) : (leg.odds || "—");
    const ko = leg.kickoff ? String(leg.kickoff).slice(0,5) : "";
    return `<div class="ho-leg">
      <div class="ho-num">第${i+1}场<br><span style="font-size:9px">${leg.num||""}</span></div>
      <div>
        <div class="ho-match"><span class="ho-league">${leg.league||""}</span>${leg.home||""} vs ${leg.away||""}</div>
        <div class="ho-pick">${leg.play||""} · <b style="color:var(--good)">${leg.label||""}</b> · 信心<b style="color:var(--good)">${conf}%</b>${soBadge}${fdBadge}</div>
        <div style="margin-top:3px">${reasonsHtml}</div>
      </div>
      <div class="ho-odds" style="color:var(--good)">${oddsTxt}<small>@${ko}</small></div>
    </div>`;
  }).join("") + `</div>`;
}

function renderHighOdds(){
  const ho = state.highOddsParlay || {};
  const sp = state.safeParlay || {};
  const ph = state.parlayHistory || {};
  const summary = $("#highOddsSummary");
  const list = $("#highOddsList");
  const bdg = $("#highOddsBdg");

  // 历史战绩统计
  const histTotal = ph.total || 0;
  const histHit = ph.hit || 0;
  const histMiss = ph.miss || 0;
  const histPending = ph.pending || 0;
  const histRate = ph.hitRate || 0;
  const recentRate = ph.recent7Rate || 0;
  const histRecords = ph.records || [];

  let html = "";
  let spCand;

  // ===== 历史战绩区域（顶部） =====
  html += `<div class="ho-card" style="background:linear-gradient(135deg, rgba(82,196,26,0.08), rgba(82,196,26,0.03));border-left:3px solid var(--good);">
    <div class="ho-head">
      <span class="ho-type" style="color:var(--good)">📊 串关历史战绩</span>
      <span style="font-size:12px;color:var(--sub)">回查已完场比赛命中情况</span>
    </div>
    <div style="display:flex;gap:16px;flex-wrap:wrap;margin:12px 0;">
      <div style="flex:1;min-width:80px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;">
        <div style="font-size:22px;font-weight:700;color:var(--good)">${histRate}%</div>
        <div style="font-size:11px;color:var(--sub)">总命中率</div>
      </div>
      <div style="flex:1;min-width:80px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;">
        <div style="font-size:22px;font-weight:700;color:var(--accent)">${recentRate}%</div>
        <div style="font-size:11px;color:var(--sub)">近7天命中率</div>
      </div>
      <div style="flex:1;min-width:80px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;">
        <div style="font-size:22px;font-weight:700">${histHit}/${histHit+histMiss}</div>
        <div style="font-size:11px;color:var(--sub)">命中/已赛</div>
      </div>
      <div style="flex:1;min-width:80px;text-align:center;padding:8px;background:var(--bg);border-radius:8px;">
        <div style="font-size:22px;font-weight:700;color:var(--warn)">${histPending}</div>
        <div style="font-size:11px;color:var(--sub)">待赛场次</div>
      </div>
    </div>`;

  // ===== 历史记录：按日期查看（日期下拉「选项」+ 快捷按钮） =====
  const phDates = [...new Set(histRecords.map(r=> (r.date||"")).filter(Boolean))].sort().reverse();
  const phCount = {};
  histRecords.forEach(r=>{ const d=r.date||""; if(d) phCount[d]=(phCount[d]||0)+1; });
  const _pickDate = (state.parlayDate && state.parlayDate!=="all");
  const viewRecs = _pickDate
      ? histRecords.filter(r => (r.date||"")===state.parlayDate).slice().sort((a,b)=> (a.savedAt||"").localeCompare(b.savedAt||""))
      : histRecords.slice().sort((a,b)=> (b.savedAt||"").localeCompare(a.savedAt||""));
  if(histRecords.length > 0){
    // 主「选项」：单一下拉框，选中某一天即看当天全部推荐
    let dateOpts = `<option value="all">📅 全部日期（${histRecords.length} 组）</option>`;
    phDates.forEach(dt=>{ dateOpts += `<option value="${dt}"${_pickDate&&state.parlayDate===dt?" selected":""}>${dt}（${phCount[dt]} 组）</option>`; });
    // 快捷按钮（备选）
    let chipHtml = `<button class="sp-chip pdate-chip ${!_pickDate?'on':''}" data-pdate="all">全部</button>`;
    phDates.forEach(dt=>{ chipHtml += `<button class="sp-chip pdate-chip ${_pickDate&&state.parlayDate===dt?'on':''}" data-pdate="${dt}">${dt.slice(5)}</button>`; });
    html += `<div id="parlayDateFilterWrap" style="margin:10px 0 6px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <label for="parlayHistDate" style="font-size:12.5px;color:var(--text);font-weight:600;">选择日期：</label>
      <select id="parlayHistDate" class="pdate-select" style="font-size:13px;padding:6px 10px;border:1px solid var(--accent);border-radius:8px;background:var(--card);color:var(--text);font-weight:600;cursor:pointer;">${dateOpts}</select></div>
      <div style="margin:0 0 6px;display:flex;gap:6px;flex-wrap:wrap;">${chipHtml}</div>
      <div style="margin:0 0 8px;font-size:10.5px;color:var(--sub);line-height:1.6;">📦 以下为历史存档：早期发布过的「搏击 / 狂击」档位因长期无数据支撑（23 战 0 中）已永久下线，记录仅作赛果回溯，不再发布新推荐；当前在档位为 🛡️稳健 / ⚖️均衡 / 💎精锐。</div>`;
    if(viewRecs.length > 0){
      const dateLabel = _pickDate ? `📅 ${state.parlayDate} 推荐（${viewRecs.length} 组，按发布时间排序）` : `全部日期 · 共 ${histRecords.length} 组（按发布时间倒序，点击展开查看每场赛果和命中详情；也可用上方日期选项只看某一天）：`;
      html += `<div style="margin-top:8px;"><div style="font-size:12px;color:var(--sub);margin-bottom:6px;">${dateLabel}</div><div style="max-height:360px;overflow-y:auto;">`;
      viewRecs.forEach((r,idx)=>{
      const resultColor = r.result==="hit"?"var(--good)":r.result==="miss"?"var(--bad)":"var(--warn)";
      const resultText = r.result==="hit"?"✅ 全中":r.result==="miss"?"❌ 未中":"⏳ 待赛";
      const legs = r.legs || [];
      const legsSummary = legs.map(l=>{
        const lh = l.legHit;
        const lc = lh===true?"var(--good)":lh===false?"var(--bad)":"var(--sub)";
        const li = lh===true?"✓":lh===false?"✗":"·";
        // 内联证据（v1.7.25）：每条推荐腿都带「同指命中率+信心」，历史可逐条核对，杜绝「随便堆」观感
        const so = l.sameOddsHit, son = l.sameOddsN || 0;
        const soTxt = (so!=null && son>=5) ? `同指${so}%(n=${son})` : "";
        const confTxt = (l.confidence!=null) ? `信心${l.confidence}%` : "";
        const evTxt = [soTxt, confTxt].filter(Boolean).join(" · ");
        return `<span style="color:${lc};font-size:10.5px;">${li}${l.num||""}${l.label||""}${evTxt?` <span style="color:var(--sub);font-size:9.5px;">(${evTxt})</span>`:""}</span>`;
      }).join(" ");
      html += `<div style="padding:8px;border-bottom:1px solid var(--border);">
        <div style="display:flex;justify-content:space-between;align-items:center;cursor:pointer;" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'block':'none'">
          <span style="font-size:11.5px;color:var(--sub);">${r.date||""} <b style="color:var(--text)">${r.type||""}</b>${r.recommended===false?' <span style="color:var(--bad);font-size:10px;border:1px solid var(--bad);border-radius:3px;padding:0 3px;margin-left:2px;">不推荐</span>':''}</span>
          <span style="display:flex;align-items:center;gap:8px;">
            <span style="color:var(--accent);font-weight:600;font-size:12px;">${r.totalOdds||0}倍</span>
            <span style="color:${resultColor};font-weight:600;font-size:11px;">${resultText}</span>
          </span>
        </div>
        <div style="margin-top:4px;font-size:10.5px;">${legsSummary}</div>
        <div style="display:none;margin-top:6px;padding-top:6px;border-top:1px dashed var(--border);">`;
      legs.forEach(l=>{
        const lh = l.legHit;
        const lc = lh===true?"var(--good)":lh===false?"var(--bad)":"var(--sub)";
        const li = lh===true?"✓命中":lh===false?"✗未中":"·待赛";
        const scoreText = l.actualScore ? `<span style="color:var(--sub)">赛果 ${l.actualScore}</span>` : `<span style="color:var(--warn)">待开赛</span>`;
        const adjText = l.adjScore ? `<span style="color:var(--sub)">${l.adjScore}</span>` : "";
        html += `<div style="display:flex;justify-content:space-between;align-items:center;padding:3px 0;font-size:10.5px;">
          <span><b style="color:${lc}">${li}</b> ${l.num||""} ${l.home||""}vs${l.away||""}</span>
          <span style="text-align:right;">
            <span style="color:var(--accent)">${l.play||""} ${l.label||""} @${l.odds||""}</span><br>
            ${scoreText} ${adjText}
          </span>
        </div>`;
      });
      html += `</div></div>`;
    });
      html += `</div></div>`;
    } else {
      html += `<div class="empty">该日期暂无串关历史推荐</div>`;
    }
  }
  html += `</div>`;

  // ===== 稳胆串关（高命中率版） =====
  if(sp){
    spCand = sp.candidateCount || 0;
    if(bdg) bdg.textContent = spCand > 99 ? "99+" : spCand;
    html += `<div style="margin:16px 0 8px;font-size:13px;font-weight:600;color:var(--good);">🎯 分层串关：稳健 / 均衡 / 精锐（单场单意见：同一场比赛全天一个说法，三档只在意见池内组合，差异只在选不选它、拼几场；赔率单调：三档按稳健→均衡→精锐顺序构建，每档总赔必须高于上一档，杜绝4串比3串赔得少的倒挂；各档在自身赔率区间内取「联合命中率+EV」最优，拒绝蚊子肉也拒绝纯高倍；已叠加历史同指命中率与五维雷达评分交叉验证）</div>
    <div style="margin:0 0 10px;padding:10px 12px;background:var(--bg);border:1px dashed var(--border);border-radius:8px;font-size:11.5px;color:var(--sub);line-height:1.7;">
      <b style="color:var(--text)">三个问题看懂串关（很重要）：</b><br>
      ① <b style="color:var(--text)">EV（期望值）是什么</b>：EV = 联合命中概率 × 总赔率 − 1。EV −12% 的意思是：同样条件下长期平均，每花 100 元亏 12 元。<b style="color:var(--text)">注意单注与长期的区别</b>：任何一注的结果只有两种——全中（按总赔率收钱）或不中（亏掉本金），不存在「亏 12%」的中间态；EV 说的是「同样打法重复很多次的平均结果」，不排除你这一注全中。<b style="color:var(--bad)">EV 为负 = 长期必亏，没有哪一档「更值得推荐」，区别只在长期平均亏得多与亏得少。</b><br>
      ② <b style="color:var(--text)">为什么都在说抽水</b>：竞彩单场返奖率约 88.6%（庄家抽水 11.4%），串关的抽水按腿数复合放大——2串1约 21.6%、3串1约 30.6%、4串1约 38.5%。<b style="color:var(--text)">串得越多，抽水越狠</b>，这就是多串1更难盈利的根本原因。<br>
      ③ <b style="color:var(--text)">怎么才能提高命中</b>：串关命中率 = 各腿概率相乘。每腿 70% → 3串1只剩 34.3%；每腿 80% → 51.2%。<b style="color:var(--text)">提高命中的唯一办法是选概率更高的腿（赔率更低、回报更少）</b>——高命中与高回报不可兼得，这是串关的本质矛盾。低赔「蚊子肉」腿命中高但回报薄，高赔腿回报厚但拉低联合命中率，各档的赔率区间就是在这个矛盾上取平衡。
    </div>`;
    // 四档均无达标组合（EV 全部低于档位门槛）：诚实提示，避免空档像故障
    if(!(sp.parlay2 || sp.parlay3 || sp.parlay4)){
      html += `<div class="ho-card" style="border-left:3px solid var(--warn);">
        <div class="ho-head"><span class="ho-type" style="color:var(--warn)">ℹ️ 今日无达标串关组合</span></div>
        <div style="margin:8px 0 2px;font-size:12px;color:var(--sub)">候选 <b>${spCand}</b> 个，但任意组合期望值 EV 均低于档位门槛（串关抽水按场数放大：2串1约21.6%、3串1约30.6%），数学上长期必亏，<b>不推荐下注</b>。可关注单场「稳胆」推荐。</div>
      </div>`;
    }
    // 部分档位留空（v1.7.25 赔率单调 + 单场单意见后，候选不足的档位不再硬凑）：
    // 如实说明哪档缺席、为什么，避免用户误以为页面故障或「推荐不完整」
    {
      const _missing = [["parlay2","稳健2串1"],["parlay3","均衡3串1"],["parlay4","精锐4串1"]]
        .filter(([k])=>!sp[k]).map(([,lb])=>lb);
      const _present = [["parlay2","稳健2串1"],["parlay3","均衡3串1"],["parlay4","精锐4串1"]]
        .filter(([k])=>sp[k]).map(([,lb])=>lb);
      if(_missing.length && _present.length && sp.poolNotes && sp.poolNotes.length){
        html += `<div class="ho-card" style="border-left:3px solid var(--warn);margin-bottom:10px;">
          <div class="ho-head"><span class="ho-type" style="color:var(--warn)">ℹ️ 今日仅 ${_present.join(" / ")} 达标</span></div>
          <div style="margin:8px 0 2px;font-size:12px;color:var(--sub);line-height:1.7;">
            <b style="color:var(--text)">${_missing.join(" / ")} 今日无达标组合</b>，按「留空不硬凑」原则不出档——宁可少一档，也不为凑数塞入弱腿或制造倒挂。<br>
            ${sp.poolNotes.map(n=>`· ${n}`).join("<br>")}
          </div>
        </div>`;
      }
    }
    // ===== 分层串关展示策略（少而精，杜绝「推荐一大堆、什么方向都有」）=====
    // 只有「正期望」档位算推荐：串关抽水按场数放大（2串1约21.6%、3串1约30.6%），
    // EV 为负的档位数学上长期必亏——默认只出一行说明，完整赛程折叠收起（仅供赛后核对）；
    // 三档全负时出一张诚实总结卡，明确告知今日不建议玩串关。
    const _TIER_DEFS = [["parlay2","🛡️ 稳健"],["parlay3","⚖️ 均衡"],["parlay4","💎 精锐"]];
    const _pos = (k)=>{ const p = sp[k]; return !!(p && p.recommended && (p.ev==null || p.ev>=0)); };
    const _recTiers = _TIER_DEFS.filter(([k])=>sp[k] && _pos(k));
    const _negTiers = _TIER_DEFS.filter(([k])=>sp[k] && !_pos(k));
    const _tierCardHtml = (p)=>{
      const ev = (p.ev==null? null : p.ev);
      const jp = (p.jointProb==null? null : p.jointProb);
      const rh = p.realHit;
      const avgConf = p.avgConfidence || 0;
      const tierColor = p.tier==="稳健"?"var(--good)":(p.tier==="均衡"?"var(--accent)":"var(--warn)");
      const evColor = ev==null?"var(--sub)":(ev>=5?"var(--good)":(ev>=-10?"var(--warn)":"var(--bad)"));
      const stake = p.suggestStake || 0;
      const stakeTxt = stake>0 ? `建议仓位 ${stake}%` : "不建议下注（负期望）";
      const negTag = (ev!=null && ev<0 && !p.recommended);
      return `<div class="ho-card" style="border-left:3px solid ${negTag?"var(--bad)":tierColor};${negTag?"margin-bottom:10px;":""}">
        <div class="ho-head">
          <span class="ho-type" style="color:${negTag?"var(--bad)":tierColor}">${negTag?"⚠️":"🛡️"} ${p.tier||""} · ${p.type}${negTag?" · <b>不推荐</b>":""}</span>
          <span class="ho-total" style="color:${negTag?"var(--bad)":tierColor}">${p.totalOdds.toFixed(2)} <small>倍总赔率</small></span>
        </div>
        ${negTag?`<div style="margin:8px 0 4px;font-size:12px;color:var(--bad)">本档最优组合期望值 <b>EV ${ev}%</b> 为负（长期平均每注亏损约 ${Math.abs(ev)}%），<b>无正期望机会，不推荐下注</b>。串关抽水按场数放大（${p.rake!=null?p.rake+"%":"—"}）。</div>`:""}
        <div style="margin-bottom:8px;font-size:11.5px;color:var(--sub)">${p.tierDesc||""}</div>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px;font-size:11.5px">
          <span>${rh!=null?`历史同指命中率 <b style="color:var(--text)">${rh}%</b>`:`预测胜率 <b style="color:var(--text)">${jp!=null?jp+"%":"—"}</b>`}</span>
          <span>期望值EV <b style="color:${evColor}">${ev!=null?(ev>0?"+":"")+ev+"%":"—"}</b></span>
          <span>抽水 <b style="color:var(--sub)">${p.rake!=null?p.rake+"%":"—"}</b></span>
          <span style="color:${stake>0?'var(--good)':'var(--bad)'}">${stakeTxt}</span>
        </div>
        <div style="margin-bottom:10px;font-size:11px;color:var(--sub)">${p.evNote||""}${avgConf?" · 平均信心 "+avgConf+"%":""}</div>
        ${parlayLegsHtml(p.legs)}
        <div class="ho-meta">
          <span>📊 最低赔率 ${p.minOdds!=null?p.minOdds.toFixed(2):"—"}</span>
          <span>📈 最高赔率 ${p.maxOdds!=null?p.maxOdds.toFixed(2):"—"}</span>
          <span>🎯 平均信心 ${avgConf}%</span>
          <span>${p.isMixed?"🔀 混合过关":"📌 单一玩法"}</span>
        </div>
      </div>`;
    };
    const _tierBtnsHtml = (tiers, barId)=> tiers.length>1
      ? `<div id="${barId}" style="margin:8px 0 10px;display:flex;gap:8px;flex-wrap:wrap;">` + tiers.map(([k,lb])=>{
          const _lg = (sp[k].legs||[]).length;
          return `<button class="sp-chip ptier-chip ${state.parlayTier===k?"on":""}" data-tier="${k}">${lb}${_lg?` · ${_lg}场`:""}</button>`;
        }).join("") + `</div>` : "";
    // 负期望详情收起区（展开状态记忆到 state，避免点档位按钮重渲染后被重置）
    const _negDetailHtml = (negDesc, note)=>{
      if(!_negTiers.length) return "";
      const showKey = _negTiers.some(([k])=>k===state.parlayTier) ? state.parlayTier : _negTiers[0][0];
      return `<div style="margin:10px 0 4px;font-size:11.5px;color:var(--sub)">${note}<a href="javascript:void(0)" onclick="state.parlayNegOpen=!state.parlayNegOpen;var _d=document.getElementById('parlayNegDetail');if(_d)_d.style.display=state.parlayNegOpen?'block':'none';this.textContent=state.parlayNegOpen?'点击收起':'点击展开查看完整赛程'" style="color:var(--accent)">${state.parlayNegOpen?"点击收起":"点击展开查看完整赛程"}</a>（仅供赛后核对，请勿下注）。</div>
      <div id="parlayNegDetail" style="display:${state.parlayNegOpen?"block":"none"};">${_tierBtnsHtml(_negTiers, "parlayNegTierBar")}${_tierCardHtml(sp[showKey])}</div>`;
    };
    if(_recTiers.length){
      // 有正期望档位 → 按钮只在正期望档位间切换，默认展示第一个
      if(!_recTiers.some(([k])=>k===state.parlayTier)) state.parlayTier = _recTiers[0][0];
      html += _tierBtnsHtml(_recTiers, "parlayTierBar");
      html += _tierCardHtml(sp[state.parlayTier]);
      if(_negTiers.length){
        const negDesc = _negTiers.map(([k,lb])=>`${lb} EV ${sp[k].ev!=null?sp[k].ev+"%":"—"}`).join(" · ");
        html += _negDetailHtml(negDesc, `另有 ${_negTiers.length} 档期望值为负（${negDesc}），长期必亏已折叠，`);
      }
    } else {
      // 四档全负 → 一张诚实总结卡，不铺开赛程
      const negDesc = _negTiers.map(([k,lb])=>`${lb} <b style="color:var(--bad)">EV ${sp[k].ev!=null?sp[k].ev+"%":"—"}</b>`).join(" · ");
      html += `<div class="ho-card" style="border-left:3px solid var(--warn);">
        <div class="ho-head"><span class="ho-type" style="color:var(--warn)">🚫 今日无正期望串关机会</span></div>
        <div style="margin:8px 0 2px;font-size:12px;color:var(--sub)">候选 <b>${spCand}</b> 个，<b>全部档位</b>最优组合期望值均为负（${negDesc}）。<b style="color:var(--text)">注意：EV 为负 = 同样打法长期平均每注亏损（单注仍可能全中，不排除运气）；长期玩必亏，档位之间没有「哪档更值得推荐」，只有长期平均亏得多与亏得少的区别，今日不建议下注任何串关。</b>串关抽水按腿数复合放大（2串1约21.6%、3串1约30.6%、4串1约38.5%）。可关注单场「稳胆」推荐。</div>
      </div>`;
      html += _negDetailHtml(negDesc, "各档完整赛程已折叠，");
    }
    // ===== 候选池透明卡（v1.7.25）=====
    // 把「今天系统从哪些比赛里挑」完整摊开：每场的唯一系统意见+赔率+信心+历史同指命中率。
    // 用户可自行核对「是不是随便堆的」——一切用数据说话。
    const _pool = sp.candidatePool || [];
    if(_pool.length){
      html += `<div class="ho-card" style="border-left:3px solid var(--accent);margin-top:10px;">
        <div class="ho-head">
          <span class="ho-type" style="color:var(--accent)">🧾 今日候选池（${_pool.length} 场）</span>
          <span style="font-size:11px;color:var(--sub)">三档都只在这些比赛及其系统意见内组合</span>
        </div>
        <div style="font-size:11px;color:var(--sub);margin:6px 0 8px;line-height:1.6;">
          每场比赛全天只有一个「系统意见」（历史同指命中率优先，叠加 EV/信心/技术信号评分选出）；同指命中率来自竞彩官方赛果库同赔率/同盘口条件的历史实战统计，样本 &lt;10 不作依据。
        </div>
        <div style="max-height:280px;overflow-y:auto;">` + _pool.map(c=>{
          const so = c.sameOddsHit, son = c.sameOddsN || 0;
          const soTxt = (so!=null && son>=10) ? `同指 <b style="color:${so>=60?"var(--good)":(so<45?"var(--bad)":"var(--warn)")}">${so}%</b>(n=${son})` : (son>0 ? `同指样本不足(n=${son})` : "无同指样本");
          return `<div style="display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:1px dashed var(--border);font-size:11.5px;">
            <span>${c.num||""} ${c.home||""} vs ${c.away||""}<br><span style="color:var(--sub);font-size:10.5px;">${c.play||""} · <b style="color:var(--good)">${c.label||""}</b></span></span>
            <span style="text-align:right;">
              <span style="color:var(--accent);font-weight:600;">@${(c.odds!=null?Number(c.odds).toFixed(2):"—")}</span><br>
              <span style="color:var(--sub);font-size:10px;">信心${c.confidence!=null?c.confidence:"—"}% · ${soTxt}</span>
            </span>
          </div>`;
        }).join("") + `</div>
      </div>`;
    }
  }

  // ===== 高倍串关已移除，只保留稳胆串关 =====
  if(summary && sp && (sp.parlay2 || sp.parlay3 || sp.parlay4)){
    spCand = sp.candidateCount || 0;
    const genAt = sp.generatedAt || "";
    const legNote = sp.legNote || "";
    summary.innerHTML = `候选 <b style="color:var(--good)">${spCand}</b> 个 · 生成时间 ${genAt} · <span style="color:var(--sub)">${legNote}</span>`;
  }

  if(list) list.innerHTML = html;
}

/* ============ 高手推荐渲染 ============ */
function renderFD(){
  const list = $("#fdList");
  const summary = $("#fdSummary");
  if(!list) return;
  const fd = BUILT_FD || {matches:[]};
  const ms = fd.matches || [];
  const bdg = $("#fdBdg");
  if(bdg){ bdg.textContent = ms.length; }
  if(summary){
    summary.textContent = `共 ${ms.length} 场（football-data.org 官方源${fd.enabled ? "已启用" : "未启用"}，窗口 ${fd.dateFrom||"-"} ~ ${fd.dateTo||"-"}，更新于 ${fd.updatedAt||"-"}）${fd.note?(" · "+fd.note):""}`;
  }
  if(!ms.length){
    list.innerHTML = `<div class="empty">当前暂无 football-data.org 赛事数据${fd.note?("（"+fd.note+"）"):""}</div>`;
    return;
  }
  const statusName = {SCHEDULED:"未开赛", LIVE:"进行中", IN_PLAY:"进行中", PAUSED:"中场", FINISHED:"已结束", POSTPONED:"延期", SUSPENDED:"暂停", CANCELLED:"取消"};
  const winnerName = {HOME:"主胜", DRAW:"平局", AWAY:"客胜"};
  const groups = {};
  ms.forEach(m=>{ const k = m.league || m.competition || "其他"; (groups[k] = groups[k] || []).push(m); });
  let html = "";
  Object.keys(groups).forEach(lg=>{
    html += `<div class="fd-group"><div class="fd-group-title">${lg}（${groups[lg].length}）</div>`;
    groups[lg].forEach(m=>{
      const sc = m.score || {};
      const hs = sc.home==null ? "-" : sc.home, as = sc.away==null ? "-" : sc.away;
      const w = m.winner || null;
      const wTag = w ? `<span class="fd-winner">${winnerName[w]||""}</span>` : "";
      const matched = m.num ? `<span class="fd-num">竞彩 ${m.num}</span>` : "";
      const fdScore = (m.status==="FINISHED")
        ? `<span class="fd-score">${hs} : ${as} ${wTag}</span>`
        : `<span class="fd-score ${m.status==="LIVE"||m.status==="IN_PLAY"?"fd-live":""}">${statusName[m.status]||m.status||""}</span>`;
      html += `<div class="fd-card">
        <span class="fd-comp">${m.competition||""}</span>
        <span class="fd-teams">${m.home||"?"} vs ${m.away||"?"}</span>
        ${matched}
        ${fdScore}
      </div>`;
    });
    html += `</div>`;
  });
  list.innerHTML = html;
}

