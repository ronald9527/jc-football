/* ---------- 竞彩vs北单赔率对照 ---------- */
function renderOddsCompare(){
  const list = $("#oddsCompareList");
  const sum = $("#oddsCompareSummary");
  const bdg = $("#oddsBdg");
  if(!list) return;
  const matches = (state.data||{}).matches || state.data || [];
  const matched = matches.filter(m=>m.cross && m.cross.matched);
  if(bdg) bdg.textContent = matched.length;
  // 统计盘口类型
  const spCount = matched.filter(m=>{const g=Number(m.cross.bdGoal||0);return g===0;}).length;
  const hcCount = matched.length - spCount;
  if(sum) sum.textContent = `共 ${matched.length} 场同场匹配 · 胜平负盘 ${spCount} 场 · 让球盘 ${hcCount} 场 · 更新于 ${state.meta.updateTime||"-"}`;
  if(!matched.length){
    list.innerHTML = `<div class="empty">当前暂无竞彩与北单同场匹配的赛事</div>`;
    return;
  }
  const dirName = {h:"主胜",d:"平局",a:"客胜"};
  let html = "";
  matched.forEach((m,idx)=>{
    const c = m.cross;
    const bdGoal = Number(c.bdGoal||0);
    const isHandicap = bdGoal !== 0;
    const panType = isHandicap ? "让球盘" : "胜平负盘";
    const panColor = isHandicap ? "#f0883e" : "#4da3ff";
    // 根据盘口类型选择对照数据
    let jcCur, jcOpen, jcProb, jcSup, jcGoal;
    if(isHandicap){
      jcCur = m.hhad || {};
      jcOpen = m.hhadOpen || {};
      jcProb = m.hhadProb || {};
      jcSup = m.hhadSup || {};
      jcGoal = m.hhad ? (m.hhad.goal!=null ? Number(String(m.hhad.goal).replace("+","")) : null) : null;
    } else {
      jcCur = m.had || {};
      jcOpen = m.hadOpen || {};
      jcProb = m.hadProb || {};
      jcSup = m.hadSup || {};
      jcGoal = 0;
    }
    const bdOdds = c.bdOdds || {};
    const bdProb = c.bdProb || {};
    const agreeColor = c.agree ? "var(--good)" : "var(--warn)";
    const agreeText = c.agree ? "方向一致" : "方向分歧";
    // 让球是否一致
    let goalMatchHtml = "";
    if(isHandicap){
      const same = jcGoal !== null && jcGoal === bdGoal;
      const goalColor = same ? "var(--good)" : "var(--warn)";
      const goalText = same ? "让球一致" : "让球不同";
      goalMatchHtml = `<span class="oc-goal" style="color:${goalColor}">${goalText} 竞${jcGoal!=null?jcGoal:"-"}/北${bdGoal}</span>`;
    }
    // 竞彩vs北单赔率差
    const diffCell = (k)=>{
      const j = jcCur[k]||0, b = bdOdds[k]||0;
      if(!j||!b) return `<span style="color:var(--weak)">-</span>`;
      const d = (b-j).toFixed(2);
      const color = Math.abs(b-j)>=0.3 ? "var(--bad)" : (Math.abs(b-j)>=0.15?"var(--warn)":"var(--sub)");
      return `<span style="color:${color};font-weight:600">${d>0?"+":""}${d}</span>`;
    };
    // 初盘→当前显示
    const openCurCell = (k)=>{
      const o = jcOpen[k], cur = jcCur[k];
      if(o==null||cur==null) return `<span class="num">${cur!=null?cur:"—"}</span>`;
      const d = (cur-o).toFixed(2);
      const cls = cur < o ? "in" : (cur > o ? "out" : "flat");
      const color = cls==="in"?"var(--good)":cls==="out"?"var(--bad)":"var(--sub)";
      return `<span class="num"><span style="color:var(--weak);font-weight:400">${o}</span>→<b>${cur}</b><i class="kdif" style="color:${color}">${d>0?"+":""}${d}</i></span>`;
    };
    // 让球方向名称
    const dirLabel = isHandicap ? {h:"让胜",d:"让平",a:"让负"} : dirName;
    html += `<div class="oc-card">
      <div class="oc-head">
        <span class="oc-num">${m.num||""}</span>
        <span class="oc-league">${m.league||""}</span>
        <span class="oc-teams">${m.home||""} vs ${m.away||""}</span>
        <span class="oc-kick">${m.kickoff||""}</span>
        <span class="oc-type" style="color:${panColor};background:${panColor}15">${panType}${isHandicap?`(北让${bdGoal>0?"+":""}${bdGoal})`:""}</span>
        ${goalMatchHtml}
        <span class="oc-agree" style="color:${agreeColor}">${agreeText}</span>
        ${c.asian?`<span class="oc-asian">亚盘 ${c.asian}</span>`:""}
      </div>
      <div class="oc-table oc-wide">
        <div class="oc-row oc-header">
          <div class="oc-col oc-dir">方向</div>
          <div class="oc-col">竞彩初盘</div>
          <div class="oc-col">竞彩当前</div>
          <div class="oc-col">初→现变动</div>
          <div class="oc-col">北单赔率</div>
          <div class="oc-col">竞vs北差</div>
          <div class="oc-col">竞彩概率</div>
          <div class="oc-col">北单概率</div>
          <div class="oc-col">竞彩支持率</div>
        </div>
        ${["h","d","a"].map(k=>`
        <div class="oc-row">
          <div class="oc-col oc-dir"><b>${dirLabel[k]}</b></div>
          <div class="oc-col">${jcOpen[k]!=null?jcOpen[k]:"-"}</div>
          <div class="oc-col"><b>${jcCur[k]||"-"}</b></div>
          <div class="oc-col">${openCurCell(k)}</div>
          <div class="oc-col">${bdOdds[k]||"-"}</div>
          <div class="oc-col">${diffCell(k)}</div>
          <div class="oc-col">${jcProb[k]?jcProb[k]+"%":"-"}</div>
          <div class="oc-col">${bdProb[k]?bdProb[k]+"%":"-"}</div>
          <div class="oc-col">${jcSup[k]?jcSup[k]+"%":"-"}</div>
        </div>`).join("")}
      </div>
    </div>`;
  });
  list.innerHTML = html;
}
$("#copyUrlBtn").addEventListener("click", ()=>{
  const url = $("#pageUrl").textContent || location.href;
  const done = ()=>{ const t=$("#toast"); t.textContent="链接已复制，请到系统浏览器粘贴打开后添加到主屏幕"; t.classList.add("show"); clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),4500); };
  if (navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(url).then(done).catch(()=>fallbackCopy(url, done));
  } else { fallbackCopy(url, done); }
});
/* ---------- 最新数据按钮 + 自动检测新版（固定链接模式） ---------- */
let __remoteVer = null;
let __lastRealtimeFetch = null;
let __realtimeFetching = false;

/* 实时刷新数据：直接fetch matches.json，动态更新state.data，不需要刷新页面 */
const __cacheBust = ()=>"_t="+Date.now()+"_r="+Math.random().toString(36).slice(2,8);
function __hardReload(){
  const url = location.href.split("?")[0] + "?" + __cacheBust();
  location.replace(url);
}
function refreshRealtimeData(showTip){
  if(__realtimeFetching) return;
  __realtimeFetching = true;
  if(showTip){ const t=$("#toast"); t.textContent="正在拉取最新数据…"; t.classList.add("show"); }
  fetch("matches.json?"+__cacheBust(), {cache:"no-store"}).then(r=>{ if(!r.ok) throw 0; return r.json(); }).then(d=>{
    const newMatches = d.matches || d || [];
    const newUpdateTime = d.updateTime || "";
    const curUpdateTime = state.meta.updateTime || "";
    if(newUpdateTime && newUpdateTime !== curUpdateTime){
      // 数据有更新，替换state.data
      state.data = JSON.parse(JSON.stringify(newMatches));
      state.meta.updateTime = newUpdateTime;
      if(d.highOddsParlay){ state.highOddsParlay = JSON.parse(JSON.stringify(d.highOddsParlay)); }
      if(d.safeParlay){ state.safeParlay = JSON.parse(JSON.stringify(d.safeParlay)); }
      if(d.parlayHistory){ state.parlayHistory = JSON.parse(JSON.stringify(d.parlayHistory)); }
      if(d.strongWeak){ state.strongWeak = JSON.parse(JSON.stringify(d.strongWeak)); }
      if(d.strongWeakHistory){ state.strongWeakHistory = JSON.parse(JSON.stringify(d.strongWeakHistory)); }
      if(d.halfFull){ state.halfFull = JSON.parse(JSON.stringify(d.halfFull)); }
      if(d.halfFullHistory){ state.halfFullHistory = JSON.parse(JSON.stringify(d.halfFullHistory)); }
      if(d.expert){ state.expert = JSON.parse(JSON.stringify(d.expert)); }
      if(d.expertHistory){ state.expertHistory = JSON.parse(JSON.stringify(d.expertHistory)); }
      __lastRealtimeFetch = new Date().toLocaleString("zh-CN");
      // 重新渲染当前页面
      const curTab = state.tab;
      if(curTab==="today"){ renderStats(); renderFocus(); renderFilters(); renderCards(); renderTable(); }
      else if(curTab==="history"){ renderHistory(); }
      else if(curTab==="bd"){ renderBD(); }
      else if(curTab==="strongweak"){ renderStrongWeak(); }
      else if(curTab==="hkmo"){ renderHKMO(); }
      else if(curTab==="highodds"){ renderHighOdds(); }
      else if(curTab==="halffull"){ renderHalfFull(); }
      else if(curTab==="expert"){ renderExpert(); }
      else if(curTab==="fd"){ renderFD(); }
      // 更新角标
      $("#todayBdg").textContent = state.data.length;
      const swBdg = $("#swBdg");
      if(swBdg){ swBdg.textContent = (state.strongWeak && state.strongWeak.count) || 0; }
      const hfBdg = $("#hfBdg");
      if(hfBdg){ hfBdg.textContent = (state.halfFull && state.halfFull.count) || 0; }
      if(showTip){
        const t=$("#toast"); t.textContent="✅ 已更新至 "+newUpdateTime.slice(5,16)+"（"+state.data.length+"场）"; t.classList.add("show");
        clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),4000);
      }
    } else {
      __lastRealtimeFetch = new Date().toLocaleString("zh-CN");
      if(showTip){
        const t=$("#toast"); t.textContent="当前已是最新数据（"+curUpdateTime.slice(5,16)+"）"; t.classList.add("show");
        clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),3000);
      }
    }
    __realtimeFetching = false;
  }).catch(()=>{
    __realtimeFetching = false;
    if(showTip){
      const t=$("#toast"); t.textContent="拉取失败，正在强制刷新页面…"; t.classList.add("show");
      clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),3000);
      setTimeout(__hardReload, 800);
    }
  });
}

function checkNewVersion(showTip){
  if(!window.fetch) return;
  fetch("version.json?"+__cacheBust(), {cache:"no-store"}).then(r=>{ if(!r.ok) throw 0; return r.json(); }).then(v=>{
    __remoteVer = v;
    const cur = state.meta.updateTime || "";
    const newer = v.updateTime && v.updateTime > cur;
    if(newer){
      // 有新版本，直接实时刷新数据，不刷新页面
      refreshRealtimeData(false);
      if(showTip){
        const t=$("#toast"); t.textContent="检测到新数据，已自动更新"; t.classList.add("show");
        clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),4000);
      }
    } else if(showTip){
      const t=$("#toast"); t.textContent="当前已是最新数据"; t.classList.add("show");
      clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),3000);
    }
  }).catch(()=>{ if(showTip){ const t=$("#toast"); t.textContent="已是最新（当前页面）"; t.classList.add("show"); clearTimeout(window.__toastT); window.__toastT=setTimeout(()=>t.classList.remove("show"),3000);} });
}
function openFreshModal(){
  const mask = $("#freshMask");
  const tip = $("#freshTip");
  const steps = $("#freshSteps");
  $("#freshUrl").textContent = "https://jc-football-1eo.pages.dev/";
  const upd = state.meta.updateTime || "";
  const now = new Date();
  const nb = nextBatch(now);
  const nextLabel = (()=>{ const b=nb>86400?nb-86400:nb; return String(Math.floor(b/3600)).padStart(2,"0")+":"+String(Math.floor(b%3600/60)).padStart(2,"0"); })();
  tip.innerHTML = `本页数据更新于 <b>${upd.slice(0,16)}</b>。云端每天 ${BATCH_LABEL} 自动更新并部署到<b>同一链接</b>，你打开即最新，无需换链接。`;
  steps.innerHTML = `<div class="istep"><span class="ino">1</span><span>点下面<b>刷新页面</b>，立即拉取云端最新数据</span></div>
    <div class="istep"><span class="ino">2</span><span>最近一批将在 <b>今日 ${nextLabel}</b> 自动更新，之后点刷新即可</span></div>
    <div class="istep"><span class="ino">3</span><span>固定链接 jc-football-1eo.pages.dev，建议收藏或添加到主屏幕</span></div>`;
  $("#copyFreshBtn").textContent = "刷新页面";
  $("#copyFreshBtn").onclick = ()=>{ __hardReload(); };
  mask.classList.add("show");
  checkNewVersion(false);
}
$("#freshBtn").addEventListener("click", ()=>{
  // App 内：通知原生壳立即拉一次线上数据与页面（网页端无此对象，自动忽略）
  const bust = __cacheBust();
  try{ if(window.AndroidSync && AndroidSync.syncNow) AndroidSync.syncNow(bust); }catch(e){}
  refreshRealtimeData(true);
});
$("#closeFresh").addEventListener("click", ()=>$("#freshMask").classList.remove("show"));
$("#freshMask").addEventListener("click", e=>{ if(e.target.id==="freshMask") $("#freshMask").classList.remove("show"); });
/* 每2分钟实时刷新数据（直接fetch matches.json，不刷新页面）；每5分钟检测版本 */
setInterval(()=>refreshRealtimeData(false), 120000);
setInterval(()=>checkNewVersion(false), 300000);
setTimeout(()=>refreshRealtimeData(false), 5000);
/* 页面加载 8 秒后比对版本：若云端数据比本页更新超过 10 分钟，说明本页被缓存，强制刷新 */
setTimeout(()=>{
  if(!window.fetch) return;
  fetch("version.json?"+__cacheBust(), {cache:"no-store"}).then(r=>r.json()).then(v=>{
    const cur = state.meta.updateTime || "";
    if(v && v.updateTime && cur && v.updateTime > cur){
      const t1 = new Date(cur.replace(" ","T")).getTime();
      const t2 = new Date(v.updateTime.replace(" ","T")).getTime();
      if(!isNaN(t1) && !isNaN(t2) && (t2 - t1) > 10*60*1000){
        const toast = $("#toast");
        if(toast){ toast.textContent="检测到云端有新版本，正在刷新…"; toast.classList.add("show"); }
        setTimeout(__hardReload, 1200);
      }
    }
  }).catch(()=>{});
}, 8000);
function fallbackCopy(text, cb){
  try{
    const ta = document.createElement("textarea");
    ta.value = text; ta.style.position="fixed"; ta.style.opacity="0";
    document.body.appendChild(ta); ta.select();
    document.execCommand("copy"); document.body.removeChild(ta); cb();
  }catch(e){ const t=$("#toast"); t.textContent="复制失败，请长按链接手动复制: " + text; t.classList.add("show"); }
}
$("#importBtn").addEventListener("click", ()=>{ $("#importStatus").textContent=""; $("#modalMask").classList.add("show"); });
$("#closeModal").addEventListener("click", ()=>$("#modalMask").classList.remove("show"));
$("#modalMask").addEventListener("click", e=>{ if(e.target.id==="modalMask") $("#modalMask").classList.remove("show"); });
$("#applyImport").addEventListener("click", applyImport);
$("#pickFile").addEventListener("click", ()=>$("#fileInput").click());
$("#fileInput").addEventListener("change", e=>{
  const f = e.target.files[0]; if(!f) return;
  const rd = new FileReader();
  rd.onload = ()=>{ $("#importArea").value = rd.result; $("#applyImport").click(); };
  rd.readAsText(f, "utf-8");
});
document.addEventListener("keydown", e=>{ if(e.key==="Escape") $("#modalMask").classList.remove("show"); });

/* ---------- 登录验证 ---------- */
const AUTH_USER = "admin";
const AUTH_PASS = "512049996";
function checkLogin(){
  try{ return localStorage.getItem("jc_logged_in") === "1"; }catch(e){ return false; }
}
function showLogin(){
  $("#loginMask").classList.add("show");
  document.body.style.overflow = "hidden";
  $("#loginUser").value = "";
  $("#loginPass").value = "";
  $("#loginErr").textContent = "";
  setTimeout(()=>$("#loginUser").focus(), 100);
}
function doLogin(){
  const u = $("#loginUser").value.trim();
  const p = $("#loginPass").value;
  if(u === AUTH_USER && p === AUTH_PASS){
    try{ localStorage.setItem("jc_logged_in", "1"); }catch(e){}
    $("#loginMask").classList.remove("show");
    document.body.style.overflow = "";
    $("#logoutBtn").style.display = "flex";
    return true;
  }
  $("#loginErr").textContent = "账号或密码错误，请重试";
  $("#loginPass").value = "";
  return false;
}
$("#loginSubmit").addEventListener("click", doLogin);
$("#loginPass").addEventListener("keydown", e=>{ if(e.key==="Enter") doLogin(); });
$("#loginUser").addEventListener("keydown", e=>{ if(e.key==="Enter") $("#loginPass").focus(); });
$("#logoutBtn").addEventListener("click", ()=>{
  try{ localStorage.removeItem("jc_logged_in"); }catch(e){}
  $("#logoutBtn").style.display = "none";
  showLogin();
});

/* ---------- 启动 ---------- */
// 设置版本号
try{
  if($("#headerVer")) $("#headerVer").textContent = VERSION;
  if($("#footerVer")) $("#footerVer").textContent = VERSION;
  if($("#currentVerTag")) $("#currentVerTag").textContent = VERSION;
  if($("#currentVerText")) $("#currentVerText").textContent = VERSION;
}catch(e){}
if(checkLogin()){
  $("#logoutBtn").style.display = "flex";
  render();
} else {
  showLogin();
  // 未登录时也渲染基础结构，但内容被登录框遮挡
  render();
}
</script>
