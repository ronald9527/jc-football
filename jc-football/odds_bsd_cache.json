.bk-view{padding:4px 0}
.bk-view.bk-in{animation:bkSlideIn .3s cubic-bezier(.2,.7,.3,1)}
@keyframes bkSlideIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.bk-head{background:linear-gradient(135deg,var(--panel) 0%,var(--panel3) 100%);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:12px}
