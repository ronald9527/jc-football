.sp-hit.good{color:var(--good);font-weight:700}
.sp-hit.bad{color:var(--bad);font-weight:700}
.ws-rank-table{margin:4px 0}
.ws-rank-row{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--line)}
