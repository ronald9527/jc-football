function nextBatch(now){
  const sec = now.getHours()*3600 + now.getMinutes()*60 + now.getSeconds();
  for (const b of BATCH_SECS){ if (b > sec) return b; }
  return BATCH_SECS[0] + 86400; // 已过全部批次，指向明日 09:00
}
function updBannerHtml(){
  const el = $("#updBanner");
  if (!el) return;
  const now = new Date();
  const upd = state.meta.updateTime || "";
  const dataDay = upd.slice(0,10);
  const today = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,"0")}-${String(now.getDate()).padStart(2,"0")}`;
  const nb = nextBatch(now);
  const diff = Math.max(0, nb - (now.getHours()*3600 + now.getMinutes()*60 + now.getSeconds()));
  const h = String(Math.floor(diff/3600)).padStart(2,"0");
  const m = String(Math.floor(diff%3600/60)).padStart(2,"0");
  const s = String(Math.floor(diff%60)).padStart(2,"0");
  const cd = `<span class="ub-cd">${h}:${m}:${s}</span>`;
  const isLive = now.getSeconds()%2===0 ? "●" : "○";
  const realtime = `${String(now.getHours()).padStart(2,"0")}:${String(now.getMinutes()).padStart(2,"0")}:${String(now.getSeconds()).padStart(2,"0")}`;
  const autoTxt = state.autoReload ? `<button class="ub-btn" id="ubToggle">自动刷新:开</button>`
                                   : `<button class="ub-btn off" id="ubToggle">自动刷新:关</button>`;
  // 夜间宽容：凌晨 0-9 点打开页面时，昨晚 20:00 后的批次属正常「无新赛事」数据，
  // 非抓取任务故障（定时批次 9:00 才启动），不应误报红色「已过期/任务未执行」。
  const _y = new Date(now.getTime() - 86400000);
  const _yDay = `${_y.getFullYear()}-${String(_y.getMonth()+1).padStart(2,"0")}-${String(_y.getDate()).padStart(2,"0")}`;
  const _isNight = now.getHours() < 9;
  const _isLateBatch = upd.slice(11,13) >= "20";
  const expireTxt = dataDay >= today
    ? `<span>· 本日 ${BATCH_LABEL} 高频自动更新</span>`
    : (_isNight && dataDay === _yDay && _isLateBatch)
    ? `<span style="color:var(--warn);font-weight:700">· 夜间无新赛事批次（昨晚 ${upd.slice(11,16)} 仍为最新），09:00 首轮自动更新</span>`
    : `<span style="color:var(--bad);font-weight:700">数据已过期（非今日批次），说明云端抓取任务未执行；点顶部「最新数据」按钮可立即重拉</span>`;
  el.innerHTML = `<span class="ub-live">${isLive} 实时 ${realtime}</span>
    <span>· 距下次数据自动更新（${BATCH_LABEL}）还有 ${cd}</span>
    <span>· 数据更新于 ${upd.slice(5,16)}</span>
    ${expireTxt}
    ${autoTxt}`;
  const tb = document.getElementById("ubToggle");
  if (tb){
    tb.onclick = ()=>{
      state.autoReload = !state.autoReload;
      try{ localStorage.setItem("jcAutoReload", state.autoReload?"1":"0"); }catch(e){}
      updBannerHtml();
      const t=$("#toast");
      t.textContent = state.autoReload? "已开启自动刷新：页面每 5 分钟自动重载检查新数据" : "已关闭自动刷新";
      t.classList.add("show"); clearTimeout(window.__toastT);
      window.__toastT=setTimeout(()=>t.classList.remove("show"),3500);
    };
  }
}
function updateClock(){
  try{
    const t = state.meta.updateTime || "";
    const u = document.getElementById("updTime");
    if (u) u.textContent = (t? "数据更新 " + t + " · " : "") + "当前 " + nowStr();
  }catch(e){}
  try{
    const hu = document.getElementById("histUpd");
    if (hu) hu.textContent = (state.histUpdated? "历史库更新 " + state.histUpdated + " · " : "") + "当前 " + nowStr();
  }catch(e){}
  updBannerHtml();
}
window.__clockTick = 0;
setInterval(()=>{ window.__clockTick++; }, 1000);
setInterval(updateClock, 1000);
