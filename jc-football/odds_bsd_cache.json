/* ---------- 通知与更新日志 ---------- */
/* 数据新鲜度：让用户打开通知就能核对当前页是不是最新数据 */
function renderDataFreshness(){
  const box = document.getElementById("dataFreshPanel");
  if(!box) return;
  const upd = state.meta.updateTime || "";
  const now = new Date();
  const p = x => String(x).padStart(2,"0");
  const today = `${now.getFullYear()}-${p(now.getMonth()+1)}-${p(now.getDate())}`;
  const dDay = upd.slice(0,10);
  let level = "stale", label = "无数据", color = "var(--sub)", bg = "var(--line)";
  if(upd){
    if(dDay === today){
      const mins = Math.floor((now - new Date(upd.replace(" ","T")))/60000);
      if(isNaN(mins)) { level="ok"; label="今日数据"; color="var(--good)"; bg="var(--good-bg)"; }
      else if(mins <= 60){ level="ok"; label="最新（" + mins + " 分钟前）"; color="var(--good)"; bg="var(--good-bg)"; }
      else { level="warn"; label="今日数据，已过 " + Math.floor(mins/60) + " 小时"; color="var(--warn)"; bg="rgba(250,173,20,.12)"; }
    }else if(dDay < today){
      // 夜间宽容：凌晨 0-9 点打开时，昨晚 20:00 后的批次属正常夜间数据（无新赛事），
      // 定时批次 9:00 才启动，降级为 warn 而非误报「已过期/任务未执行」。
      const _y = new Date(now.getTime() - 86400000);
      const _yDay = `${_y.getFullYear()}-${String(_y.getMonth()+1).padStart(2,"0")}-${String(_y.getDate()).padStart(2,"0")}`;
      if(now.getHours() < 9 && dDay === _yDay && upd.slice(11,13) >= "20"){
        level = "warn"; label = "夜间批次（昨晚 " + upd.slice(11,16) + "），09:00 首轮更新";
        color = "var(--warn)"; bg = "rgba(250,173,20,.12)";
      }else{
        level = "stale"; label = "数据已过期（非今日）"; color = "var(--bad)"; bg = "var(--bad-bg)";
      }
    }else{
      level = "ok"; label = "最新"; color = "var(--good)"; bg = "var(--good-bg)";
    }
  }
  const histN = (state.history||[]).length;
  const todayN = (state.data||[]).length;
  const smartN = (state.data||[]).filter(m=>m.smart).length;
  box.innerHTML = `
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
      <span style="font-size:11.5px;font-weight:700;color:var(--text)">📊 当前页数据状态</span>
      <span style="font-size:10.5px;font-weight:700;color:${color};background:${bg};padding:2px 8px;border-radius:999px">${label}</span>
      <span style="font-size:10.5px;color:var(--sub)">页面加载后每 2 分钟自动校核</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;font-size:11px">
      <div><div style="color:var(--sub)">数据更新时间</div><div style="font-weight:700;color:var(--text);margin-top:2px">${upd || "-"}</div></div>
      <div><div style="color:var(--sub)">今日赛事</div><div style="font-weight:700;color:var(--text);margin-top:2px">${todayN} 场</div></div>
      <div><div style="color:var(--sub)">智能引擎已校准</div><div style="font-weight:700;color:var(--text);margin-top:2px">${smartN} 场</div></div>
      <div><div style="color:var(--sub)">历史战绩库</div><div style="font-weight:700;color:var(--text);margin-top:2px">${histN} 条</div></div>
      <div><div style="color:var(--sub)">历史库更新</div><div style="font-weight:700;color:var(--text);margin-top:2px">${state.histUpdated || "-"}</div></div>
      <div><div style="color:var(--sub)">下次自动更新</div><div style="font-weight:700;color:var(--text);margin-top:2px">${BATCH_LABEL}</div></div>
    </div>
    <div style="margin-top:8px;font-size:10.5px;color:var(--sub);line-height:1.6">
      判定口径：以页头「数据更新于」时间为准；若显示「已过期」，说明云端抓取任务未执行，点顶部「最新数据」按钮可立即重拉。
      版本日志只记录功能改动，数据是否最新以上方时间为准。
    </div>`;
}
function renderChangelog(){
  renderDataFreshness();
  const dv = document.getElementById("currentVerDate");
  if(dv && CHANGELOG.length) dv.textContent = CHANGELOG[0].date || "-";
  const list = $("#changelogList");
  if(!list) return;
  let html = "";
  CHANGELOG.forEach((rel, idx)=>{
    const isCurrent = rel.version === VERSION;
    html += `<div style="margin-bottom:16px;padding-bottom:14px;border-bottom:1px solid var(--line);${idx===CHANGELOG.length-1?'border-bottom:none':''}">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
        <span style="font-size:14px;font-weight:700;color:${isCurrent?'var(--accent)':'var(--text)'}">${rel.version}</span>
        <span style="font-size:11px;color:var(--sub)">${rel.date}</span>
        <span style="font-size:12px;color:var(--sub)">· ${rel.title}</span>
        ${isCurrent?'<span style="font-size:10px;color:var(--good);background:var(--good-bg);padding:1px 6px;border-radius:999px;font-weight:600">当前版本</span>':''}
      </div>`;
    if(rel.features && rel.features.length){
      html += `<div style="font-size:11px;color:var(--good);font-weight:600;margin-bottom:4px">✦ 新增功能</div><ul style="margin:0 0 8px;padding-left:18px">`;
      rel.features.forEach(f=>{ html += `<li style="font-size:11.5px;color:var(--text);line-height:1.7;margin-bottom:2px">${f}</li>`; });
      html += `</ul>`;
    }
    if(rel.fixes && rel.fixes.length){
      html += `<div style="font-size:11px;color:var(--warn);font-weight:600;margin-bottom:4px">✦ 修复内容</div><ul style="margin:0 0 8px;padding-left:18px">`;
      rel.fixes.forEach(f=>{ html += `<li style="font-size:11.5px;color:var(--text);line-height:1.7;margin-bottom:2px">${f}</li>`; });
      html += `</ul>`;
    }
    if(rel.notes && rel.notes.length){
      html += `<div style="font-size:11px;color:var(--accent);font-weight:600;margin-bottom:4px">✦ 数据口径提醒</div><ul style="margin:0;padding-left:18px">`;
      rel.notes.forEach(f=>{ html += `<li style="font-size:11.5px;color:var(--sub);line-height:1.7;margin-bottom:3px">${f}</li>`; });
      html += `</ul>`;
    }
    html += `</div>`;
  });
  list.innerHTML = html;
}
